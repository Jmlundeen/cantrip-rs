Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Hand.Fear of Missing Out.Cast
Bot1.Choose(Lightning Bolt)
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Fear of Missing Out)
! Bot1.Target
[T3 Bot1.Main2]
? Bot2.Life = 18

