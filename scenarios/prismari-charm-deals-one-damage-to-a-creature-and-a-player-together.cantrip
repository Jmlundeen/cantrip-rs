# Prismari Charm, second mode, two targets: "deals 1 damage to each of one or two targets". Bot1 targets Bot2's Birds of
# Paradise (0/1, dies to the 1 damage) and Bot2 himself (20 -> 19): each target is dealt its own 1 damage, not 1 divided.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Prismari Charm
Island x14

[Bot2 Deck]
Birds of Paradise
Forest x14

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Birds of Paradise.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Prismari Charm.Cast
Bot1.Modes(deals 1 damage)
Bot1.Target(Bot2.Battlefield.Birds of Paradise; Bot2)
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot2.Graveyard = Birds of Paradise
Bot1.Graveyard = Prismari Charm
