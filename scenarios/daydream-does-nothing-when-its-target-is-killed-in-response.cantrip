# Daydream: Bot2 kills the targeted Ornithopter with Lightning Bolt in response. The target is illegal as Daydream
# resolves, so it does nothing (CR 608.2b): no creature returns, and Daydream, cast from the hand, goes to the graveyard.

[Bot1 Deck]
Mox Pearl
Ornithopter
Daydream
Plains x17

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Plains x18

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Daydream.Cast(Ornithopter)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
[T3 Bot1.Main2]
? Stack.Count = 0

[Expect]
Bot1.Battlefield = Mox Pearl
Bot1.Graveyard = Daydream; Ornithopter
Bot2.Graveyard = Lightning Bolt
