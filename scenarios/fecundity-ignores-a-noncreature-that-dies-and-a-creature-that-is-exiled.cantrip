Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Fecundity.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Abrupt Decay.Cast(Bot2.Battlefield.Mox Ruby)
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
? Stack.Count = 0
? Bot2.Graveyard = Mox Ruby
Bot1.Hand.Path to Exile.Cast(Ornithopter)
Bot1.Pass
Bot2.Decline
? Stack.Count = 0
[T3 Bot1.Main2]

