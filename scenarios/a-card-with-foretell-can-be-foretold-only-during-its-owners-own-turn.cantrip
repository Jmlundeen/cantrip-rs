# Foretell is a special action "during your turn" (CR 702.143a): Bot1 holds Delayed Blast Fireball through Bot2's turn
# two with priority and may not foretell it, then does so on its own turn three with two Mountains.

[Bot1 Deck]
Mountain
Mountain
Delayed Blast Fireball
Island x13

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
! Bot1.Hand.Delayed Blast Fireball.Foretell
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Delayed Blast Fireball.Foretell
[T3 Bot1.Main2]

[Expect]
Turn = 3
Step = Main2
Exile.Count = 1
Stack.Count = 0
