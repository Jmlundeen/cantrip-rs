# "Each opponent" (CR 102.2): in a three-player game Bot1's Ornithopter entering under Impact Tremors deals 1 damage to Bot2
# and 1 to Bot3, at the same time; Bot1's own life is untouched.

[Bot1 Deck]
Mox Ruby
Mox Jet
Impact Tremors
Ornithopter
Island x12

[Bot2 Deck]
Island x15

[Bot3 Deck]
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Impact Tremors.Cast
Bot1.Hand.Ornithopter.Cast

[Expect]
Bot2.Life = 19
Bot3.Life = 19
Bot1.Life = 20
