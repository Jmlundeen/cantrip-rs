# Battlefield Forge prints two mana abilities (CR 605.1a): "{T}: Add {C}." costs nothing, while "{T}: Add {R} or {W}.
# This land deals 1 damage to you." deals the damage as it resolves (a mana ability has no stack, CR 605.3b) and names its
# color as it resolves. Bot1 taps it for {C} on turn 3 and stays at 20, for {R} on turn 5 and for {W} on turn
# 7, one damage each. The colored ability refuses blue beside the red it does add (the {R} activation is the positive
# control), and the colorless ability takes no color at all.

[Bot1 Deck]
Battlefield Forge
Mountain x15

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Battlefield Forge.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Battlefield Forge.Activate(Ability: {R} or {W}; Color: Blue)
! Bot1.Battlefield.Battlefield Forge.Activate(Ability: {C}; Color: Red)
Bot1.Battlefield.Battlefield Forge.Activate(Ability: {C})
? Bot1.Mana = {C}
? Bot1.Life = 20
[T5 Bot1.Main1]
Bot1.Battlefield.Battlefield Forge.Activate(Ability: {R} or {W}; Color: Red)
? Bot1.Mana = {R}
? Bot1.Life = 19
[T7 Bot1.Main1]
Bot1.Battlefield.Battlefield Forge.Activate(Ability: {R} or {W}; Color: White)
? Bot1.Mana = {W}
? Bot1.Life = 18

[Expect]
Turn = 7
Bot1.Battlefield.Battlefield Forge.Tapped = true
Bot1.Life = 18
