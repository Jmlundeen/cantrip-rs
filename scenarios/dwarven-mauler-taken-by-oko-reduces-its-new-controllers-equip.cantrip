# "Equip abilities you activate that target this creature": "you" is the Mauler's controller (CR 109.5), whoever owns
# it. Bot1's Oko, Thief of Crowns trades the Food it made for Bot2's Dwarven Mauler (-5, CR 701.12a), and then Bot1's
# Shadowspear equips the Mauler for {0}: the {G} in Bot1's pool is still there afterwards.

[Bot1 Deck]
Forest
Mox Emerald
Mox Sapphire
Oko, Thief of Crowns
Mox Ruby
Shadowspear
Forest
Forest x10

[Bot2 Deck]
Mountain
Dwarven Mauler
Island x15

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Oko, Thief of Crowns.Cast
Bot1.Pass
Bot1.Battlefield.Oko, Thief of Crowns.Activate(Ability: Food)
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Shadowspear.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Dwarven Mauler.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Oko, Thief of Crowns.Activate(Ability: Exchange)
Bot1.Target(Food Token)
Bot1.Target(Dwarven Mauler)
Bot1.Pass
Bot1.Battlefield.Forest.Activate
? Bot1.Battlefield.Dwarven Mauler.Power = 2
? Bot1.Mana = {G}
Bot1.Battlefield.Shadowspear.Activate(Ability: Equip; Dwarven Mauler)
? Bot1.Mana = {G}
Bot1.Pass

[Expect]
Turn = 3
Bot1.Mana = {G}
Bot1.Battlefield.Shadowspear.AttachedTo = Dwarven Mauler
Bot1.Battlefield.Dwarven Mauler.Power = 3
Bot2.Battlefield = Mountain; Food Token
