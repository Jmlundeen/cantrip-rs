# Hide on the Ceiling: the exiled cards return "under their owners' control". Bot2's Llanowar Elves is controlled by Bot1 through Mind Control; Bot1 exiles it
# with X = 1, and at the end step it comes back to the battlefield under its owner Bot2's control, a new object (CR 400.7) that Mind Control no longer enchants:
# the Aura was put into Bot1's graveyard as the Elves left (CR 704.5m).

[Bot1 Deck]
Mox Sapphire
Mox Sapphire
Mox Jet
Mox Ruby
Mox Pearl
Mind Control
Hide on the Ceiling
Plains x2
Plains x13

[Bot2 Deck]
Forest
Llanowar Elves
Forest x14

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Mind Control.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Llanowar Elves.Power = 1
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hide on the Ceiling.Cast(X: 1)
Bot1.Target(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
[T5 Bot1.Main2]
? Exile = Llanowar Elves
[T5 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Exile.Count = 0
Bot2.Battlefield = Forest; Llanowar Elves
Bot1.Battlefield = Mox Sapphire; Mox Sapphire; Mox Jet; Mox Ruby; Mox Pearl
Bot1.Graveyard = Mind Control; Hide on the Ceiling
