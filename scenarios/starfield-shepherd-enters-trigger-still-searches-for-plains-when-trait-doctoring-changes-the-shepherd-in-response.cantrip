Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Teferi, Time Raveler.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Teferi, Time Raveler.Activate(Ability: +1)
Bot1.Hand.Starfield Shepherd.Cast(Ability: Warp)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Pass
Bot2.Pass
Bot1.Hand.Trait Doctoring.Cast(Starfield Shepherd)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Pass
Bot2.Pass
Bot1.Modes(Replace a basic land type)
Bot1.Modes(Plains)
Bot1.Modes(Forest)
Bot1.Choose(Starfield Shepherd)
Bot1.Pass
Bot2.Pass
! Bot1.Search(Forest)
Bot1.Search(Plains)

[Expect]
Bot1.Hand = Plains
