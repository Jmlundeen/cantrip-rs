# Bloodghast: "Landfall - Whenever a land you control enters, you may return this card from your graveyard to the
# battlefield." Bot2's Lightning Bolt kills it on turn 2; on turn 3 Bot1 plays an Island, accepts, and Bloodghast comes
# back as a new object (CR 400.7): summoning sick, since the opponent has 20 life and it has no haste.

[Bot1 Deck]
Swamp
Mox Jet
Bloodghast
Island
Island x16

[Bot2 Deck]
Mountain
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Bloodghast.Cast
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Bloodghast)
[T3 Bot1.Main1]
? Bot1.Graveyard = Bloodghast
Bot1.Hand.Island.Play
Bot1.Accept
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard.Count = 0
Bot1.Battlefield = Swamp; Mox Jet; Island; Bloodghast
Bot1.Battlefield.Bloodghast.SummoningSick = true
Bot1.Battlefield.Bloodghast.Keywords = CantBlock
Bot2.Graveyard = Lightning Bolt
