# Looting puts Vengevine in the graveyard; the second creature spell of the turn brings it back, and with haste it
# attacks that turn (4, +1 from Ignoble Hierarch's exalted).
[Bot1 Deck]
Vengevine
Faithless Looting
Llanowar Elves
Ignoble Hierarch
Mox Ruby
Black Lotus
Birds of Paradise
Forest x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Faithless Looting.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Choose(Vengevine; Forest)
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Llanowar Elves.Cast
? Bot1.Graveyard.Count = 4
Bot1.Hand.Ignoble Hierarch.Cast
Bot1.Accept
? Bot1.Battlefield.Vengevine.Power = 4
Bot1.Attack(Vengevine > Bot2)
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Vengevine.Keywords = Haste
Bot2.Life = 15
