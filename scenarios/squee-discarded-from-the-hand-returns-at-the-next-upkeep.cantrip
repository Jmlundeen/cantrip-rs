# Squee works from the graveyard however it got there (it never has to have been on the battlefield): Bot2's Thoughtseize makes Bot1 discard
# it from the hand on turn two, and at the beginning of Bot1's next upkeep, turn three, it is returned to the hand.

[Bot1 Deck]
Squee, Goblin Nabob
Mountain x6
Mountain x13

[Bot2 Deck]
Swamp
Thoughtseize
Swamp x13

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Thoughtseize.Cast(Bot1)
Bot2.Choose(Squee, Goblin Nabob)
[T3 Bot1.Upkeep]
? Bot1.Graveyard = Squee, Goblin Nabob
Bot1.Accept
[T3 Bot1.Main1]

[Expect]
Bot1.Graveyard.Count = 0
Bot2.Graveyard = Thoughtseize
Bot2.Life = 18
