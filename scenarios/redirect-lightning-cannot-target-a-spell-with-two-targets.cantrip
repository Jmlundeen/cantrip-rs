# Redirect Lightning targets "a spell or ability with a single target" (CR 115.1, ruling 2025-10-02). Bot1's Untimely
# Malfunction (third mode) targets both of Bot2's Ornithopters: two targets, so Bot2's Redirect Lightning (three Moxen
# untapped, {R} and {2}, and 20 life, so neither cost is the reason) cannot be cast at it.

[Bot1 Deck]
Mox Ruby
Mox Emerald
Untimely Malfunction
Island x17

[Bot2 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Redirect Lightning
Ornithopter
Ornithopter
Island x14

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Untimely Malfunction.Cast
Bot1.Modes(3)
Bot1.Target(Bot2.Battlefield.Ornithopter#1; Bot2.Battlefield.Ornithopter#2)
Bot1.Pass
! Bot2.Hand.Redirect Lightning.Cast(Stack.Untimely Malfunction)
Bot2.Pass
[Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Hand = Island; Island; Redirect Lightning
Bot1.Graveyard = Untimely Malfunction
