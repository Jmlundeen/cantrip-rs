# Mode one: "Target permanent you control gains hexproof and indestructible until end of turn." Bot1 aims it at its Elvish
# Mystic. The Mystic then has both keywords, and Bot2 cannot target it with Lightning Bolt (refused: hexproof).

[Bot1 Deck]
Mox Emerald
Mox Pearl
Elvish Mystic
Vigorbloom Charm
Plains x20

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Plains x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Elvish Mystic.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Vigorbloom Charm.Cast
Bot1.Modes(1)
Bot1.Target(Elvish Mystic)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Elvish Mystic.Keywords = Hexproof; Indestructible
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
! Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Elvish Mystic)

[Expect]
Bot1.Battlefield.Elvish Mystic.Keywords = Hexproof; Indestructible
Bot1.Graveyard = Vigorbloom Charm
