# Raubahn's attack trigger moves an Equipment that is already attached (CR 701.3a): on turn 3 Bot1 equips the Bloodforged
# Battle-Axe to Raubahn for {2}, then attacks with Raubahn and Ornithopter. The trigger attaches the Axe to the other
# attacker, so Raubahn is a 2/2 again and Ornithopter a 2/2 flier (positive control for the refusal in the first scenario:
# a creature that attacks can be the target). Bot2 takes 2 + 2 = 4.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mountain
Raubahn, Bull of Ala Mhigo
Bloodforged Battle-Axe
Ornithopter
Island
Island x10

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Raubahn, Bull of Ala Mhigo.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bloodforged Battle-Axe.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Bloodforged Battle-Axe.Activate(Raubahn, Bull of Ala Mhigo)
[T3 Bot1.DeclareAttackers]
? Bot1.Battlefield.Raubahn, Bull of Ala Mhigo.Power = 4
Bot1.Attack(Raubahn, Bull of Ala Mhigo > Bot2; Ornithopter > Bot2)
Bot1.Target(Bloodforged Battle-Axe)
Bot1.Target(Ornithopter)
[T3 Bot1.DeclareBlockers]
? Bot1.Battlefield.Bloodforged Battle-Axe.AttachedTo = Ornithopter
? Bot1.Battlefield.Raubahn, Bull of Ala Mhigo.Power = 2
? Bot1.Battlefield.Ornithopter.Power = 2
[T4 Bot2.Main1]
? Bot2.Life = 16

[Expect]
Bot2.Life = 16
