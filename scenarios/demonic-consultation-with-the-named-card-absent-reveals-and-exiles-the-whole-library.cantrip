# Demonic Consultation: when no card in the library has the chosen name, cards are revealed until there are none left
# (CR 701.20), nothing goes to the hand, and "all other cards revealed this way" is the whole library: after the top six,
# the four Forests below them are exiled too. (The positive control is the neighbouring scenario that finds its card.)

[Bot1 Deck]
Swamp
Demonic Consultation
Island x5
Island x6
Forest x4

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Demonic Consultation.Cast
Bot1.Name(Black Lotus)
[T1 Bot1.Main2]

[Expect]
Turn = 1
Bot1.Hand = Island; Island; Island; Island; Island
Exile.Count = 10
Bot1.Library.Count = 0
