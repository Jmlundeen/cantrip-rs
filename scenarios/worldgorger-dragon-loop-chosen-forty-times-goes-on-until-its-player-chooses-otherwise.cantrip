Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Entomb.Cast
Bot1.Search(Worldgorger Dragon)
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Entomb.Cast
Bot2.Search(Ornithopter)
[T3 Bot1.Main1]
