# Buster Sword: Ornithopter (0/2) equipped is 3/4 (0/2 + 3/2), so it deals 3 combat damage to Bot2. The trigger draws a card, then
# Bot1 may cast a spell from hand with mana value <= 3 for free: Hop to It (MV 3, equal to the damage) may be chosen, Wrath of
# God (MV 4) may not (CR 118.9, 608.2g). Every Mox is tapped (their mana spent in the first main phase) when the trigger
# resolves, so Hop to It's {2}{W} could not be paid: it is cast for nothing and makes three Rabbits.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Mox Sapphire
Mox Emerald
Ornithopter
Buster Sword
Hop to It
Wrath of God
Plains x13

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Buster Sword.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Buster Sword.Activate(Bot1.Battlefield.Ornithopter)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Attack(Ornithopter > Bot2)
! Bot1.Choose(Wrath of God)
Bot1.Choose(Hop to It)
[Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Ornithopter.Power = 3
Bot1.Battlefield.Ornithopter.Toughness = 4
Bot1.Battlefield.Count = 10
Bot1.Battlefield.Mox Sapphire.Tapped = true
Bot1.Battlefield.Mox Emerald.Tapped = true
Bot1.Battlefield.Mox Ruby.Tapped = true
Bot1.Battlefield.Mox Pearl.Tapped = true
Bot1.Battlefield.Mox Jet.Tapped = true
Bot1.Graveyard = Hop to It
Bot1.Hand = Wrath of God
Stack.Count = 0
