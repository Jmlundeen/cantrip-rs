Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Teysa Karlov.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Sphinx of False Conclusions.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Sphinx of False Conclusions)
Bot1.Pass
Bot1.Triggers(Sphinx of False Conclusions; Sphinx of False Conclusions)
[T3 Bot1.Main2]
? Bot1.Battlefield.Sphinx of False Conclusions#2.Token = true
? Bot1.Battlefield.Sphinx of False Conclusions#1.Keywords = Flash; Flying; Lifelink; Vigilance
? Bot1.Battlefield.Teysa Karlov.Keywords = (absent)
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Sphinx of False Conclusions)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
[T5 Bot1.Main2]

[Expect]
Stack.Count = 0
