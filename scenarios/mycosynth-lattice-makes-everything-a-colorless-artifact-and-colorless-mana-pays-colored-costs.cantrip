Bot1.Mana = {C}
Bot2.Graveyard = Llanowar Elves
Bot2.Graveyard.Llanowar Elves.Colors =
Bot1.Graveyard = Lightning Bolt
Bot1.Graveyard.Lightning Bolt.Colors =
Bot1.Battlefield.Mycosynth Lattice.Types = Artifact
