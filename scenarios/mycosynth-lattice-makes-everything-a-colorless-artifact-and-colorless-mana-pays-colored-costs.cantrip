[T2 Bot2.Main1]
Bot2.Hand.Island.Play
? Bot2.Battlefield.Island.Types = Land; Artifact
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Island.Activate
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Llanowar Elves.Colors = (absent)
? Bot2.Battlefield.Llanowar Elves.Types = Creature; Artifact
[T3 Bot1.Main1]
? Bot1.Hand.Lightning Bolt.Colors =
Bot1.Battlefield.Sol Ring.Activate
? Bot1.Mana = {C}{C}
