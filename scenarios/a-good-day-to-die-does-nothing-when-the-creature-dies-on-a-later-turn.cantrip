Bot1.Hand.A Good Day to Die.Cast(Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 2
[T3 Bot1.Main1]
? Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Ornithopter)
Bot1.Pass
