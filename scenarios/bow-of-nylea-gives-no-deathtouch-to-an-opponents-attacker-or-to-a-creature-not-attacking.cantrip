# Bow of Nylea: "Attacking creatures you control have deathtouch." Only the Bow controller's own attackers: Bot2's
# attacking Llanowar Elves has no deathtouch (it deals 1 damage to Bot1's blocking Ornithopter 0/2, which survives), and
# Bot1's own Llanowar Elves, not attacking, has none either. The positive control, a Bow controller's attacker having
# deathtouch, is bow-of-nylea-gives-an-attacking-llanowar-elves-deathtouch-against-a-blocking-ornithopter.

[Bot1 Deck]
Forest
Mox Emerald
Mox Emerald
Mox Ruby
Bow of Nylea
Ornithopter
Llanowar Elves
Forest x13

[Bot2 Deck]
Forest
Llanowar Elves
Forest x18

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Bow of Nylea.Cast
Bot1.Pass
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Attack(Llanowar Elves > Bot1)
Bot1.Block(Ornithopter > Llanowar Elves)
? Bot2.Battlefield.Llanowar Elves.Keywords = (absent)
? Bot1.Battlefield.Llanowar Elves.Keywords = (absent)
[T4 Bot2.Main2]

[Expect]
Bot1.Battlefield.Ornithopter.Damage = 1
Bot2.Battlefield.Llanowar Elves.Damage = 0
Bot2.Graveyard.Count = 0
Bot1.Graveyard.Count = 0
