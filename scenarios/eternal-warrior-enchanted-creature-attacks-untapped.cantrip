# Eternal Warrior enchants only a creature and gives that creature vigilance: it attacks untapped, while the other attacker taps (CR 702.20b, 508.1f).

[Bot1 Deck]
Eternal Warrior
Mox Ruby
Ornithopter x2
Mountain x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Eternal Warrior.Cast(Bot1.Battlefield.Mox Ruby)
Bot1.Hand.Eternal Warrior.Cast(Bot1.Battlefield.Ornithopter#1)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Ornithopter#1 > Bot2; Ornithopter#2 > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Eternal Warrior.AttachedTo = Ornithopter
Bot1.Battlefield.Ornithopter#1.Tapped = false
Bot1.Battlefield.Ornithopter#2.Tapped = true
