# Go Ninja Go, second mode: damage equal to the greatest power among creatures Bot1 controls - the greatest one, not their total. Bot1 has two Memnites (1/1 each),
# so it deals 1, not 2, to Bot2's Ornithopter (0/2), which lives with 1 damage.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Memnite
Memnite
Go Ninja Go
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Go Ninja Go.Cast
Bot1.Modes(2)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield = Ornithopter
Bot2.Battlefield.Ornithopter.Damage = 1
Bot1.Graveyard = Go Ninja Go
