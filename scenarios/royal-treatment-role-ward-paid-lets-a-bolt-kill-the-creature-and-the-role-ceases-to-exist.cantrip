# The control of the ward scenario: Bot2 has a Mox Ruby beside its Mountain and pays the Royal Role's ward {1}
# (CR 702.21a), so Lightning Bolt resolves and deals 3 damage to the 1/3 Ornithopter, which dies. The Role is then
# attached to nothing and goes to the graveyard (CR 704.5m), where a token ceases to exist (CR 704.5d, 111.7): it is
# in no zone at the end, only in the record of what left the battlefield.

[Bot1 Deck]
Forest
Ornithopter
Royal Treatment
Island x17

[Bot2 Deck]
Mountain
Mox Ruby
Lightning Bolt
Mountain x17

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Royal Treatment.Cast(Bot1.Battlefield.Ornithopter)
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot2.PayCost

[Expect]
Turn = 2
Stack.Count = 0
Bot1.Battlefield = Forest
Bot1.Graveyard = Ornithopter; Royal Treatment
LeftBattlefield = Ornithopter; Royal
Bot2.Graveyard = Lightning Bolt
Bot2.Battlefield.Mox Ruby.Tapped = true
