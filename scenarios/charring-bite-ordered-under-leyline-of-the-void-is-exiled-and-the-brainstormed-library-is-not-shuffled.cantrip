Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Replace(Leyline of the Void)
[T3 Bot1.Main2]

[Expect]
Exile = Brainstorm; Twinmaw Stormbrood
Bot1.Library = Plains; Lightning Bolt; Island; Island; Island; Island; Island; Island; Island; Island; Island
Bot1.Graveyard.Count = 0
