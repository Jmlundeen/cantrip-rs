# Surveil 1 with no card in the library looks at nothing and asks nothing (CR 701.46a, 701.46b): Bot1's deck is exactly its
# opening hand, so on turn 1 the Mortuary's enters trigger gives no placement to choose (a refusal; the other scenario asks).
# The land is still a tapped Swamp Forest. (The turn-3 draw would lose, so the script ends in turn 1.)

[Bot1 Deck]
Underground Mortuary
Island x6

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Underground Mortuary.Play
! Bot1.Arrange
[T1 Bot1.Main2]

[Expect]
Result = InProgress
Bot1.Battlefield.Underground Mortuary.Tapped = true
Bot1.Battlefield.Underground Mortuary.Subtypes = Forest; Swamp
Bot1.Graveyard.Count = 0
