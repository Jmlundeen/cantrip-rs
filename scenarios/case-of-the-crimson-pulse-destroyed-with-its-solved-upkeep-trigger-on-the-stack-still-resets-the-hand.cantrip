Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Cathar Commando.Activate(Bot1.Battlefield.Case of the Crimson Pulse)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
Bot1.Pass
? Bot1.Graveyard = Case of the Crimson Pulse; Ornithopter
? Stack.Count = 1
[T3 Bot1.Draw]
? Bot1.Hand.Count = 3

[Expect]
Bot1.Graveyard = Case of the Crimson Pulse; Ornithopter
Bot2.Graveyard = Cathar Commando
Bot1.Hand.Count = 3
Bot1.Library.Count = 7
