Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Upkeep]
? Stack.Count = 1
? Bot1.Battlefield.Case of the Crimson Pulse.Solved = true
Bot1.Pass
