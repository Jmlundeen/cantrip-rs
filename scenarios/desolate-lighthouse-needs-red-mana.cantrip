Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Desolate Lighthouse.Activate(Ability: Draw a card)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Island)
? Bot1.Hand.Count = 0
? Bot1.Graveyard = Island

