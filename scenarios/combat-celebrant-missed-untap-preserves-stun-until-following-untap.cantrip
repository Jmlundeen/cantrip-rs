# Exert forbids its next untap, leaving a stun counter untouched (CR 701.43a, 122.1d).
# The following untap consumes stun instead, and the third untap finally succeeds.

[Bot1 Deck]
Black Lotus
Combat Celebrant
Sol Ring
Mox Ruby
Mox Sapphire
Ornithopter
Cryogenic Stasis
Island x25

[Bot2 Deck]
Island x30

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Combat Celebrant.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Combat Celebrant)
Bot1.Accept
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Cryogenic Stasis.Cast(Combat Celebrant)
[T3 Bot1.Main2]
? Bot1.Battlefield.Combat Celebrant.Counters.Stun = 1
[T5 Bot1.Main1]
? Bot1.Battlefield.Combat Celebrant.Tapped = true
? Bot1.Battlefield.Combat Celebrant.Counters.Stun = 1
? Bot1.Battlefield.Combat Celebrant.Exerted = (absent)
[T7 Bot1.Main1]
? Bot1.Battlefield.Combat Celebrant.Tapped = true
? Bot1.Battlefield.Combat Celebrant.Counters.Stun = (absent)
[T9 Bot1.Main1]

[Expect]
Bot1.Battlefield.Combat Celebrant.Tapped = false
Bot2.Life = 16
