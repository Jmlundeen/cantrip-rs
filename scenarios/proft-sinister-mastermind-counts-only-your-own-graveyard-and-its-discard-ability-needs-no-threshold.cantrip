Bot1.Hand.Dark Ritual.Cast
Bot1.Pass
! Bot1.Hand.Proft, Sinister Mastermind.Cast
Bot1.Hand.Proft, Sinister Mastermind.Activate(Bot2.Battlefield.Town Greeter)

[Expect]
Bot1.Graveyard = Proft, Sinister Mastermind; Dark Ritual
Bot2.Graveyard.Count = 8
Bot2.Battlefield = Forest; Mox Emerald; Mox Sapphire; Mox Jet; Town Greeter
