Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Town Greeter.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Town Greeter.Cast
[T3 Bot1.Main1]
? Bot2.Graveyard.Count = 7
? Bot1.Graveyard.Count = 0
