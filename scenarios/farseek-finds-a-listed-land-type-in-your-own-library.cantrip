# Farseek searches its controller's library for a card with one of the four listed land types, may find a nonbasic
# land (Taiga, a Mountain and Forest), puts it onto the battlefield tapped, then shuffles. A Forest alone is not one of
# the listed types, and two cards at once exceed the one-card search. Bot2's Tundra is in another player's zone, so it
# cannot be taken. The search is left in Bot1's own library and its shuffle is recorded.

[Bot1 Deck]
Farseek
Forest x6
Taiga x4
Tropical Island x4
Forest x8

[Bot2 Deck]
Tundra x20

[Actions]
Bot1.Hand.Forest.Play
[T2 Bot2.Main1]
Bot2.Hand.Tundra.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Farseek.Cast
! Bot1.Search(Forest)
! Bot1.Search(Tropical Island; Taiga)
Bot1.Search(Taiga)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Bot1.Graveyard = Farseek
Bot1.Battlefield.Count = 3
Bot1.Battlefield.Taiga.Tapped = true
Bot2.Battlefield.Tundra.Tapped = false
Bot1.Shuffles = 1
