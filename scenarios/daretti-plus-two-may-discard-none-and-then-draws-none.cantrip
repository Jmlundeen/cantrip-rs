# "Discard up to two cards, then draw that many cards": Bot1 holds two Islands and chooses none. Nothing is discarded, so
# nothing is drawn (the hand stays the same two Islands and the library is not touched), and the loyalty is 5.

[Bot1 Deck]
Daretti, Scrap Savant
Mox Ruby
Mox Jet
Mox Sapphire
Mox Pearl
Island
Island
Forest x20

[Bot2 Deck]
Forest x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Daretti, Scrap Savant.Cast
Bot1.Battlefield.Daretti, Scrap Savant.Activate(Ability: Discard up to two)
Bot1.Choose()
[T1 Bot1.Main2]

[Expect]
Bot1.Hand = Island; Island
Bot1.Graveyard.Count = 0
Bot1.Library.Count = 20
Bot1.Battlefield.Daretti, Scrap Savant.Counters.Loyalty = 5
