# "Another Desert": the Archway is a Desert but not another one. Turn 3 the first Archway returns the Plains (not a Desert);
# turn 5 the second Archway, with the first one on the battlefield, chooses itself and returns itself: neither surveils (the
# Island stays on top of the library, the graveyard is empty). Positive control: the sibling scenario where the second
# Archway returns the first. The first Archway stays untouched, entered tapped, and taps for {C}{C} on turn 7.

[Bot1 Deck]
Plains
Arid Archway
Arid Archway
Swamp x4
Swamp
Swamp
Island
Swamp x9

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Plains.Play
[T3 Bot1.Main1]
Bot1.Hand.Arid Archway.Play
Bot1.Choose(Plains)
! Bot1.Arrange
? Bot1.Battlefield.Arid Archway.Tapped = true
[T5 Bot1.Main1]
Bot1.Hand.Arid Archway.Play
Bot1.Choose(Arid Archway#2)
! Bot1.Arrange
? Bot1.Graveyard.Count = 0
[T7 Bot1.Main1]
Bot1.Battlefield.Arid Archway.Activate
? Bot1.Mana = {C}{C}

[Expect]
Turn = 7
Bot1.Battlefield = Arid Archway
Bot1.Battlefield.Arid Archway.Tapped = true
Bot1.Library.Count = 9
