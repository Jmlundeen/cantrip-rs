# Plasma Bolt's damage is chosen as it resolves (CR 608.2c): Bot1 casts the Bolt at Bot2 with nothing having left the battlefield,
# then responds to its own spell with a Shock that kills Bot2's Ornithopter. The Bolt then resolves with void met and deals 3 (20 -> 17).

[Bot1 Deck]
Mox Ruby
Mox Ruby
Shock
Plasma Bolt
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Plasma Bolt.Cast(Bot2)
Bot1.Hand.Shock.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass

[Expect]
Stack.Count = 0
Bot2.Graveyard = Ornithopter
Bot2.Life = 17
