# Flint and Flamecache Gecko (a Lizard Warlock) are two outlaws, so the turn-3 upkeep exiles the top 2 cards of Bot2's library: an Island and
# a Lightning Bolt. "You may cast spells from among those cards": the Bolt is cast (with a Mox Jet's mana) for 3 damage - Bot2 is on 17 - but
# the Island is no spell and cannot be played from exile (`! Bot1.Exile.Island.Play`), so it stays there. The Bolt cast from the top is the
# positive control beside the refusal. Bot2's graveyard holds the Bolt over the Island it discarded to hand size.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Ruby
Mox Pearl
Mox Emerald
Laughing Jasper Flint
Flamecache Gecko
Island x13

[Bot2 Deck]
Island x8
Island
Lightning Bolt
Island x10

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Laughing Jasper Flint.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Pass
Bot1.Hand.Flamecache Gecko.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Pass
[T3 Bot1.Upkeep]
Bot1.Pass
! Bot1.Exile.Island.Play
Bot1.Exile.Lightning Bolt.Cast(Bot2)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Pass
Bot1.Pass

[Expect]
Stack.Count = 0
Bot2.Life = 17
Exile = Island
Exile.Count = 1
Bot2.Graveyard = Lightning Bolt; Island
