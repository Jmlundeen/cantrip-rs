Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Brazen Borrower.Cast(Sol Ring; Ability: Adventure)
? Stack = Petty Theft
[T3 Bot1.Main2]
? Exile = Brazen Borrower
? Bot2.Battlefield = Island
[T5 Bot1.Main1]
Bot1.Hand.Island.Play
[T6 Bot2.End]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Island#3.Activate
Bot1.Exile.Brazen Borrower.Cast

