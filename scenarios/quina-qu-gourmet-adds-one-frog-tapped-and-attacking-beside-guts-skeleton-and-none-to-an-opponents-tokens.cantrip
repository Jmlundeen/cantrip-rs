Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Frontline Rush.Cast
Bot2.Modes(Create two 1/1 red Goblin creature tokens.)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Count = 4
? Bot1.Battlefield.Count = 6
[T3 Bot1.Main1]
Bot1.Attack(Quina, Qu Gourmet > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Mox Jet)
Bot1.Pass
Bot2.Pass
? Combat.Attackers = Quina, Qu Gourmet > Bot2; Skeleton Token > Bot2; Frog Token > Bot2
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 13
Bot1.Battlefield = Forest; Quina, Qu Gourmet; Gut, True Soul Zealot; Mox Ruby; Mox Pearl; Skeleton Token; Frog Token
Bot1.Battlefield.Frog Token.Tapped = true
Bot1.Battlefield.Frog Token.Power = 1
Bot1.Battlefield.Frog Token.Toughness = 1
Bot1.Battlefield.Frog Token.Colors = Green
Bot1.Battlefield.Frog Token.Types = Creature
Bot1.Battlefield.Frog Token.Subtypes = Frog
Bot2.Battlefield = Mox Ruby; Mox Pearl; Goblin Token; Goblin Token
