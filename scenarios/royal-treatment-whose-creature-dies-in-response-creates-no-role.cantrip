# left the battlefield but the Ornithopter.

[Bot1 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Bot2 Deck]
Forest
Ornithopter
Royal Treatment
Forest x17

[Actions]
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Royal Treatment.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)

