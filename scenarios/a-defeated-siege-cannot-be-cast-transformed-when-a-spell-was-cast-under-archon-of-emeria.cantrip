[T5 Bot1.End]

[Expect]
Turn = 5
Exile = Invasion of Gobakhan; Lightning Bolt
Bot1.Battlefield = Forest; Plains; Mox Emerald; Mox Pearl; Mox Jet; Guerrilla Gorilla
Bot1.Battlefield.Guerrilla Gorilla.Power = 2
