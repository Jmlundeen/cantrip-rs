Bot1.Battlefield = Forest; Forest; Grafdigger's Cage; Mox Jet; Mox Pearl
Bot1.Battlefield.Forest#2.Tapped = true
Bot1.Library.Llanowar Elves.Power = 1
Bot1.Graveyard = Fabled Passage; Collected Company; Black Lotus
