# Tuvok's ability takes an attacking creature of either side ("choose up to two target attacking creatures", CR 115.1, 508.1):
# Bot1 flashes it in during its own declare attackers step and chooses its own attacking Memnite - one only, which pins "up to
# two" as allowing fewer - while Bot2's Liliana, a planeswalker and so not an attacking creature, is refused as a target. The
# reselect then moves the Memnite off Bot2 and onto Liliana, so Bot2's life total stays 20 and her loyalty drops by the 1
# damage.

[Bot1 Deck]
Tuvok, Chief Tactical Officer
Memnite
Ornithopter
Mox Sapphire
Mox Pearl
Mox Jet
Island x14

[Bot2 Deck]
Black Lotus
Liliana of the Veil
Plains x18

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Black)
Bot2.Hand.Liliana of the Veil.Cast
[T3 Bot1.Attackers]
Bot1.Attack(Memnite > Bot2)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Tuvok, Chief Tactical Officer.Cast
? Bot1.Mana =
! Bot1.Target(Bot2.Battlefield.Liliana of the Veil)
Bot1.Target(Bot1.Battlefield.Memnite)
Bot1.Target(Bot2.Battlefield.Liliana of the Veil)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot2.Life = 20
? Bot2.Battlefield.Liliana of the Veil.Counters.Loyalty = 2
? Bot1.Life = 20
? Bot1.Battlefield.Tuvok, Chief Tactical Officer.Keywords = Flash

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Battlefield.Liliana of the Veil.Counters.Loyalty = 2
Bot1.Battlefield.Memnite.Tapped = true
Stack.Count = 0
