? Bot1.Graveyard = Dark Ritual
? Bot2.Graveyard.Count = 0
[T5 Bot1.Main1]
! Bot1.Battlefield.Pit of Offerings.Activate(Ability: exiled; Color: Green)
Bot1.Battlefield.Pit of Offerings.Activate(Ability: exiled; Color: Black)
? Bot1.Mana = {B}
[T7 Bot1.Main1]
Bot1.Battlefield.Pit of Offerings.Activate(Ability: exiled; Color: Red)
? Bot1.Mana = {R}

[Expect]
Turn = 7
Exile.Count = 2
Bot1.Graveyard = Dark Ritual
