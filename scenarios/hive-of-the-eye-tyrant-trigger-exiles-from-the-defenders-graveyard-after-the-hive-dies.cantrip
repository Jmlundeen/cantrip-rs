Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Lotus Petal.Cast
Bot2.Pass
Bot2.Battlefield.Lotus Petal.Activate(Color: Red)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Hive of the Eye Tyrant.Activate(Ability: Until end of turn)
Bot1.Pass
Bot1.Attack(Hive of the Eye Tyrant > Bot2)
Bot1.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Hive of the Eye Tyrant)
[T3 Bot1.Main2]
? Bot1.Graveyard = Hive of the Eye Tyrant
? Exile = Lotus Petal

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Graveyard = Lightning Bolt
Exile.Count = 1
Exile = Lotus Petal
