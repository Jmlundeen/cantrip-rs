# The Pixies cannot be blocked by an artifact creature, while a nonartifact creature can block them.

[Bot1 Deck]
Mox Emerald
Mox Pearl
Argothian Pixies
Forest x17

[Bot2 Deck]
Mox Emerald
Llanowar Elves
Memnite
Forest x17

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Argothian Pixies.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Memnite.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Attack(Argothian Pixies > Bot2)
! Bot2.Block(Memnite > Argothian Pixies)
Bot2.Block(Llanowar Elves > Argothian Pixies)
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard = Argothian Pixies
Bot2.Graveyard = Llanowar Elves
Bot2.Battlefield.Memnite.Tapped = false
