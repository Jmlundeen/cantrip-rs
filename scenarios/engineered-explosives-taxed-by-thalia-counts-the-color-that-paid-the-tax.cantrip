# Sunburst counts each color of mana spent to cast the spell (CR 702.44a), the whole total cost (CR 601.2f-h) and not just
# its X. Under Bot2's Thalia, Guardian of Thraben, Bot1's Engineered Explosives with X = 1 costs {2}: Bot1 pays it with a red
# and a black, so it enters with two charge counters - though its X, and so its mana value on the stack, was 1.

[Bot1 Deck]
Mox Ruby
Mox Jet
Engineered Explosives
Island x10

[Bot2 Deck]
Plains
Mox Pearl
Thalia, Guardian of Thraben
Plains x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Plains.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Thalia, Guardian of Thraben.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
? Bot1.Mana = {B}{R}
Bot1.Hand.Engineered Explosives.Cast(X: 1)

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Mana =
Bot1.Battlefield.Engineered Explosives.Counters.Charge = 2
