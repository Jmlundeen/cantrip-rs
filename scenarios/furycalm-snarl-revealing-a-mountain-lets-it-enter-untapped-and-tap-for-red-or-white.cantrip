# Furycalm Snarl: "As this land enters, you may reveal a Mountain or Plains card from your hand. If you don't, this land
# enters tapped. {T}: Add {R} or {W}" (CR 614.1d, 701.20a, 605.1a). Bot1 reveals a Mountain, so it enters untapped; on
# turns 3 and 5 it taps for {R} and for {W}, each the single mana the {T} buys, and it offers no green.

[Bot1 Deck]
Furycalm Snarl
Mountain
Plains x18

[Bot2 Deck]
Mountain x20

[Actions]
Bot1.Hand.Furycalm Snarl.Play
Bot1.Accept
Bot1.Choose(Mountain)
? Bot1.Revealed = Mountain
? Bot2.Revealed = (absent)
? Bot1.Battlefield.Furycalm Snarl.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Furycalm Snarl.Activate(Color: Red)
? Bot1.Mana = {R}
[T5 Bot1.Main1]
! Bot1.Battlefield.Furycalm Snarl.Activate(Color: Green)
Bot1.Battlefield.Furycalm Snarl.Activate(Color: White)
? Bot1.Mana = {W}

[Expect]
Turn = 5
Bot1.Battlefield.Furycalm Snarl.Tapped = true
