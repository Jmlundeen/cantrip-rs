Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Mox Pearl.Cast
? Bot1.Battlefield.Assault Drone.Power = 3
? Bot1.Battlefield.Assault Drone.Toughness = 4
? Bot1.Battlefield.Ornithopter.Power = 1
? Bot1.Battlefield.Ornithopter.Toughness = 2
? Bot2.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Toughness = 2
? Bot1.Battlefield.Mox Jet.Types = Artifact
Bot2.Battlefield.Plains.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Disenchant.Cast(Assault Drone)
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Battlefield.Ornithopter.Toughness = 2
Bot1.Graveyard = Assault Drone
