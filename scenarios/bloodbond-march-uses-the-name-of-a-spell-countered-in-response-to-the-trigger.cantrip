# Bloodbond March: the trigger names "that spell"; if the spell has left the stack by the time the trigger resolves, its
# name is the one it last had (CR 608.2h). Bot1 casts Dark Confidant, March triggers, and Bot2 counters the spell in
# response to the trigger. The countered Dark Confidant is in Bot1's graveyard when the trigger resolves, so it is
# among the cards with the spell's name and comes straight back to the battlefield.

[Bot1 Deck]
Mox Jet
Mox Emerald
Mox Ruby
Mox Pearl
Bloodbond March
Dark Confidant
Plains
Plains x14

[Bot2 Deck]
Island
Mox Sapphire
Counterspell
Plains x4
Plains x12

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bloodbond March.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Dark Confidant.Cast
Bot1.Pass
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Dark Confidant)
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Dark Confidant.Types = Creature
Bot1.Graveyard.Count = 0
Bot2.Graveyard = Counterspell
