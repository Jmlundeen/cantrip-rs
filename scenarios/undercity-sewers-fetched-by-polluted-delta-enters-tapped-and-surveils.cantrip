# An Island Swamp is found by "Island or Swamp card": Polluted Delta fetches the Sewers (a life paid), which enters tapped and surveils 1
# (the top Island goes to the graveyard).

[Bot1 Deck]
Polluted Delta
Island x6
Undercity Sewers
Island x10

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Polluted Delta.Play
Bot1.Battlefield.Polluted Delta.Activate
Bot1.Search(Undercity Sewers)
Bot1.Arrange(| Island)

[Expect]
Bot1.Life = 19
Bot1.Battlefield = Undercity Sewers
Bot1.Battlefield.Undercity Sewers.Tapped = true
Bot1.Graveyard = Island; Polluted Delta
