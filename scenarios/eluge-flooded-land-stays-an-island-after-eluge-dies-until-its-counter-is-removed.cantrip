Turn = 5
Bot1.Battlefield.Forest.Subtypes = Forest
Bot1.Battlefield.Forest.Counters.Flood = (absent)
Bot1.Graveyard = Vampire Hexmage; Eluge, the Shoreless Sea; Black Lotus
Bot1.Mana = {G}
