# Plainscycling {1} is a cycling ability (CR 702.29e): from the hand, Bot1 pays {1}, discards Eagles of the North and
# searches its library for a Plains, which goes into its hand.

[Bot1 Deck]
Island
Eagles of the North
Island x5
Plains
Island x10

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Eagles of the North.Activate
Bot1.Search(Plains)

[Expect]
Turn = 1
Stack.Count = 0
Bot1.Graveyard = Eagles of the North
Bot1.Hand = Island; Island; Island; Island; Island; Plains
Bot1.Library.Count = 10
