? Bot1.Battlefield.Ornithopter.Power = 1
? Bot1.Battlefield.Ornithopter.Toughness = 3
? Bot1.Battlefield.Ornithopter.Keywords = Flying; Trample
? Bot2.Battlefield.Ornithopter.Power = 0
? Bot2.Battlefield.Ornithopter.Toughness = 2
? Bot2.Battlefield.Ornithopter.Keywords = Flying
Bot1.Hand.Ornithopter.Cast
