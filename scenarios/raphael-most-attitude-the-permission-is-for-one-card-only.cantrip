[T3 Bot1.DeclareAttackers]
Bot1.Attack(Raphael, Most Attitude > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Exile.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
! Bot1.Exile.Mountain.Play

