? Bot1.Mana = 
[T13 Bot1.DeclareAttackers]
Bot1.Attack(Galvanizing Tenor > Bot2; Ornithopter > Bot3)
! Bot1.Target(Bot2.Battlefield.Forest)
Bot1.Target(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Bot2.Battlefield.Llanowar Elves.GoadedBy = Bot1
[T16 Bot1.DeclareAttackers]
Bot1.Attack(Galvanizing Tenor > Bot2; Ornithopter > Bot2)
! Bot1.Target(Bot2.Battlefield.Llanowar Elves; Bot3.Battlefield.Llanowar Elves)
Bot1.Target(Bot3.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot3.Pass

