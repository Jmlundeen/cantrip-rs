# Surveil 1 on entering (CR 701.46a) is a choice: Bot1 leaves the Mountain on top this time (the graveyard scenario puts it
# away) and draws it on turn 3. The Falls is an Island Mountain that entered tapped (CR 614.1c): its mana abilities are
# refused on turn 1, it adds {U} on turn 3 and {R} on turn 5, one mana each time.

[Bot1 Deck]
Thundering Falls
Island x6
Mountain
Island x9

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Thundering Falls.Play
Bot1.Arrange(Mountain)
! Bot1.Battlefield.Thundering Falls.Activate(Ability: {U})
? Bot1.Battlefield.Thundering Falls.Subtypes = Island; Mountain
[T3 Bot1.Main1]
Bot1.Battlefield.Thundering Falls.Activate(Ability: {U})
? Bot1.Mana = {U}
[T5 Bot1.Main1]
Bot1.Battlefield.Thundering Falls.Activate(Ability: {R})
? Bot1.Mana = {R}

[Expect]
Bot1.Graveyard.Count = 0
Bot1.Hand.Count = 8
