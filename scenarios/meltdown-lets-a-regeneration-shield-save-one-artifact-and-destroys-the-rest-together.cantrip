Bot2.Battlefield.Yavimaya Hollow.Activate(Bot2.Battlefield.Ornithopter; Ability: Regenerate)
Bot2.Battlefield.Mox Emerald.Activate
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot1.Graveyard = Meltdown
Bot2.Battlefield = Yavimaya Hollow; Ornithopter
