# "This land enters tapped unless you control a Plains or an Island" (CR 614.12a, 305.7). Beside only a Mountain the
# Monastery enters tapped (turn 3); once a Plains is out, the second one enters untapped (turn 7), the positive control
# for the first. The Monastery taps for {R}, so the Mountain is no help to its own condition.

[Bot1 Deck]
Mountain
Cori Mountain Monastery
Plains
Cori Mountain Monastery
Mountain x3
Mountain x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Cori Mountain Monastery.Play
? Bot1.Battlefield.Cori Mountain Monastery.Tapped = true
[T5 Bot1.Main1]
Bot1.Hand.Plains.Play
[T7 Bot1.Main1]
Bot1.Hand.Cori Mountain Monastery.Play
? Bot1.Battlefield.Cori Mountain Monastery#2.Tapped = false

[Expect]
Turn = 7
Bot1.Battlefield.Cori Mountain Monastery#1.Tapped = false
Bot1.Battlefield.Cori Mountain Monastery#2.Tapped = false
