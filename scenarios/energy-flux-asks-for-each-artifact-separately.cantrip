# Each artifact has its own copy of the granted upkeep ability, and each asks for its own {2} (CR 113.2c, 603.2): Bot1
# pays for the first that resolves and declines the second, so the artifact it paid for stays and only the other is
# sacrificed - each ability sacrifices the artifact that has it, never Energy Flux (CR 701.21a, 118.12a).
[Bot1 Deck]
Black Lotus
Energy Flux
Memnite
Ornithopter
Ancient Tomb
Island x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ancient Tomb.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Energy Flux.Cast
? Bot1.Mana =
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Upkeep]
Bot1.Triggers(Memnite; Ornithopter)
? Stack.Count = 2
Bot1.Pass
Bot1.Battlefield.Ancient Tomb.Activate
Bot1.PayCost
? Bot1.Mana =
Bot1.Pass
Bot1.Decline
[T3 Bot1.Main1]

[Expect]
Bot1.Battlefield.Energy Flux.Types = Enchantment
Bot1.Battlefield.Ornithopter.Power = 0
Bot1.Graveyard = Memnite; Black Lotus
