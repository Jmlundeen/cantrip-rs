# "You may begin the game with it on the battlefield": Bot1 declines, so the Leyline stays in hand and replaces nothing - the
# control for the sibling scenarios. Bot1's Lightning Bolt kills Bot2's Llanowar Elves and it goes to Bot2's graveyard.

[Bot1 Deck]
Leyline of the Void
Mox Ruby
Lightning Bolt
Island x4
Island x12

[Bot2 Deck]
Mox Emerald
Llanowar Elves
Island x18

[Actions]
Bot1.Decline
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot1.Pass

[Expect]
Stack.Count = 0
Bot2.Graveyard = Llanowar Elves
Exile.Count = 0
Bot1.Hand.Count = 6
