# Bot1 casts Time Walk on turn 1 off an Island and a Mox. Turn 2 is Bot1's again: it untaps, draws and plays a second
# land. Turn 3 goes back to Bot2, so turn order resumes after the extra turn.

[Bot1 Deck]
Island
Mox Sapphire
Time Walk
Island x4
Island x10

[Bot2 Deck]
Swamp x17

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Time Walk.Cast
[T2 Bot1.Main1]
? ActivePlayer = Bot1
Bot1.Hand.Island.Play
[T3 Bot2.Main1]

[Expect]
Turn = 3
ActivePlayer = Bot2
Bot1.Graveyard = Time Walk
Bot1.Battlefield = Island; Island; Mox Sapphire
Bot1.Battlefield.Mox Sapphire.Tapped = false
Bot1.Hand = Island; Island; Island; Island
Bot2.Hand.Count = 8
