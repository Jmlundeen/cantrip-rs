# Okoye, Mighty and Adored: she makes Bot1 the monarch, and at the beginning of each of Bot1's combats puts a +1/+1
# counter on a creature (Okoye herself, turns one, three and five). On turn four Bot2's Llanowar Elves connect and Bot2
# becomes the monarch, so on turn five Okoye attacking Bot2 is attacking the monarch and gains double strike and trample.

[Bot1 Deck]
Forest
Sol Ring
Mox Emerald
Mox Pearl
Okoye, Mighty and Adored
Forest x2
Forest x10

[Bot2 Deck]
Forest
Llanowar Elves
Forest x15

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Okoye, Mighty and Adored.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Attack(Llanowar Elves > Bot1)
[T5 Bot1.Main1]
Bot1.Target(Okoye, Mighty and Adored)
Bot1.Attack(Okoye, Mighty and Adored > Bot2)
Bot1.Pass

[Expect]
Turn = 5
Monarch = Bot2
Bot1.Battlefield.Okoye, Mighty and Adored.Counters.PlusOnePlusOne = 3
Bot1.Battlefield.Okoye, Mighty and Adored.Keywords = DoubleStrike; Trample
