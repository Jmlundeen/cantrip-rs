! Bot1.Battlefield.Wrecking Ball Arm.Activate(Ability: Equip legendary creature)
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Wrecking Ball Arm.Activate(Bot1.Battlefield.Elvish Mystic; Ability: Equip {7})
Bot1.Pass
Bot1.Attack(Elvish Mystic > Bot2)
! Bot2.Block(Bot2.Battlefield.Elvish Mystic > Bot1.Battlefield.Elvish Mystic)
Bot2.Block(Cogwork Librarian > Bot1.Battlefield.Elvish Mystic)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Cogwork Librarian
Bot1.Battlefield.Elvish Mystic.Power = 7
Bot1.Battlefield.Elvish Mystic.Damage = 3
