# Surveil looks at the top card, and there is none (CR 701.46a): with a seven-card deck the library is empty when the Parlor
# enters on turn one, so no placement question is asked (`! Bot1.Arrange`) and the land simply stays tapped on the battlefield.

[Bot1 Deck]
Elegant Parlor
Island x6

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Elegant Parlor.Play
! Bot1.Arrange

[Expect]
Bot1.Battlefield = Elegant Parlor
Bot1.Battlefield.Elegant Parlor.Tapped = true
Bot1.Library.Count = 0
