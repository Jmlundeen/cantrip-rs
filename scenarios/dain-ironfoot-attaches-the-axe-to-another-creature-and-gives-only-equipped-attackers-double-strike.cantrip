Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dáin Ironfoot.Cast
Bot1.Target(Ornithopter#1)
[T1 Bot1.Main2]
? Bot1.Battlefield.Axe.Types = Artifact
? Bot1.Battlefield.Axe.Subtypes = Equipment
? Bot1.Battlefield.Ornithopter#1.Power = 1
? Bot1.Battlefield.Ornithopter#2.Power = 0
? Bot1.Battlefield.Dáin Ironfoot.Power = 1
[T3 Bot1.Main1]
Bot1.Attack(Dáin Ironfoot; Ornithopter#1; Ornithopter#2 > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Ornithopter#1.Keywords = DoubleStrike; Flying
Bot1.Battlefield.Ornithopter#2.Keywords = Flying
Bot1.Battlefield.Dáin Ironfoot.Keywords = (absent)
