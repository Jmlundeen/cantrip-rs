# Worf, Still Not Merry counts only attacking NON-Faerie creatures. Argothian Pixies is a Faerie and attacks beside him, so only
# Worf counts and exactly one Faerie token is made (CR 603.4): three attackers and one token where two non-Faerie attackers make
# two, 5 + 2 + 1 damage.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Sapphire
Black Lotus
Worf, Still Not Merry
Argothian Pixies
Forest
Island x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Argothian Pixies.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Worf, Still Not Merry.Cast
? Bot1.Mana =
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Worf, Still Not Merry > Bot2; Argothian Pixies > Bot2)
Bot1.Pass
Bot2.Pass
? Combat.Attackers.Count = 3
? Bot1.Battlefield.Faerie Token.Tapped = true
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Count = 7
Bot1.Battlefield.Faerie Token.Keywords = Flying
Bot1.Battlefield.Faerie Token.Colors = Blue
Bot2.Life = 12
