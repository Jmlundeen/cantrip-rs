# The token copy of Sphinx of False Conclusions has the card's abilities (CR 707.2). Bot1 casts the Sphinx in its main
# phase of turn 1 and Bot2 bolts it on turn 2: the token copy arrives under Bot1's control before turn 3, so it can
# attack, and "whenever this creature attacks, draw a card, then discard a card" works for it as well: Bot1 draws and
# discards a Forest. Bot2 bolts the token (its copy ability needs a nontoken, so nothing more is created).

[Bot1 Deck]
Mox Sapphire
Black Lotus
Sphinx of False Conclusions
Forest
Forest
Forest
Forest
Island
Forest x10

[Bot2 Deck]
Mountain
Mox Ruby
Lightning Bolt
Lightning Bolt
Mountain x3
Mountain
Mountain x10

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Sphinx of False Conclusions.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Sphinx of False Conclusions)
Bot2.Battlefield.Mountain.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Sphinx of False Conclusions.Power = 4
? Bot1.Graveyard = Sphinx of False Conclusions; Black Lotus
? Bot1.Battlefield.Sphinx of False Conclusions.Token = true
[T3 Bot1.Main1]
Bot1.Attack(Sphinx of False Conclusions > Bot2)
Bot1.Pass
Bot1.Choose(Forest)
? Bot1.Hand.Count = 5
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Sphinx of False Conclusions)
Bot2.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Battlefield = Mox Sapphire
Bot1.Graveyard = Forest; Sphinx of False Conclusions; Black Lotus
Bot2.Life = 20
Bot2.Graveyard = Lightning Bolt; Lightning Bolt
