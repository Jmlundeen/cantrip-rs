Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dawn of a New Age.Cast
[Bot1.Main2]
? Bot1.Battlefield.Dawn of a New Age.Counters.Hope = 1
[T2 Bot2.Main1]

