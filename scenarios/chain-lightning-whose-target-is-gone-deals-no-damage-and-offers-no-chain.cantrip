# Chain Lightning has one target. When Bot2 Swords its own Llanowar Elves in response, the target is illegal on resolution
# and the spell does not resolve (CR 608.2b): no damage is dealt (Bot2's 21 is the Swords' life for the Elves' power 1) and nobody is offered {R}{R}, though Bot2 has Mox Ruby and
# Gleemox untapped and could pay (it never pays: the script has no PayCost and ends with both Moxen untapped).

[Bot1 Deck]
Mountain
Chain Lightning
Mountain x12

[Bot2 Deck]
Forest
Llanowar Elves
Mox Ruby
Gleemox
Mox Pearl
Swords to Plowshares
Forest x10

[Actions]
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Gleemox.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Chain Lightning.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Swords to Plowshares.Cast(Bot2.Battlefield.Llanowar Elves)
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Exile = Llanowar Elves
Bot2.Life = 21
Bot1.Life = 20
Bot2.Battlefield.Mox Ruby.Tapped = false
Bot2.Battlefield.Gleemox.Tapped = false
Bot1.Graveyard = Chain Lightning
Stack.Count = 0
