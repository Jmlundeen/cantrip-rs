# The Lander is not conditional on the destruction: Bot2 makes its Ornithopter indestructible in response (Boros Charm,
# CR 702.12b), the destroy does nothing, and Bot2 still creates the Lander.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Emergency Eject
Plains x20

[Bot2 Deck]
Mox Pearl
Mox Ruby
Ornithopter
Boros Charm
Mountain x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Emergency Eject.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot2.Hand.Boros Charm.Cast
Bot2.Modes(2)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Pearl.Activate
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield = Mox Pearl; Mox Ruby; Ornithopter; Lander Token
Bot2.Battlefield.Ornithopter.Keywords = Flying; Indestructible
