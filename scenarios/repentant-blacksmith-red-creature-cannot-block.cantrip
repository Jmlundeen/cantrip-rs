# Protection from red prevents a red creature from blocking Repentant Blacksmith,
# while a colorless creature can block it (CR 702.16f).
[Bot1 Deck]
Repentant Blacksmith
Mox Pearl
Mox Sapphire
Plains x20

[Bot2 Deck]
Mons's Goblin Raiders
Mox Ruby
Ornithopter
Mountain x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Repentant Blacksmith.Cast
? Bot1.Mana =
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Mons's Goblin Raiders.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Repentant Blacksmith > Bot2)
[T3 Bot1.DeclareBlockers]
! Bot2.Block(Mons's Goblin Raiders > Repentant Blacksmith)
Bot2.Block(Ornithopter > Repentant Blacksmith)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Repentant Blacksmith.Damage = 0
Bot2.Battlefield.Ornithopter.Damage = 1
