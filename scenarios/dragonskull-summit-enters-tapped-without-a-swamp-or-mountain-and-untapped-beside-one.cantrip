# Dragonskull Summit: "This land enters tapped unless you control a Swamp or a Mountain." (CR 614.12, 614.1d: read on the
# battlefield as it enters, the land itself never counted). Beside a Forest only the first copy enters tapped (turn 3);
# once a Swamp is out the second enters untapped (turn 7), the positive control for the first and the Swamp branch (the
# Mountain branch is the other scenario). It also taps for {B} or {R}: green is refused beside the red it does add, and
# the {R} activation is that positive control; the second copy then taps for {B}, the other half of the choice. Bot2's
# Swamp and Mountain do not count: not "you control".

[Bot1 Deck]
Forest
Dragonskull Summit
Swamp
Dragonskull Summit
Swamp x10

[Bot2 Deck]
Swamp
Mountain
Forest x14

[Actions]
Bot1.Hand.Forest.Play
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
[T3 Bot1.Main1]
Bot1.Hand.Dragonskull Summit.Play
? Bot1.Battlefield.Dragonskull Summit.Tapped = true
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T5 Bot1.Main1]
! Bot1.Battlefield.Dragonskull Summit.Activate(Ability: {B} or {R}; Color: Green)
Bot1.Battlefield.Dragonskull Summit.Activate(Ability: {B} or {R}; Color: Red)
? Bot1.Mana = {R}
Bot1.Hand.Swamp.Play
[T7 Bot1.Main1]
Bot1.Hand.Dragonskull Summit.Play
? Bot1.Battlefield.Dragonskull Summit#2.Tapped = false
Bot1.Battlefield.Dragonskull Summit#2.Activate(Ability: {B} or {R}; Color: Black)
? Bot1.Mana = {B}

[Expect]
Turn = 7
Bot1.Battlefield.Dragonskull Summit#2.Tapped = true
