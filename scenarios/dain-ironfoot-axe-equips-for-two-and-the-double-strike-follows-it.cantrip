# The Axe token has equip {2} (CR 702.6a): after it went to Dain, Bot1 pays {2} on turn 3 to move it to an Ornithopter (the old
# equipment link is replaced, CR 301.5c). Attacking with both, only the newly equipped Ornithopter (1/2) gets double strike, Dain
# (1/4, no longer equipped) does not: 1 x 2 + 1 = 3 damage.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Jet
Ornithopter
Dáin Ironfoot
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dáin Ironfoot.Cast
Bot1.Target(Dáin Ironfoot)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Axe.Activate(Bot1.Battlefield.Ornithopter; Ability: Equip)
Bot1.Attack(Dáin Ironfoot; Ornithopter > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot1.Battlefield.Ornithopter.Power = 1
Bot1.Battlefield.Ornithopter.Keywords = DoubleStrike; Flying
Bot1.Battlefield.Dáin Ironfoot.Power = 1
Bot1.Battlefield.Dáin Ironfoot.Keywords = (absent)
