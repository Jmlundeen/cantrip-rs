# Salt Vampire takes at most one nonland from its opponent, not its controller (CR 608.2d, 701.13a).
# Two opponents force a targeting prompt; combat on Bot1's second turn proves lifelink (CR 702.15b).
# Two white mana cannot pay {1}{B}; after adding black, the cast leaves one white (CR 601.2f, 601.2h).

[Bot1 Deck]
Salt Vampire
Mox Jet
Mox Pearl x2
Duress
Swamp x20

[Bot2 Deck]
Lightning Bolt
Counterspell
Island x5
Mountain
Island x12

[Bot3 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Pearl#2.Activate
! Bot1.Hand.Salt Vampire.Cast(Mana: short)
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Salt Vampire.Cast
Bot1.Pass
? Bot1.Mana = {W}
! Bot1.Target(Bot1)
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Island)
! Bot1.Choose(Duress)
! Bot1.Choose(Lightning Bolt; Counterspell)
Bot1.Choose(Lightning Bolt)
? Bot2.Hand = Counterspell; Island; Island; Island; Island; Island; Mountain
? Bot2.Library.Count = 12
? Bot2.Graveyard.Count = 0
[T4 Bot1.DeclareAttackers]
Bot1.Attack(Salt Vampire > Bot2)
[T4 Bot1.Main2]

[Expect]
Exile = Lightning Bolt
Bot1.Battlefield.Salt Vampire.Power = 2
Bot1.Battlefield.Salt Vampire.Toughness = 2
Bot1.Battlefield.Salt Vampire.Keywords = Lifelink
Bot1.Life = 22
Bot2.Life = 18
