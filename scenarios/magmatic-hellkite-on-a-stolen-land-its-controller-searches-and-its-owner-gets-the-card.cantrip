Bot1.Graveyard = Bazaar of Baghdad
Bot2.Battlefield.Forest#3.Tapped = true
Bot2.Battlefield.Forest#3.Counters.Stun = 1
Bot1.Battlefield.Magmatic Hellkite.Tapped = false
