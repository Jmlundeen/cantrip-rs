Bot2.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Black)
Bot2.Hand.Oubliette.Cast
Bot2.Pass
Bot2.Pass
[T3 Bot1.Main1]
? Bot2.PhasedOut = Sazh's Chocobo
Bot1.Hand.Forest.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Assassin's Trophy.Cast(Bot2.Battlefield.Oubliette)
Bot2.Accept
Bot2.Search(Forest)
[T3 Bot1.Main2]

[Expect]
Bot2.PhasedOut.Count = 0
Bot2.Graveyard = Oubliette; Black Lotus
Bot2.Battlefield = Forest; Forest; Sazh's Chocobo
Bot2.Battlefield.Sazh's Chocobo.Tapped = true
Bot2.Battlefield.Sazh's Chocobo.Counters.PlusOnePlusOne = 1
