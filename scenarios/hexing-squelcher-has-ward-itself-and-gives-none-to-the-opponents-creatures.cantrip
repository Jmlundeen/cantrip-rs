# Hexing Squelcher's own Ward-Pay 2 life: Bot2 pays it to Bolt the Squelcher (a 2/2: it dies, Bot2 at 18). And the ward is only for
# creatures Bot1 controls: on turn 3 Bot1's Bolt at Bot2's Ornithopter asks Bot1 nothing (the refused Accept) and kills it.

[Bot1 Deck]
Mox Ruby
Mox Jet
Hexing Squelcher
Lightning Bolt
Island x20

[Bot2 Deck]
Mountain
Lightning Bolt
Ornithopter
Mountain x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hexing Squelcher.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Hexing Squelcher)
Bot2.Accept
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
! Bot1.Accept
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Graveyard = Lightning Bolt; Hexing Squelcher
Bot2.Graveyard = Ornithopter; Lightning Bolt
