[T6 Bot2.Main2]
? Bot2.Life = 20
[T8 Bot2.Main1]
Bot2.Attack(Elvish Mystic > Bot1.Battlefield.Oko, Thief of Crowns; Elvish Mystic#2 > Bot1)
[T8 Bot2.Main2]

[Expect]
Monarch = Bot2
Bot2.Life = 13
Bot1.Life = 19
