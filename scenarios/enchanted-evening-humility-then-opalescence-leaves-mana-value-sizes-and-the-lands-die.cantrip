Bot1.Battlefield.Humility.Types = Enchantment; Creature
Bot1.Battlefield.Humility.Power = 4
Bot1.Battlefield.Humility.Toughness = 4
Bot1.Battlefield.Opalescence.Types = Enchantment
Bot1.Graveyard.Count = 6
