# "you may reveal ... If you don't, this land enters tapped" (CR 614.1d): Bot1 declines the reveal, so Fortified Village
# enters the battlefield tapped and cannot be tapped for mana that turn.

[Bot1 Deck]
Fortified Village
Forest
Plains x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Fortified Village.Play
Bot1.Decline
? Bot1.Battlefield.Fortified Village.Tapped = true
! Bot1.Battlefield.Fortified Village.Activate(Color: Green)

[Expect]
Turn = 1
Bot1.Battlefield.Fortified Village.Tapped = true
