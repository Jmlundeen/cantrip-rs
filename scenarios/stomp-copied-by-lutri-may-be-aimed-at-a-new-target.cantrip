# A copy of an Adventure spell is an Adventure with the Adventure's characteristics (CR 715.3c), so its new targets are
# chosen by the Adventure's own target slot: Lutri copies Stomp, cast from Bonecrusher Giant at Bot2, and the copy is
# aimed at Bot2's Llanowar Elves instead (CR 707.10c). The copy kills the Elves, Stomp deals Bot2 2, and Bonecrusher
# Giant goes on its adventure into exile (CR 715.3d); the copy ceases to exist.

[Bot1 Deck]
Mountain
Mox Ruby
Mox Sapphire
Sol Ring
Bonecrusher Giant
Lutri, the Spellchaser
Island
Island x8

[Bot2 Deck]
Forest
Llanowar Elves
Forest x13

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Mox Ruby.Activate
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Forest.Activate
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Hand.Bonecrusher Giant.Cast(Bot2; Ability: Adventure)
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lutri, the Spellchaser.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Pass
Bot1.Target(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Bot2.Life = 18
Bot2.Graveyard = Llanowar Elves
Exile = Bonecrusher Giant
Bot1.Graveyard.Count = 0
