# Insatiable Avarice with both modes ({B} + {2} + {B}{B} = five mana: a Black Lotus and two Mox Jets): "No matter which modes you
# choose, you always follow the instructions in the order they are written". Bot1 targets itself. The search comes first: the Lightning Bolt
# buried third in the library is shuffled in and put on top; then Bot1 draws three cards - the Bolt first, then the two Swamps now on top
# of it - and loses 3 life. If the draw came first the Bolt would not be in hand.

[Bot1 Deck]
Black Lotus
Insatiable Avarice
Mox Jet
Mox Jet
Swamp x3
Swamp
Swamp
Lightning Bolt
Swamp x11

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Insatiable Avarice.Cast
Bot1.Modes(1; 2)
Bot1.Target(Bot1)
Bot1.Search(Lightning Bolt)
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 1
Bot1.Life = 17
Bot1.Hand = Swamp; Swamp; Swamp; Lightning Bolt; Swamp; Swamp
Bot1.Library.Count = 11
Bot2.Life = 20
Bot2.Hand.Count = 7
