! Bot1.Target(Bot2.Battlefield.Island)
! Bot1.Target(Bot2.Battlefield.Basalt Monolith)
Bot1.Target(Bot2.Battlefield.Mox Ruby)
[T3 Bot1.Main1]

[Expect]
Bot2.Battlefield = Island; Mox Pearl; Mox Sapphire; Basalt Monolith
Bot2.Graveyard = Mox Ruby
Bot1.Graveyard = Witherbloom Charm
