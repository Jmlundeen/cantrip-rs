# Goblin Welder: "that player" is the controller of the chosen artifact, not the Welder's. Bot1 chooses Bot2's Ornithopter
# and the Welding Jar in Bot2's graveyard: Bot2 sacrifices the Ornithopter and the Jar returns to the battlefield under
# Bot2's control.

[Bot1 Deck]
Mountain
Goblin Welder
Mountain x18

[Bot2 Deck]
Welding Jar
Ornithopter
Island x18

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goblin Welder.Cast
[T2 Bot2.Main1]
Bot2.Hand.Welding Jar.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Battlefield.Welding Jar.Activate(Bot2.Battlefield.Ornithopter)
[T3 Bot1.Main1]
Bot1.Battlefield.Goblin Welder.Activate
Bot1.Target(Ornithopter)
Bot1.Target(Welding Jar)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot1.Battlefield = Mountain; Goblin Welder
Bot2.Battlefield = Welding Jar
Bot2.Graveyard = Ornithopter
