# Leyline of the Void, begun on the battlefield (CR 103.6a): Bot1's Lightning Bolt kills Bot2's Llanowar Elves, which is put into
# an opponent's graveyard from the battlefield and so is exiled instead; the Bolt itself goes to Bot1's own graveyard as always.
# Bot2's graveyard stays empty and the Elves are in exile.

[Bot1 Deck]
Leyline of the Void
Mox Ruby
Lightning Bolt
Island x4
Island x12

[Bot2 Deck]
Mox Emerald
Llanowar Elves
Island x18

[Actions]
Bot1.Accept
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot1.Pass

[Expect]
Stack.Count = 0
Bot2.Graveyard.Count = 0
Bot2.Graveyard =
Exile = Llanowar Elves
Bot1.Graveyard = Lightning Bolt
Bot2.Battlefield = Mox Emerald
