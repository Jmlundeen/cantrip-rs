Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Bazaar of Baghdad.Play
[T5 Bot1.Main1]
Bot1.Hand.Field of Ruin.Play
Bot1.Battlefield.Tundra.Activate(Ability: {W})
Bot1.Battlefield.Island.Activate
! Bot1.Battlefield.Field of Ruin.Activate(Ability: Destroy; Bot2.Battlefield.Island)
! Bot1.Battlefield.Field of Ruin.Activate(Ability: Destroy; Bot1.Battlefield.Tundra)
Bot1.Battlefield.Field of Ruin.Activate(Ability: Destroy; Bot2.Battlefield.Bazaar of Baghdad)
Bot1.Search(Plains)
Bot2.Search(Forest)

