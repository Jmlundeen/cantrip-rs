Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Sword of Light and Shadow.Activate(Ornithopter)
Bot1.Pass
Bot2.Pass
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Grizzly Bears > Bot1)
Bot1.Block(Ornithopter > Grizzly Bears)
Bot2.Pass
Bot1.Pass
[T4 Bot2.Main2]

[Expect]
Bot1.Life = 20
Bot2.Life = 20
Bot1.Battlefield.Ornithopter.Damage = 2
