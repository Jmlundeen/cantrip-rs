[Bot3 Deck]
Sol Ring
Lightning Bolt
Island x5
Island x10

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Show and Tell.Cast
Bot1.Choose(Mother of Runes)
! Bot2.Choose

[Expect]
Bot1.Battlefield = Island; Mox Sapphire; Mox Sapphire; Mother of Runes
Bot2.Battlefield.Count = 0
Bot2.Hand.Count = 7
Bot3.Battlefield = Sol Ring
Bot3.Hand = Lightning Bolt; Island; Island; Island; Island; Island
