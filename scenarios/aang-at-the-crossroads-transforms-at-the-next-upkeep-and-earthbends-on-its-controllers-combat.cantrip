? Bot1.Battlefield.Aang, Destined Savior.Power = 4
[T4 Bot2.End]
? Bot1.Battlefield.Forest.Types = Land
[T5 Bot1.BeginCombat]
Bot1.Attack(Aang, Destined Savior; Forest)
[T5 Bot1.Main2]

[Expect]
