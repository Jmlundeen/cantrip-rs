Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Spider-Man No More.Cast(Llanowar Elves)
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main1]
! Bot2.Battlefield.Llanowar Elves.Activate
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass

