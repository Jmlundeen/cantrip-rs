Bot1.Hand.Nowhere to Run.Cast
Bot1.Pass
Bot1.Target(Elvish Mystic)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Sylvan Caryatid)
Bot2.Battlefield.Plains.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Disenchant.Cast(Nowhere to Run)
Bot2.Pass
Bot1.Pass
! Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Sylvan Caryatid)
[T5 Bot1.Main2]

[Expect]
Bot1.Graveyard = Lightning Bolt; Nowhere to Run
Bot2.Graveyard = Elvish Mystic; Disenchant
Bot2.Battlefield.Sylvan Caryatid.Damage = 0
