# The mirror: control, not ownership. Bot1 steals Bot2's Llanowar Elves with Vengeful Possession (until end of turn) on turn 3 and bolts it. It is
# a creature Bot1 controls, not "a creature an opponent controls", so Vren does not replace its dying: it goes to its OWNER's graveyard, Bot2's
# (nothing is exiled). It was not exiled under an opponent's control, so the end step makes no Rat.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Ruby
Mox Ruby
Vren, the Relentless
Vengeful Possession
Island
Lightning Bolt
Island x10

[Bot2 Deck]
Forest
Llanowar Elves
Forest x18

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Vren, the Relentless.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Vengeful Possession.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot1.Choose()
? Bot1.Battlefield.Llanowar Elves.Power = 1
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Exile.Count = 0
[T3 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Exile.Count = 0
Bot2.Graveyard = Llanowar Elves
Bot1.Battlefield.Count = 5
