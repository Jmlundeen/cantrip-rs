Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Forest.Play
Bot2.Hand.Keen-Eyed Curator.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Forest.Activate
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Forest.Activate
[T5 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Torch the Tower.Cast(Bot2.Battlefield.Keen-Eyed Curator)
Bot1.Battlefield.Mountain.Activate
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Keen-Eyed Curator.Damage = 2
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Keen-Eyed Curator)
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Battlefield.Mox Ruby.Activate

[Expect]
Exile = Keen-Eyed Curator
Bot2.Graveyard = Llanowar Elves
Bot2.Battlefield.Count = 3
Bot1.Graveyard = Lightning Bolt; Lightning Bolt; Torch the Tower
