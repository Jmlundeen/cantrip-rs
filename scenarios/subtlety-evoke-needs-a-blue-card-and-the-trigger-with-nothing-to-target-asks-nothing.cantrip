# Subtlety: "Evoke - Exile a blue card from your hand" needs a blue card (CR 118.9): with only a red Lightning Bolt and
# colorless cards in hand the evoke way is refused, and the cast for {2}{U}{U} (Black Lotus and Mox Sapphire) is the positive
# control. With no creature spell or planeswalker spell on the stack its "choose up to one target" has no candidate: nothing
# is asked, and as it was not evoked the 3/3 flyer stays on the battlefield.

[Bot1 Deck]
Subtlety
Mox Sapphire
Black Lotus
Lightning Bolt
Island x3
Island x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
! Bot1.Hand.Subtlety.Cast(Ability: Evoke)
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Subtlety.Cast
Bot1.Pass
Bot2.Pass
! Bot1.Target
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Subtlety.Power = 3
Bot1.Battlefield.Subtlety.Keywords = Flash; Flying
Exile.Count = 0
