# Pensive Professor draws only for +1/+1 counters: on turn 2 Bot2's Deluge Virtuoso enters and puts a stun counter on the
# Professor, and Bot1 draws nothing for it (its hand stays at three). Bot2's spell is not Bot1's, so increment does not
# trigger either.

[Bot1 Deck]
Mox Sapphire
Mox Sapphire
Mox Ruby
Pensive Professor
Island
Island
Island
Island x14

[Bot2 Deck]
Mox Sapphire
Mox Jet
Mox Ruby
Deluge Virtuoso
Island x17

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Pensive Professor.Cast
[T2 Bot2.Main1]
? Bot1.Hand.Count = 3
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Deluge Virtuoso.Cast
[T2 Bot2.Main2]
? Bot1.Battlefield.Pensive Professor.Counters.Stun = 1

[Expect]
Bot1.Hand.Count = 3
Bot1.Battlefield.Pensive Professor.Power = 0
