Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Llanowar Elves.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Clarion Conqueror.Cast
Bot1.Pass
[T3 Bot1.Main1]
! Bot1.Battlefield.Llanowar Elves.Activate
Bot1.Hand.Elvish Spirit Guide.Activate
? Bot1.Mana = {G}

[Expect]
Exile = Elvish Spirit Guide
Bot1.Battlefield = Clarion Conqueror; Llanowar Elves; Mox Emerald
