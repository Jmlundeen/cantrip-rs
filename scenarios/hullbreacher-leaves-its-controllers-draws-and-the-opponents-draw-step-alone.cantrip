# Hullbreacher replaces only an opponent's draws beyond the first of their draw step. Bot1 flashes it in on turn 1 (a
# Mox Sapphire, Mox Jet and Mox Pearl pay), then draws normally: its own Brainstorm on turn 3 draws three cards and no
# Treasure is made. Bot2's draws for its turns 2 and 4 are the first of their draw steps and are not replaced either:
# Bot2's library goes down by one each turn, and Bot1 never has a Treasure.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Pearl
Hullbreacher
Brainstorm
Island
Island
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Hullbreacher.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Brainstorm.Cast
Bot1.Pass
Bot1.Choose(Island; Island)
[T4 Bot2.Main1]

[Expect]
Bot2.Library.Count = 11
Bot1.Battlefield.Count = 4
Bot1.Hand.Count = 4
