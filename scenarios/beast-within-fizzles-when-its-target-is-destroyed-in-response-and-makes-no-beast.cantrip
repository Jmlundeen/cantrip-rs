# The ruling: if the target is illegal by the time Beast Within tries to resolve, the spell won't resolve and no player
# creates a Beast (CR 608.2b). Bot2 answers with Shatter on its own Mox Sapphire and no Beast appears; a second Beast
# Within, whose target stays, destroys Bot2's Mountain and does leave Bot2 the 3/3 green Beast.

[Bot1 Deck]
Mox Emerald
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Beast Within
Beast Within
Forest x10

[Bot2 Deck]
Mountain
Mox Ruby
Mox Sapphire
Shatter
Island x12

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Beast Within.Cast(Bot2.Battlefield.Mox Sapphire)
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Shatter.Cast(Bot2.Battlefield.Mox Sapphire)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot2.Battlefield.Count = 2
Bot1.Hand.Beast Within.Cast(Bot2.Battlefield.Mountain)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Beast Token.Power = 3

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Battlefield.Count = 2
Bot2.Graveyard.Count = 3
Bot1.Battlefield.Count = 6
