Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Plumb the Forbidden.Cast
Bot1.Modes(1)
Bot1.Pass
Bot1.Pass
[T1 Bot1.Main2]
? Bot1.Life = 19
? Bot1.Hand.Count = 4
? Bot1.Battlefield.Ornithopter.Tapped = false
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp#1.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Hand.Plumb the Forbidden.Cast
Bot1.Modes(2)
Bot1.Pass
Bot1.Pass
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 17
