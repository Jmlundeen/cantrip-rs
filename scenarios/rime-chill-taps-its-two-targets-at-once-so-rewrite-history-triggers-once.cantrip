# Rime Chill's "Tap up to two target creatures" is one instruction (CR 701.26a), so the two Ornithopters Bot1 controls become tapped
# at once and Rewrite History's "whenever one or more creatures you control become tapped" triggers once (CR 603.2c): one plan
# counter, where tapping them one at a time would give two. Rewrite History is Bot1's only colored permanent, so Rime Chill costs
# {5}{U} (vivid 1), paid by Black Lotus, an Island and two Moxen.

[Bot1 Deck]
Black Lotus
Rewrite History
Mox Sapphire
Mox Jet
Mox Ruby
Ornithopter
Ornithopter
Island
Rime Chill
Island x15

[Bot2 Deck]
Forest x16

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rewrite History.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T5 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rime Chill.Cast
Bot1.Target(Bot1.Battlefield.Ornithopter#1; Bot1.Battlefield.Ornithopter#2)
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Ornithopter#1.Tapped = true
Bot1.Battlefield.Ornithopter#2.Tapped = true
Bot1.Battlefield.Ornithopter#1.Counters.Stun = 1
Bot1.Battlefield.Rewrite History.Counters.Plan = 1
