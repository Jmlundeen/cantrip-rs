# Redirect Lightning targets a spell of any controller, including its own caster's: Bot1 casts Lightning Bolt at Bot2,
# then casts Redirect Lightning (paying 5 life, 20 to 15) at its own Bolt and, as it resolves, chooses Bot2's Ornithopter
# (0/2) as the new target: the Bolt kills it and Bot2 keeps all 20 life.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Lightning Bolt
Redirect Lightning
Island x16

[Bot2 Deck]
Ornithopter
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Hand.Redirect Lightning.Cast(Stack.Lightning Bolt)
Bot1.Modes(Pay 5 life)
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Ornithopter)
[Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Life = 15
Bot2.Life = 20
Bot2.Graveyard = Ornithopter
Bot1.Graveyard = Lightning Bolt; Redirect Lightning
