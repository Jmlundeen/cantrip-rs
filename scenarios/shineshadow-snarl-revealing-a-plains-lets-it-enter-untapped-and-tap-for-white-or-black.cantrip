# Shineshadow Snarl: "As this land enters, you may reveal a Plains or Swamp card from your hand. If you don't, this land
# enters tapped. {T}: Add {W} or {B}" (CR 614.1d, 701.20a, 605.1a). Bot1 reveals a Plains, so it enters untapped; on turns
# 3 and 5 it taps for {W} and for {B}, each the single mana the {T} cost buys, and it offers no green. The reveal takes
# exactly one card: choosing both the Plains and the Swamp is refused.

[Bot1 Deck]
Shineshadow Snarl
Plains
Swamp
Island x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Shineshadow Snarl.Play
Bot1.Accept
! Bot1.Choose(Plains; Swamp)
Bot1.Choose(Plains)
? Bot1.Revealed = Plains
? Bot2.Revealed = (absent)
? Bot1.Battlefield.Shineshadow Snarl.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Shineshadow Snarl.Activate(Color: White)
? Bot1.Mana = {W}
[T5 Bot1.Main1]
! Bot1.Battlefield.Shineshadow Snarl.Activate(Color: Green)
Bot1.Battlefield.Shineshadow Snarl.Activate(Color: Black)
? Bot1.Mana = {B}

[Expect]
Turn = 5
Bot1.Battlefield.Shineshadow Snarl.Tapped = true
