# Each {B/P} is paid with {B} or 2 life (CR 107.4f): with a Swamp and a Mox Jet for the two {B} and a Mox Ruby for the
# {1}, no life is paid and Bot2's Elvish Mystic gets -5/-5 and dies.

[Bot1 Deck]
Swamp
Mox Jet
Mox Ruby
Dismember
Island x12

[Bot2 Deck]
Forest
Elvish Mystic
Island x12

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Elvish Mystic.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Dismember.Cast(Elvish Mystic)
Bot1.Modes()
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 20
Bot2.Graveyard = Elvish Mystic
