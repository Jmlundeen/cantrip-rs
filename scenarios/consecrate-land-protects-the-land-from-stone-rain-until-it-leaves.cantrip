Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Stone Rain.Cast(Bot1.Battlefield.Plains)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Plains.Keywords = Indestructible
? Bot1.Graveyard.Count = 0
[T4 Bot2.Main1]
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Disenchant.Cast(Bot1.Battlefield.Consecrate Land)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Plains.Keywords = (absent)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Stone Rain.Cast(Bot1.Battlefield.Plains)
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Battlefield.Plains = (absent)
Bot1.Battlefield = Mox Pearl
Bot1.Graveyard = Plains; Consecrate Land
