# Mox Jasper: "{T}: Add one mana of any color. Activate only if you control a Dragon." With no Dragon it cannot be
# activated (the refusal); once Bot1 casts Phyrexian Dragon Engine (a Dragon) with three other Moxen it adds blue.

[Bot1 Deck]
Mox Jasper
Mox Ruby
Mox Jet
Mox Pearl
Phyrexian Dragon Engine
Mountain x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jasper.Cast
Bot1.Pass
! Bot1.Battlefield.Mox Jasper.Activate
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
! Bot1.Battlefield.Mox Jasper.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Phyrexian Dragon Engine.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Jasper.Activate(Color: Blue)

[Expect]
Bot1.Mana = {U}
