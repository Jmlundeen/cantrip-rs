# Sinkhole Surveyor: Bot1 attacks on turn 3, loses 1 life and declines the counter, so a 1/1 white Spirit token is created and the
# Surveyor stays a 1/3 that deals 1 (CR 701.63a).

[Bot1 Deck]
Mox Jet
Mox Ruby
Sinkhole Surveyor
Swamp x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sinkhole Surveyor.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Attackers]
Bot1.Attack(Sinkhole Surveyor > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Decline
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 19
Bot2.Life = 19
Bot1.Battlefield.Sinkhole Surveyor.Power = 1
Bot1.Battlefield.Sinkhole Surveyor.Toughness = 3
Bot1.Battlefield.Sinkhole Surveyor.Counters.PlusOnePlusOne = (absent)
