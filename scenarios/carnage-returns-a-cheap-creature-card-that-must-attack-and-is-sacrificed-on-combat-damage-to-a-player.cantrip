[T5 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Choose(Carnage, Crimson Chaos; Guerrilla Gorilla)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Graveyard.Carnage, Crimson Chaos.Cast(Ability: Mayhem)
[T5 Bot1.Main2]
? Bot1.Battlefield.Guerrilla Gorilla.SummoningSick = true
? Bot1.Battlefield.Carnage, Crimson Chaos.Keywords = Trample
? Bot1.Graveyard = Faithless Looting
? Bot2.Life = 20
[T7 Bot1.Main2]

