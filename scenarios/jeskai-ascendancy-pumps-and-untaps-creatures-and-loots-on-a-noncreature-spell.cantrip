# Jeskai Ascendancy: Bot1's Ornithopter attacks on turn 3 and is tapped. Casting the noncreature Mox Jet afterwards
# triggers both abilities: the creatures Bot1 controls get +1/+1 and untap, and Bot1 may draw a card and, having drawn,
# discards one.

[Bot1 Deck]
Ornithopter
Mox Sapphire
Mox Ruby
Mox Pearl
Jeskai Ascendancy
Mox Jet
Island
Island x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Jeskai Ascendancy.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.Main2]
? Bot1.Battlefield.Ornithopter.Tapped = true
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Accept
Bot1.Choose(Island)

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Battlefield.Ornithopter.Power = 1
Bot1.Battlefield.Ornithopter.Toughness = 3
Bot1.Graveyard = Island
