# Stoic Sphinx: "This creature has hexproof as long as you haven't cast a spell this turn." Bot1 flashes it in at Bot2's end step
# (turn 2): casting it is casting a spell that turn, so it has no hexproof then (Keywords: Flash; Flying). In Bot1's own next upkeep
# (turn 3) no spell has been cast yet that turn, so it has hexproof (Flash; Flying; Hexproof), and Bot2 cannot target it with a
# Lightning Bolt (refused) though it could target Bot1.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Stoic Sphinx
Swamp x4
Swamp x10

[Bot2 Deck]
Black Lotus
Lightning Bolt
Mountain x5
Mountain x10

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
[T2 Bot2.End]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Stoic Sphinx.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Stoic Sphinx.Keywords = Flash; Flying
[T3 Bot1.Upkeep]
? Bot1.Battlefield.Stoic Sphinx.Keywords = Flash; Flying; Hexproof
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
! Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Stoic Sphinx)
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Pass

[Expect]
Bot1.Battlefield.Stoic Sphinx.Keywords = Flash; Flying; Hexproof
Bot1.Life = 17
Bot1.Battlefield.Stoic Sphinx.Damage = 0
