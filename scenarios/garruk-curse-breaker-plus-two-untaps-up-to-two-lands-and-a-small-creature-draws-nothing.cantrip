Bot1.Hand.Count = 2
Bot1.Battlefield.Garruk, Curse Breaker.Counters.Loyalty = 9
Bot1.Battlefield.Forest#1.Tapped = false
Bot1.Battlefield.Forest#2.Tapped = false
Bot1.Battlefield.Elvish Mystic.Power = 1
