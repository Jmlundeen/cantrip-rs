Bot2.Pass
[T5 Bot1.Main1]
? Bot1.Battlefield.Grizzly Bears.ProtectionFromManaValue = 3
Bot1.Attack(Grizzly Bears > Bot2)
[T5 Bot1.DeclareBlockers]
! Bot2.Block(Gray Ogre > Grizzly Bears)
Bot2.Block(Ornithopter > Grizzly Bears)
