# Glasspool Mimic's "a creature you control" is judged for the player it enters under (CR 614.12, 110.2), not its owner: Bot1
# reanimates Bot2's Mimic, which enters under Bot1 and copies Bot1's Memnite (the one candidate), not Bot2's Ornithopter. The
# Ornithopter entered first, so an engine offering every creature, or its owner's, would copy it.

[Bot1 Deck]
Swamp
Memnite
Reanimate
Swamp x17

[Bot2 Deck]
Black Lotus
Glasspool Mimic
Ornithopter
Island x17

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Glasspool Mimic.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Reanimate.Cast(Bot2.Graveyard.Glasspool Mimic)
Bot1.Pass
Bot2.Pass
Bot1.Accept
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield = Swamp; Memnite; Memnite
Bot1.Battlefield.Memnite#2.Subtypes = Construct; Rogue; Shapeshifter
Bot1.Life = 17
Bot2.Battlefield = Ornithopter
Bot2.Graveyard = Black Lotus
