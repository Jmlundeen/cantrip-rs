Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Duress.Cast(Bot2)
Bot1.Pass
[T3 Bot1.Main1]
