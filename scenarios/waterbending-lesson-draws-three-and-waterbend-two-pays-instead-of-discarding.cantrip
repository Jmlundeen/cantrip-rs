Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island.Activate
Bot1.Hand.Waterbending Lesson.Cast
Bot1.Pass
Bot2.Pass
Bot1.PayCost(Convoke: Memnite, Ornithopter)
? Bot1.Mana =
[T1 Bot1.Main2]

