[T7 Bot1.Main1]
# Nothing is exiled with Botany Bay yet: the combat-damage trigger resolves and returns nothing.
Bot1.Attack(S.S. Botany Bay > Bot2)
Bot1.Pass
Bot2.Pass
Bot2.Pass
Bot2.Pass
? Exile =
? Bot2.Life = 17
# Now Bot1 exiles one card from each graveyard; "you may exile a card" makes the question refuse both.
Bot1.Battlefield.S.S. Botany Bay.Activate(Ability: Each opponent exiles a card from their graveyard. You may exile a card from your graveyard.)
Bot2.Choose(Grizzly Bears)
! Bot1.Choose(Bear Cub; Black Lotus)
Bot1.Choose(Bear Cub)
? Exile = Bear Cub; Grizzly Bears
? Bot1.Graveyard = Black Lotus; Black Lotus

