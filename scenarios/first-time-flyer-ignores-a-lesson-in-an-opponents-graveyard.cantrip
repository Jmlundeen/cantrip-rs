# "In your graveyard" (CR 109.5): a Lesson in Bot2's graveyard, which Bot2's Entomb put there, does nothing for Bot1's First-Time Flyer, still a 1/2.
# Bot1's own Entomb then puts one in Bot1's graveyard and the Flyer is a 2/3.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Jet
First-Time Flyer
Entomb
Island x20
Accumulate Wisdom

[Bot2 Deck]
Mox Jet
Entomb
Island x20
Accumulate Wisdom

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.First-Time Flyer.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Entomb.Cast
Bot2.Pass
Bot1.Pass
Bot2.Search(Accumulate Wisdom)
? Bot2.Graveyard = Entomb; Accumulate Wisdom
? Bot1.Battlefield.First-Time Flyer.Power = 1
? Bot1.Battlefield.First-Time Flyer.Toughness = 2
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Entomb.Cast
Bot1.Pass
Bot2.Pass
Bot1.Search(Accumulate Wisdom)

[Expect]
Bot1.Battlefield.First-Time Flyer.Power = 2
Bot1.Battlefield.First-Time Flyer.Toughness = 3
