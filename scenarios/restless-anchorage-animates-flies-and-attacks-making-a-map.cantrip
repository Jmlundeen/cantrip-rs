Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Restless Anchorage.Activate(Ability: Until end of turn)
Bot1.Attack(Restless Anchorage > Bot2; Elvish Mystic > Bot2)
? Bot1.Battlefield.Restless Anchorage.Types = Land; Creature
? Bot1.Battlefield.Restless Anchorage.Subtypes = Bird
? Bot1.Battlefield.Restless Anchorage.Colors = Blue; White
? Bot1.Battlefield.Restless Anchorage.Keywords = Flying
? Bot1.Battlefield.Restless Anchorage.Power = 2
? Bot1.Battlefield.Restless Anchorage.Toughness = 3
! Bot2.Block(Llanowar Elves > Restless Anchorage)
Bot2.Block(Llanowar Elves > Elvish Mystic)
[T3 Bot1.Main2]
? Bot2.Life = 18
? Bot1.Battlefield.Map Token.Types = Artifact
[T4 Bot2.Main1]

