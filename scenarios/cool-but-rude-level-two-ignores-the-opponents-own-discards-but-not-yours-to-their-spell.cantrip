# Cool but Rude, level 2: "Whenever YOU discard a card, this Class deals 2 damage to each opponent." Turn 1 Bot1 casts
# the Class and levels it to 2 (Bot1 keeps a Lightning Bolt and an Island). On turn 2 Bot2 casts Faithless Looting and
# discards two Islands of its own: those are not Bot1's discards, so nothing is dealt (Bot2 is still at 20, and Bot1 too,
# as the Class damages Bot1's opponents, never Bot1). Then Bot2 casts Hymn to Tourach on Bot1, who discards both cards at
# random: those are Bot1's discards whoever made them, so the Class deals 2 twice and Bot2 is at 16.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Jet
Mountain
Cool but Rude
Lightning Bolt
Island
Plains x10

[Bot2 Deck]
Mox Ruby
Mox Jet
Swamp
Faithless Looting
Hymn to Tourach
Island
Island
Island
Island
Island x10

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Cool but Rude.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Cool but Rude.Activate(Ability: Level 2)
Bot1.Pass
[T2 Bot2.Main1]
? Bot1.Battlefield.Cool but Rude.ClassLevel = 2
? Bot1.Hand = Lightning Bolt; Island
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Faithless Looting.Cast
Bot2.Choose(Island; Island)
? Bot2.Graveyard.Count = 3
? Bot2.Life = 20
? Bot1.Life = 20
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Hymn to Tourach.Cast(Bot1)
[T2 Bot2.Main2]

[Expect]
Bot2.Life = 16
Bot1.Life = 20
Bot1.Hand.Count = 0
Bot1.Graveyard.Count = 2
Bot2.Graveyard.Count = 4
