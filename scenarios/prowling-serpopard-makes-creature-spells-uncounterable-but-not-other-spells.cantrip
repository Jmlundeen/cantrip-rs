Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Elvish Mystic)
? Stack = Counterspell; Elvish Mystic
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Elvish Mystic.Power = 1
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Lightning Bolt)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Battlefield = Elvish Mystic; Forest; Forest; Prowling Serpopard; Mox Emerald; Mox Ruby
Bot1.Graveyard = Lightning Bolt
Bot2.Graveyard.Count = 2
Bot2.Life = 20
