# Quag Feast has one target; if it is illegal as the spell resolves the whole spell does nothing (CR 608.2b), so nothing is
# milled either. Bot2 answers by bolting its own Guerrilla Gorilla in response: Bot1's graveyard is just the Quag Feast and its
# library is untouched.

[Bot1 Deck]
Swamp
Swamp
Quag Feast
Swamp x17

[Bot2 Deck]
Mountain
Mox Emerald
Mox Ruby
Guerrilla Gorilla
Lightning Bolt
Mountain x15

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Guerrilla Gorilla.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Quag Feast.Cast(Bot2.Battlefield.Guerrilla Gorilla)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Guerrilla Gorilla)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Guerrilla Gorilla; Lightning Bolt
Bot1.Graveyard = Quag Feast
Bot1.Library.Count = 12
