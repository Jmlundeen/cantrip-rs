# Leyline of Sanctity: Bot1 declines to begin the game with it on the battlefield (CR 103.6a), so it stays in hand and
# Bot1 has no hexproof: on turn 2 Bot2's Lightning Bolt targets Bot1 and deals 3 (the control for the accepting scenario).

[Bot1 Deck]
Leyline of Sanctity
Island x20

[Bot2 Deck]
Mountain
Mox Ruby
Lightning Bolt
Island x20

[Actions]
Bot1.Decline
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
[T2 Bot2.Main2]

[Expect]
Bot1.Life = 17
Bot1.Hand.Count = 7
Bot1.Battlefield.Count = 0
Bot2.Graveyard = Lightning Bolt
