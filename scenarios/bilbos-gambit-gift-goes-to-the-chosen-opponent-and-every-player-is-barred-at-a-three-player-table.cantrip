# At a table of three Bot1 chooses which opponent the gift is promised to (CR 702.174a): Bot2, not the Bolt's owner Bot3.
# Bot3's Lightning Bolt returns to Bot3's hand and only Bot2 creates the Treasure; "players can't cast spells this turn"
# binds every player, so Bot2 (holding a Bolt and an untapped Mox Ruby) and Bot3 (Bolt back in hand, a second Mox Ruby
# untapped) are both refused the Bolt - neither refusal is about the Treasure's owner or the spell's owner alone.

[Bot1 Deck]
Plains
Mox Pearl
Bilbo's Gambit
Plains x15

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Plains x15

[Bot3 Deck]
Mox Ruby
Mox Ruby
Lightning Bolt
Plains x15

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot1.Pass
Bot3.Pass
[T3 Bot3.Main1]
Bot3.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot3.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot3.Battlefield.Mox Ruby.Activate
Bot3.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bilbo's Gambit.Cast
Bot1.Accept
Bot1.ChoosePlayer(Bot2)
Bot1.Target(Stack.Lightning Bolt)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Stack.Count = 0
? Bot1.Life = 20
? Bot2.Battlefield = Mox Ruby; Treasure Token
? Bot3.Battlefield = Mox Ruby; Mox Ruby
? Bot3.Hand = Lightning Bolt; Plains; Plains; Plains; Plains; Plains
? Bot2.Hand = Lightning Bolt; Plains; Plains; Plains; Plains; Plains; Plains
! Bot3.Hand.Lightning Bolt.Cast
Bot3.Pass
! Bot2.Hand.Lightning Bolt.Cast

[Expect]
Bot1.Graveyard = Bilbo's Gambit
Bot3.Battlefield = Mox Ruby; Mox Ruby
