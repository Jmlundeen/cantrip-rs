# Both Walls able to block must block Marble Priest; their first-strike damage is prevented
# even though it is lethal, while the Priest deals damage back (CR 509.1c, 615.1).
[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Sapphire
Marble Priest
Island x20

[Bot2 Deck]
Black Lotus
Mox Ruby
Wall of Razors
Wall of Razors
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Marble Priest.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Wall of Razors.Cast
Bot2.Hand.Wall of Razors.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Marble Priest > Bot2)
Bot2.Pass
! Bot2.Block(Count: 0)
! Bot2.Block(Wall of Razors#1 > Marble Priest)
Bot2.Block(Wall of Razors#1 > Marble Priest; Wall of Razors#2 > Marble Priest)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Marble Priest.Damage = 0
Bot1.Battlefield.Marble Priest.Toughness = 3
Bot2.Life = 20
Bot2.Graveyard = Wall of Razors; Wall of Razors; Black Lotus
