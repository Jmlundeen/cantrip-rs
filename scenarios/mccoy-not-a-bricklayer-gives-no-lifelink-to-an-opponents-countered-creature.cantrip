Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Dockworker Drone.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.McCoy, Not a Bricklayer.Cast
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Attack(Dockworker Drone > Bot1)
[T5 Bot1.Main1]
Bot1.Attack(Memnite > Bot2)
[T5 Bot1.Main2]
Bot1.Pass
Bot2.Pass

