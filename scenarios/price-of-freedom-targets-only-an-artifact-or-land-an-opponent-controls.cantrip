Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain#1.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Mountain#2.Activate
! Bot1.Hand.Price of Freedom.Cast(Bot1.Battlefield.Sol Ring)
! Bot1.Hand.Price of Freedom.Cast(Bot1.Battlefield.Mountain#1)
! Bot1.Hand.Price of Freedom.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Hand.Price of Freedom.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Decline

[Expect]
Turn = 3
