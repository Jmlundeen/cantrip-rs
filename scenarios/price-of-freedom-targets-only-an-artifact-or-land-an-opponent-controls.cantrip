Bot1.Battlefield = Mountain; Mountain; Sol Ring
Bot1.Hand = Mountain; Mountain; Mountain; Mountain; Island
Bot2.Graveyard = Ornithopter
Bot2.Battlefield = Forest; Llanowar Elves
Bot2.Library.Count = 10
