# Rescue Leopard: it triggers whenever it becomes tapped, not only when it attacks. On turn 2 Bot2's Icy Manipulator taps the
# untapped Leopard (CR 701.26a), and Bot1 discards the Island to draw the Plains under it.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Emerald
Rescue Leopard
Island
Plains
Swamp
Plains x13

[Bot2 Deck]
Black Lotus
Mox Ruby
Mox Jet
Icy Manipulator
Island x16

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Rescue Leopard.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Icy Manipulator.Cast
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Icy Manipulator.Activate(Bot1.Battlefield.Rescue Leopard)
Bot2.Pass
Bot1.Pass
Bot1.Choose(Island)

[Expect]
Bot1.Graveyard = Island
Bot1.Battlefield.Rescue Leopard.Tapped = true
