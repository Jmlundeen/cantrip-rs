# Daydream: "target creature you own". Bot1 takes Bot2's Ornithopter with Dack Fayden and controls it, but does not own
# it, so it is refused (CR 115.1, 108.3); nor may Bot2's other, own Ornithopter be chosen. The positive control is
# Bot1's own Ornithopter, which the same Daydream may target.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Jet
Mox Pearl
Dack Fayden
Daydream
Ornithopter
Plains x13

[Bot2 Deck]
Ornithopter
Ornithopter
Plains x18

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dack Fayden.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Dack Fayden.Activate(Bot2.Battlefield.Ornithopter; Ability: Gain control)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield = Mox Sapphire; Mox Ruby; Mox Jet; Mox Pearl; Ornithopter; Ornithopter; Dack Fayden
? Bot2.Battlefield = Ornithopter
Bot1.Battlefield.Mox Pearl.Activate
! Bot1.Hand.Daydream.Cast(Bot1.Battlefield.Ornithopter#2)
! Bot1.Hand.Daydream.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Hand.Daydream.Cast(Bot1.Battlefield.Ornithopter#1)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Graveyard = Daydream
Bot1.Battlefield.Ornithopter#2.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Ornithopter#1.Power = 0
Bot2.Battlefield = Ornithopter
