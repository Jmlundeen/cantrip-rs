Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Seasoned Cryomancer.Cast
Bot1.Choose(Seasoned Cryomancer; Island)
Bot1.Target()
? Bot1.Battlefield.Seasoned Cryomancer.Tapped = false
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
! Bot1.Battlefield.Seasoned Cryomancer.Activate
Bot1.Graveyard.Seasoned Cryomancer.Activate

