? Bot2.Life = 20
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Battlefield.Gleemox.Activate(Color: Green)
Bot2.Hand.Crucible of Worlds.Cast
Bot2.Pass
Bot1.Pass
Bot2.Graveyard.Island.Play
Bot2.Pass
Bot1.Pass

[Expect]
Bot2.Life = 20
Bot1.Life = 20
Bot2.Battlefield = Crucible of Worlds; Gleemox; Island; Mox Emerald; Mox Jet; Mox Ruby
Exile = Faithless Looting
