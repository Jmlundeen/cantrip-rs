# Demonic Consultation: with only four cards in the library, the "top six" are those four, and with the library empty
# there is nothing left to reveal: the Black Lotus among them is exiled unrevealed, not put into the hand, even though it is
# the chosen name.

[Bot1 Deck]
Swamp
Demonic Consultation
Island x5
Island
Black Lotus
Forest x2

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Demonic Consultation.Cast
Bot1.Name(Black Lotus)
[T1 Bot1.Main2]

[Expect]
Turn = 1
Bot1.Hand = Island; Island; Island; Island; Island
Exile.Count = 4
Bot1.Library.Count = 0
