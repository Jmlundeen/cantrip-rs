Bot2.Pass
[T4 Bot2.Main1]
Bot2.Battlefield.Powerstone Token.Activate
Bot2.Battlefield.Mox Jet.Activate
! Bot2.Hand.Demonic Tutor.Cast(Mana: short)

[Expect]
Turn = 4
Bot2.Battlefield.Nutrient Block.Tapped = False
Bot2.Battlefield.Powerstone Token.Tapped = True
Bot1.Battlefield.Powerstone Token = (absent)
