Island
Island
Island
Island
Island

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Hand.Sunpetal Grove.Play
? Bot1.Battlefield.Sunpetal Grove.Tapped = true
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T5 Bot1.Main1]
! Bot1.Battlefield.Sunpetal Grove.Activate(Ability: {G} or {W}; Color: Blue)
Bot1.Battlefield.Sunpetal Grove.Activate(Ability: {G} or {W}; Color: Green)
? Bot1.Mana = {G}
Bot1.Hand.Forest.Play
[T7 Bot1.Main1]
Bot1.Hand.Sunpetal Grove.Play
? Bot1.Battlefield.Sunpetal Grove#2.Tapped = false
Bot1.Battlefield.Sunpetal Grove.Activate(Ability: {G} or {W}; Color: White)
? Bot1.Mana = {W}

[Expect]
Turn = 7
