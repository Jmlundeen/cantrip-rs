# "Whenever a creature you control attacks": Bot2's two Ornithopters attack Bot1 on turn 4 with Bot1's Shared Animosity on the battlefield. The enchantment is Bot1's, so neither
# attacker gets a bonus: they stay 0/2 and Bot1 takes no damage. (The same attack under its own controller's Shared Animosity makes each a 1/2, in the original scenario.)

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Shared Animosity
Plains x16

[Bot2 Deck]
Ornithopter
Ornithopter
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Shared Animosity.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
[T4 Bot2.Main1]
Bot2.Attack(Ornithopter; Ornithopter > Bot1)
[T4 Bot2.Main2]

[Expect]
Turn = 4
Bot1.Life = 20
Bot2.Battlefield.Ornithopter#1.Power = 0
