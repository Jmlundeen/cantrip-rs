# Pongify: "Its controller creates" is the controller as the creature last existed (CR 608.2h), not its owner. Bot1 takes
# Bot2's Memnite with Control Magic, then Pongifies it: Memnite goes to Bot2's graveyard, the Ape to Bot1.

[Bot1 Deck]
Black Lotus
Black Lotus
Control Magic
Pongify
Island x16

[Bot2 Deck]
Memnite
Island x19

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Control Magic.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Power = 1
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Pongify.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Graveyard = Memnite
Bot1.Battlefield.Ape Token.Power = 3
Bot2.Battlefield.Ape Token = (absent)
