Bot1.Battlefield.Forest#2.Activate
! Bot1.Hand.Rancor.Cast(Bot2.Battlefield.Savannah Lions)
Bot1.Attack(Grizzly Bears > Bot2)
Bot2.Block(Savannah Lions > Grizzly Bears)
