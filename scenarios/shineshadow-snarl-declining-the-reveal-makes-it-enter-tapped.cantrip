# "you may reveal ... If you don't, this land enters tapped" (CR 614.1d): Bot1 declines the reveal, so Shineshadow
# Snarl enters the battlefield tapped and cannot be tapped for mana that turn.

[Bot1 Deck]
Shineshadow Snarl
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Shineshadow Snarl.Play
Bot1.Decline
? Bot1.Battlefield.Shineshadow Snarl.Tapped = true
! Bot1.Battlefield.Shineshadow Snarl.Activate(Color: White)

[Expect]
Turn = 1
Bot1.Battlefield.Shineshadow Snarl.Tapped = true
