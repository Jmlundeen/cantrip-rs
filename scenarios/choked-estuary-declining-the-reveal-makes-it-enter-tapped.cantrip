# "you may reveal ... If you don't, this land enters tapped" (CR 614.1d): Bot1 declines the reveal, so Choked Estuary enters
# the battlefield tapped and cannot be tapped for mana that turn.

[Bot1 Deck]
Choked Estuary
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Choked Estuary.Play
Bot1.Decline
? Bot1.Battlefield.Choked Estuary.Tapped = true
! Bot1.Battlefield.Choked Estuary.Activate(Color: Blue)

[Expect]
Turn = 1
Bot1.Battlefield.Choked Estuary.Tapped = true
