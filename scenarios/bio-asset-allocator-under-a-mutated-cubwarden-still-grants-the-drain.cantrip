Bot1.Pass
? Bot1.Battlefield.Cubwarden.Power = 3
? Bot1.Battlefield.Cubwarden.Types = Creature
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Cubwarden > Bot2; Ornithopter > Bot2)
[T3 Bot1.Main2]

