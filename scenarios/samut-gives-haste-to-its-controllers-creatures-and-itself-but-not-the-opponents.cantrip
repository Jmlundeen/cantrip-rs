# "Creatures you control have haste." Bot1 casts Mox Ruby/Pearl/Emerald, Samut ({1}{R}) and Llanowar Elves ({G}) on turn 1 and attacks
# with both at once: Samut himself and the Elves have haste (SummoningSick false, checked), so Bot2 takes 2 + 1. Bot2, with no Samut of
# its own, casts Llanowar Elves on turn 2. On turn 4 it casts Ornithopter and may attack with the older Elves (the control) but
# not with the Ornithopter, which is summoning sick: Samut's haste is for his controller's creatures only.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Emerald
Samut, Hazoret's Champion
Llanowar Elves
Island x15

[Bot2 Deck]
Mox Emerald
Llanowar Elves
Ornithopter
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Samut, Hazoret's Champion.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Pass
Bot1.Attack(Samut, Hazoret's Champion; Llanowar Elves > Bot2)
? Bot1.Battlefield.Llanowar Elves.SummoningSick = false
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
! Bot2.Attack(Ornithopter > Bot1)
Bot2.Attack(Llanowar Elves > Bot1)
[T4 Bot2.Main2]

[Expect]
Bot2.Life = 17
Bot1.Life = 19
Bot2.Battlefield.Ornithopter.SummoningSick = true
Bot2.Battlefield.Llanowar Elves.SummoningSick = false
