# "Return a land you control to its owner's hand" is chosen as the trigger resolves and the Turf itself is a land you
# control (CR 603.6a): played as Bot1's first land it is the only one, so it goes straight back to hand and Bot1 has
# played a land this turn all the same. The land drop was spent: a Forest cannot be played too.

[Bot1 Deck]
Gruul Turf
Forest
Forest x5
Forest x10

[Bot2 Deck]
Mountain x15

[Actions]
Bot1.Hand.Gruul Turf.Play
[T1 Bot1.Main2]
! Bot1.Hand.Forest.Play

[Expect]
Bot1.Battlefield.Count = 0
Bot1.Hand.Count = 7
Bot1.LandsPlayed = 1
