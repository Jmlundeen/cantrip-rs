# "If {B}{B} was spent to cast it": Deceit paid with Mox Jet x2, Mox Ruby x2, Mox Emerald and Mox Pearl has spent two black mana and no blue, so
# only the second enters ability happens (CR 603.4): Bot2 reveals its hand (Lightning Bolt and four Forests) and Bot1 chooses a nonland
# card from it; a Forest is not offered (`! Bot1.Choose(Forest)`), the positive control being the Lightning Bolt chosen on the next line.
# The first ability's {U}{U} was not spent, so Bot2's Llanowar Elves is not returned to its hand.

[Bot1 Deck]
Mox Jet
Mox Jet
Mox Ruby
Mox Ruby
Mox Emerald
Mox Pearl
Deceit
Island x12

[Bot2 Deck]
Forest
Llanowar Elves
Lightning Bolt
Forest x4
Forest x12

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Deceit.Cast
Bot1.Pass
! Bot1.Choose(Forest)
Bot1.Choose(Lightning Bolt)
Bot1.Pass

[Expect]
Stack.Count = 0
Bot1.Battlefield.Deceit.Power = 5
Bot2.Graveyard = Lightning Bolt
Bot2.Battlefield = Forest; Llanowar Elves
Bot2.Hand.Count = 5
