# Darksteel Plate's own "Indestructible" (CR 702.12b): Bot2's Shatter destroys target artifact, and the Plate is the only
# artifact it can target, but destruction does nothing to an indestructible permanent - the Plate stays on the battlefield.
# Its {3} is paid exactly by three moxes, so the pool is empty right after the cast.

[Bot1 Deck]
Darksteel Plate
Mox Jet
Mox Sapphire
Mox Pearl
Ornithopter
Island x16

[Bot2 Deck]
Mountain
Mox Ruby
Shatter
Island x17

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Darksteel Plate.Cast
? Bot1.Mana =
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Darksteel Plate)
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Darksteel Plate.Activate(Ability: Equip; Ornithopter)
? Bot1.Mana =
Bot1.Pass

[Expect]
Turn = 3
Bot1.Battlefield.Count = 5
Bot2.Graveyard = Shatter
Bot1.Graveyard.Count = 0
