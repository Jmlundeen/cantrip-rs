Bot1.Pass
Bot2.Pass
[T2 Bot2.Main2]
? Bot1.Battlefield.Elvish Mystic.Keywords = Hexproof; Indestructible
? Bot1.Battlefield.Elvish Mystic.Power = 1

[Expect]
Bot1.Graveyard = Celestial Armor
Bot1.Battlefield = Elvish Mystic; Mox Emerald; Mox Jet; Mox Pearl; Mox Ruby
