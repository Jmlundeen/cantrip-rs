# Blossombind: "Enchanted creature can't become untapped" (CR 101.2, 701.26b) stops every untap, not only the untap step's (CR 502.3,
# which is "doesn't untap"). Bot1 enchants Bot2's Ornithopter, the trigger taps it, then Glamermite's "Untap target creature" mode
# targets it: the Ornithopter stays tapped.

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Mox Pearl
Mox Ruby
Blossombind
Glamermite
Island x13

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Blossombind.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Glamermite.Cast
Bot1.Pass
Bot2.Pass
Bot1.Modes(Untap target creature)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = true
Bot1.Battlefield.Blossombind.AttachedTo = Ornithopter
Bot1.Battlefield.Glamermite.Tapped = false
