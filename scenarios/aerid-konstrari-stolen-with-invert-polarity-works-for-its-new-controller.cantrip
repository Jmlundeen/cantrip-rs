Bot2.Pass
? Bot1.Battlefield.Aerid Konstrari.Power = 11
? Bot1.Battlefield = Island; Mountain; Mox Sapphire; Mox Ruby; Mox Jet; Mox Pearl; Aerid Konstrari; Heartwood Token; Heartwood Token
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Aerid Konstrari)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Aerid Konstrari)
[T4 Bot2.Main2]
? Bot2.Graveyard = Aerid Konstrari; Lightning Bolt; Lightning Bolt

[Expect]
Bot1.Battlefield = Island; Mountain; Mox Sapphire; Mox Ruby; Mox Jet; Mox Pearl; Heartwood Token; Heartwood Token; Heartwood Token
Bot2.Battlefield = Forest; Mountain; Mox Ruby; Mox Emerald; Mox Emerald
Bot2.Graveyard = Aerid Konstrari; Lightning Bolt; Lightning Bolt
