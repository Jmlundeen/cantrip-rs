Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Shatterskull Smashing.Cast(X: 4)
Bot1.Divide(Bot2.Battlefield.Ornithopter: 2; Bot2.Battlefield.Giver of Runes: 2)
Bot2.Battlefield.Giver of Runes.Activate(Ornithopter)
Bot2.Decline
Bot2.Colors(Red)
Bot1.Pass
[T5 Bot1.Main2]

[Expect]
Bot2.Graveyard = Giver of Runes
Bot2.Battlefield.Ornithopter.Damage = 0
Bot1.Battlefield.Count = 5
