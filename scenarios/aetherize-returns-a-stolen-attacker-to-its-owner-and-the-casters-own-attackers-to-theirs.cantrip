# "Return all attacking creatures to their owner's hand.": it is no more a spell of the opponent's creatures than of the
# caster's own. On turn 2 Bot2's kicked Thieving Skydiver (X = 1) takes Bot1's Ornithopter (mana value 0); on turn 4 Bot2
# attacks with the stolen Ornithopter, its own Ornithopter and the Skydiver and then casts Aetherize. All three go back to
# hand - the stolen Ornithopter to its OWNER's hand (Bot1's, not the controller's), the other two to Bot2's. Bot1's second
# Ornithopter, which is not attacking, stays on the battlefield.

[Bot1 Deck]
Ornithopter
Ornithopter
Island x25

[Bot2 Deck]
Island
Mox Sapphire
Mox Jet
Mox Ruby
Thieving Skydiver
Ornithopter
Aetherize
Island x20

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Thieving Skydiver.Cast(Kicked: 1)
Bot2.Pass
Bot1.Pass
Bot2.Target(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Ornithopter#2.Types = Artifact; Creature
[T4 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Attack(Ornithopter; Ornithopter#2; Thieving Skydiver > Bot1)
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Island#2.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Aetherize.Cast
Bot2.Pass
Bot1.Pass
[Bot2.Main2]

[Expect]
Bot1.Hand = Ornithopter; Island; Island; Island; Island; Island; Island
Bot1.Battlefield = Ornithopter
Bot2.Hand = Ornithopter; Thieving Skydiver; Island
Bot2.Battlefield = Island; Island; Mox Sapphire; Mox Jet; Mox Ruby
Bot2.Graveyard = Aetherize
Bot1.Life = 20
