Bot1.Graveyard = Corpse Dance; Counterspell; Llanowar Elves; Lightning Bolt
Bot1.Battlefield = Satyr Wayfinder; Forest; Forest; Swamp; Guerrilla Gorilla
Bot2.Life = 18
