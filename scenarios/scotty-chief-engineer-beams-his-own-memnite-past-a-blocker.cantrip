Bot1.Battlefield.Scotty, Chief Engineer.Activate(Memnite; Tap: Mox Sapphire)
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
! Bot2.Block(Ornithopter > Memnite)
Bot2.Pass
[T3 Bot1.Main2]
[T5 Bot1.DeclareAttackers]
Bot1.Attack(Memnite > Bot2)
Bot2.Block(Ornithopter > Memnite)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 19
