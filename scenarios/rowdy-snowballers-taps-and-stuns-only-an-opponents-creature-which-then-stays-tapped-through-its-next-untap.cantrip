[T4 Bot2.Main1]
? Bot2.Battlefield.Memnite.Tapped = true
? Bot2.Battlefield.Memnite.Counters.Stun = (absent)

[Expect]
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Battlefield.Ornithopter.Counters.Stun = (absent)
Bot2.Battlefield.Mox Jet.Counters.Stun = (absent)
Bot2.Battlefield.Phyrexian Walker.Tapped = false
Bot2.Battlefield.Phyrexian Walker.Counters.Stun = (absent)
