# Clifftop Retreat: "This land enters tapped unless you control a Mountain or a Plains." (CR 614.12, 614.1d: read on
# the battlefield as it enters, so the land itself is never one of the two). Beside a Swamp only the first copy enters
# tapped (turn 3); once a Mountain is out the second enters untapped (turn 7), the positive control for the first. It also
# taps for {R} or {W}: blue is refused beside the red it does add, and the {R} activation is that positive control; the first copy then
# taps for {W} on turn 7, the other half of the choice. Bot2's Mountain and Plains do not count: not "you control".

[Bot1 Deck]
Swamp
Clifftop Retreat
Mountain
Clifftop Retreat
Swamp x10

[Bot2 Deck]
Mountain
Plains
Island x14

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Clifftop Retreat.Play
? Bot1.Battlefield.Clifftop Retreat.Tapped = true
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T5 Bot1.Main1]
! Bot1.Battlefield.Clifftop Retreat.Activate(Ability: {R} or {W}; Color: Blue)
Bot1.Battlefield.Clifftop Retreat.Activate(Ability: {R} or {W}; Color: Red)
? Bot1.Mana = {R}
Bot1.Hand.Mountain.Play
[T7 Bot1.Main1]
Bot1.Hand.Clifftop Retreat.Play
? Bot1.Battlefield.Clifftop Retreat#2.Tapped = false
Bot1.Battlefield.Clifftop Retreat.Activate(Ability: {R} or {W}; Color: White)
? Bot1.Mana = {W}

[Expect]
Turn = 7
Bot1.Battlefield.Clifftop Retreat#2.Tapped = false
Bot1.Battlefield.Clifftop Retreat#2.Subtypes = (absent)
