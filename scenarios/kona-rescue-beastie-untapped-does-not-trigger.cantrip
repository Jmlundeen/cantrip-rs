# Kona, Rescue Beastie: the "if Kona is tapped" of Survival (CR 603.4, and the ruling: an untapped creature at the beginning
# of the second main phase doesn't trigger, and tapping it then is too late). Kona does not attack on turn 3, so it is untapped
# at the second main phase and Bot1 is asked nothing (the refusal) and the Forest stays in hand. The control is the scenario
# where Kona attacks first.

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Pearl
Mox Ruby
Kona, Rescue Beastie
Forest
Lightning Bolt
Sol Ring
Island x20

[Bot2 Deck]
Swamp x14

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Kona, Rescue Beastie.Cast
Bot2.Pass
[T3 Bot1.Main2]
! Bot1.Choose
Bot1.Battlefield.Mox Ruby.Activate
[T3 Bot1.End]

[Expect]
Bot1.Hand = Forest; Lightning Bolt; Sol Ring
Bot1.Battlefield.Kona, Rescue Beastie.Tapped = false
Bot2.Life = 20
