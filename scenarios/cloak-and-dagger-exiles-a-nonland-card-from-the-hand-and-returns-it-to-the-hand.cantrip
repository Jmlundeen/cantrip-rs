Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Cloak and Dagger, Entwined.Cast
Bot1.Target(Bot2)
Bot1.Choose(Lightning Bolt)
? Exile = Lightning Bolt
? Bot2.Hand.Count = 6
