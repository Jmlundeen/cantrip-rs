# "Return it to the battlefield ... under its owner's control": Bot1 gives its Slasher to Bot2 with Harmless Offering on turn 3, and
# Bot2 kills it (Dismember on turn 4). It dies under Bot2's control, but returns under its owner Bot1's (CR 108.3, 110.2a), tapped
# with two stun counters, and Bot1 - not Bot2 - controls it.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Unstoppable Slasher
Harmless Offering
Swamp
10 Swamp

[Bot2 Deck]
Swamp
Mox Jet
Mox Ruby
Dismember
Swamp
Swamp
Swamp
10 Swamp

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Unstoppable Slasher.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Harmless Offering.Cast
Bot1.Target(Bot2)
Bot1.Target(Unstoppable Slasher)
[T3 Bot1.Main2]
? Bot2.Battlefield.Unstoppable Slasher.Counters.Stun = (absent)
[T4 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Dismember.Cast(Unstoppable Slasher)
Bot2.Modes()
[T4 Bot2.Main2]

[Expect]
Bot1.Battlefield.Unstoppable Slasher.Tapped = true
Bot1.Battlefield.Unstoppable Slasher.Counters.Stun = 2
Bot2.Battlefield.Count = 3
Bot1.Graveyard = Harmless Offering
