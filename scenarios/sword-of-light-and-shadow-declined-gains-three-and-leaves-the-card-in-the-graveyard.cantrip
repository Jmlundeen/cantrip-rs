[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Sword of Light and Shadow.Cast
? Bot1.Mana =
Bot1.Hand.Memnite.Cast
Bot1.Hand.Memnite.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Memnite#1)
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Sword of Light and Shadow.Activate(Ornithopter)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Grizzly Bears.Cast
Bot2.Pass
Bot1.Pass
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Memnite > Bot1)
Bot1.Block(Ornithopter > Memnite)
Bot2.Pass
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2; Memnite > Bot2)
Bot2.Block(Grizzly Bears > Memnite)
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot1.Graveyard.Memnite#1; Bot1.Graveyard.Memnite#2)
! Bot1.Target(Bot2.Battlefield.Grizzly Bears)
! Bot1.Target(Bot1.Battlefield.Ornithopter)
! Bot1.Target(Bot2.Graveyard.Memnite)
Bot1.Target(Bot1.Graveyard.Memnite#2)
Bot1.Pass
Bot2.Pass
Bot1.Decline
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Life = 23
Bot1.Battlefield.Sword of Light and Shadow.AttachedTo = Ornithopter
Bot1.Battlefield.Ornithopter.Power = 2
Bot1.Battlefield.Ornithopter.Toughness = 4
Bot1.Hand = Island; Island
Bot1.Graveyard = Memnite; Memnite
Bot2.Battlefield.Grizzly Bears.Damage = 1
Bot2.Hand.Count = 3
Bot2.Graveyard = Memnite; Lightning Bolt
