Bot1.Battlefield.Omnivorous Flytrap.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Omnivorous Flytrap.Power = 3
Bot2.Battlefield.Llanowar Elves.Counters.PlusOnePlusOne = 1
