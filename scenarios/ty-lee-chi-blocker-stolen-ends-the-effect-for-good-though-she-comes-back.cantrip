Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Ty Lee, Chi Blocker.Cast
Bot1.Pass
Bot2.Pass
Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Memnite.Tapped = true
[T4 Bot2.Main1]
? Bot2.Battlefield.Memnite.Tapped = true
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Act of Treason.Cast(Bot1.Battlefield.Ty Lee, Chi Blocker)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Ty Lee, Chi Blocker.Tapped = false
[T5 Bot1.Main1]
? Bot1.Battlefield.Ty Lee, Chi Blocker.Tapped = false
? Bot2.Battlefield.Memnite.Tapped = true
[T6 Bot2.Main1]
? Bot2.Battlefield.Memnite.Tapped = false

[Expect]
Bot2.Battlefield.Memnite.Tapped = false
