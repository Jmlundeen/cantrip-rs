# Sulfurous Springs prints two mana abilities (CR 605.1a): "{T}: Add {C}." costs nothing, while "{T}: Add {B} or {R}. This
# land deals 1 damage to you." deals the damage as it resolves (a mana ability, CR 605.4a) and names its color as it is
# activated (CR 106.5). Bot1 taps it for {C} on turn 3 and stays at 20, for {B} on turn 5 and for {R} on turn 7, one damage
# each. The colored ability refuses white beside the red it does add (the {R} activation is the positive control), and the
# colorless ability takes no color at all.

[Bot1 Deck]
Sulfurous Springs
Swamp x15

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Sulfurous Springs.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Sulfurous Springs.Activate(Ability: {B} or {R}; Color: White)
! Bot1.Battlefield.Sulfurous Springs.Activate(Ability: {C}; Color: Black)
Bot1.Battlefield.Sulfurous Springs.Activate(Ability: {C})
? Bot1.Mana = {C}
? Bot1.Life = 20
[T5 Bot1.Main1]
Bot1.Battlefield.Sulfurous Springs.Activate(Ability: {B} or {R}; Color: Black)
? Bot1.Mana = {B}
? Bot1.Life = 19
[T7 Bot1.Main1]
Bot1.Battlefield.Sulfurous Springs.Activate(Ability: {B} or {R}; Color: Red)
? Bot1.Mana = {R}
? Bot1.Life = 18

[Expect]
Turn = 7
Bot1.Battlefield.Sulfurous Springs.Tapped = true
Bot1.Life = 18
