# Ursine Monstrosity's "attacks that player this combat if able" is a requirement to attack that player and nothing more
# (CR 508.1d; the 2024-09-20 ruling): it chooses Bot2, whose Propaganda makes attacking Bot2 cost {2}, so it need not attack
# Bot2, and it is not required to attack anything else - not Bot2's Liliana of the Veil, which it could attack for free.
# Declaring no attackers is legal; Liliana keeps her loyalty and Bot2 stays at 20.

[Bot1 Deck]
Black Lotus
Ursine Monstrosity
Mox Ruby
Mox Sapphire
Forest
Forest
Forest
Forest x10

[Bot2 Deck]
Island
Black Lotus
Propaganda
Mox Sapphire
Mox Jet
Liliana of the Veil
Island
Island x10

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Ursine Monstrosity.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Propaganda.Cast
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Black)
Bot2.Hand.Liliana of the Veil.Cast
[T3 Bot1.Main1]
Bot1.Attack()
? Combat.Attackers =
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Battlefield.Liliana of the Veil.Counters.Loyalty = 3
Bot1.Battlefield.Ursine Monstrosity.Tapped = false
Bot1.Battlefield.Mox Ruby.Tapped = false
