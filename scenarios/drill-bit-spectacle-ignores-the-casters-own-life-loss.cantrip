# Spectacle needs "an opponent lost life this turn" (CR 702.137a): Bot1 paying 1 life to its own Bloodstained Mire does not
# count, so the spectacle cost is refused; after Lightning Bolt hits Bot2 in the same turn it is offered and taken (the
# control), and Bot2's Counterspell is the card chosen.

[Bot1 Deck]
Bloodstained Mire
Mox Jet
Mox Ruby
Lightning Bolt
Drill Bit
Swamp x2
Mountain
Swamp x10

[Bot2 Deck]
Counterspell
Island x6
Island x10

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Bloodstained Mire.Play
Bot1.Battlefield.Bloodstained Mire.Activate
Bot1.Search(Mountain)
? Bot1.Life = 19
! Bot1.Hand.Drill Bit.Cast(Bot2; Ability: Spectacle)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
? Bot2.Life = 17
Bot1.Hand.Drill Bit.Cast(Bot2; Ability: Spectacle)
Bot1.Choose(Counterspell)

[Expect]
Bot2.Graveyard = Counterspell
Bot2.Life = 17
