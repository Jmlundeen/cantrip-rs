# Toxic gives poison counters only as a result of combat damage dealt (CR 702.164c, 120.3g): damage prevented is never
# dealt (CR 615.1), so it gives none (the ruling). Bot1's Phyrexian Mite from Mirrex attacks on turn 3 and Bot2 casts Fog:
# Bot2 keeps 20 life and gets no poison counter.

[Bot1 Deck]
Mirrex
Mox Pearl
Mox Jet
Mox Ruby
Island x16

[Bot2 Deck]
Forest
Fog
Island x18

[Actions]
Bot1.Hand.Mirrex.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mirrex.Activate(Ability: Create)
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Attack(Phyrexian Mite Token > Bot2)
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Fog.Cast
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Poison = 0
Prevented = 1 Phyrexian Mite Token > Bot2 by Fog
