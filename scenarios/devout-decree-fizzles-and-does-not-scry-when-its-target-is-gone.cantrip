# Devout Decree's only target is gone when it resolves (Bot2 Bolts its own Dark Confidant in response), so the spell does
# not resolve (CR 608.2b): nothing is exiled and the "Scry 1" never happens (`! Bot1.Arrange`, and the library is untouched).

[Bot1 Deck]
Plains
Plains
Devout Decree
Plains x4
Plains
Lightning Bolt
Black Lotus
Plains x4

[Bot2 Deck]
Mox Jet
Mox Ruby
Mox Ruby
Dark Confidant
Lightning Bolt
Island x12

[Actions]
Bot1.Hand.Plains.Play
[T2 Bot2.Main1]
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby#1.Activate
Bot2.Hand.Dark Confidant.Cast
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Devout Decree.Cast(Bot2.Battlefield.Dark Confidant)
Bot1.Pass
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Dark Confidant)
Bot2.Pass
! Bot1.Arrange

[Expect]
Stack.Count = 0
Bot1.Graveyard = Devout Decree
Bot2.Graveyard = Dark Confidant; Lightning Bolt
Exile.Count = 0
Bot1.Library = Lightning Bolt; Black Lotus; Plains; Plains; Plains; Plains
