# A board about how the client draws one, handed over with Lightning Bolt on the stack and Bot1 still holding
# priority. Three things are being looked at at once:
#
#   the Equipment attached to the Goblin, which belongs under the creature it is doing something to and not in a
#   row of artifacts across the board from it;
#
#   three lands of three names, all tapped, all spent, and nothing being asked about any of them, which is one fact
#   about the turn and not three cards to read;
#
#   and a spell on top of the stack aimed at a player, which the dock has to name while the button under it says
#   Resolve.

[Bot1 Deck]
Mountain
Goblin Welder
Volcanic Island
Cori-Steel Cutter
Tropical Island
Lightning Bolt
Mountain x12

[Bot2 Deck]
Island x18

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goblin Welder.Cast
[T3 Bot1.Main1]
Bot1.Hand.Volcanic Island.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Volcanic Island.Activate(Ability: Add {R})
Bot1.Hand.Cori-Steel Cutter.Cast
[T5 Bot1.Main1]
Bot1.Hand.Tropical Island.Play
Bot1.Battlefield.Tropical Island.Activate(Ability: Add {U})
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Cori-Steel Cutter.Activate(Goblin Welder)
# Equip is an activated ability and uses the stack (CR 702.6b): let it resolve before the Bolt goes on top of it.
Bot1.Pass
Bot1.Battlefield.Volcanic Island.Activate(Ability: Add {R})
Bot1.Hand.Lightning Bolt.Cast(Bot2)
[Handover Bot1.Pass]

[Expect]
Turn = 5
Step = Main1
ActivePlayer = Bot1
PriorityPlayer = Bot1
# The Bolt is still on the stack: the handover is the priority that would let it resolve.
Stack = Lightning Bolt
Bot2.Life = 20
# The Equipment is on the Goblin, which is what puts it under the Goblin on the board.
Bot1.Battlefield.Cori-Steel Cutter.AttachedTo = Goblin Welder
Bot1.Battlefield.Goblin Welder.Power = 2
Bot1.Battlefield.Goblin Welder.Toughness = 2
# Three lands, three names, every one of them spent.
Bot1.Battlefield.Mountain.Tapped = true
Bot1.Battlefield.Volcanic Island.Tapped = true
Bot1.Battlefield.Tropical Island.Tapped = true
Bot1.Mana =
