# "Fights up to one other target creature": with Bot2's Ornithopter available Bot1 chooses no target, so no fight happens - the
# Ornithopter takes no damage and Wolverine is undamaged. (Haste lets him attack at once, unrelated.)

[Bot1 Deck]
Mox Ruby
Mox Emerald
Mox Jet
Mox Pearl
Wolverine, Fierce Fighter
Island x15

[Bot2 Deck]
Ornithopter
Island x14

[Actions]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Wolverine, Fierce Fighter.Cast
Bot1.Target()
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Damage = 0
Bot1.Battlefield.Wolverine, Fierce Fighter.Damage = 0
