# "Tap up to one target creature": with no creature chosen the spell is still cast, and the damage happens - Bot2 takes 3
# - while Bot2's Llanowar Elves stays untapped. A spell that targets a player and one creature of one's own is refused
# neither: only the second target is optional.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Vibrant Outburst
Island x14

[Bot2 Deck]
Forest
Llanowar Elves
Island x14

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Vibrant Outburst.Cast
Bot1.Target(Bot2)
Bot1.Target()
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot2.Battlefield.Llanowar Elves.Tapped = false
