# Path to Exile exiles Bot2's Guerrilla Gorilla, and Bot2 (the Gorilla's controller, not the caster) is asked whether to search.
# Bot2 accepts and takes a Swamp, which enters tapped. Bot1 waits for its third turn so the Gorilla is on the battlefield.

[Bot1 Deck]
Plains
Path to Exile
Plains x15

[Bot2 Deck]
Forest
Guerrilla Gorilla
Forest
Swamp x14

[Actions]
Bot1.Hand.Plains.Play
Bot2.Hand.Forest.Play
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Guerrilla Gorilla.Cast
Bot2.Battlefield.Forest#1.Activate
Bot2.Battlefield.Forest#2.Activate
[T5 Bot1.Main1]
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Path to Exile.Cast(Bot2.Battlefield.Guerrilla Gorilla)
Bot2.Accept
Bot2.Search(Swamp)

[Expect]
Turn = 5
Exile = Guerrilla Gorilla
Bot1.Graveyard = Path to Exile
Bot2.Battlefield = Forest; Forest; Swamp
Bot2.Battlefield.Swamp.Tapped = true
