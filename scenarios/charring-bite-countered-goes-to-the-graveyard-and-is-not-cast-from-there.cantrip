Bot1.Hand.Llanowar Elves.Cast
Bot1.Battlefield.Forest.Activate
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Twinmaw Stormbrood.Cast(Bot1.Battlefield.Llanowar Elves; Ability: Omen)
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot2.Hand.Counterspell.Cast(Stack.Charring Bite)
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
[T3 Bot1.Main2]
? Bot1.Graveyard = Twinmaw Stormbrood
? Bot1.Library.Count = 7
? Bot1.Battlefield.Llanowar Elves.Power = 1
[T5 Bot1.Main1]
Bot1.Hand.Mountain.Play
! Bot1.Graveyard.Twinmaw Stormbrood.Cast
Bot1.Hand.Twinmaw Stormbrood.Cast(Bot1.Battlefield.Llanowar Elves; Ability: Omen)
Bot1.Battlefield.Mountain#1.Activate
Bot1.Battlefield.Mountain#2.Activate
[T5 Bot1.Main2]

