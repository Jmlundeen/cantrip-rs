# Cryptic Command still chooses exactly two modes when Helm of Awakening changes its total cost
# (CR 601.2b, 601.2f, 700.2d). The Helm removes only the generic mana, so Black Lotus pays exactly
# {U}{U}{U}; the counter and draw modes both resolve. This exercises mode enumeration for a changed cost.

[Bot1 Deck]
Mox Pearl
Sol Ring
Helm of Awakening
Black Lotus
Cryptic Command
Island x15

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Helm of Awakening.Cast
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Cryptic Command.Cast
! Bot1.Modes(1)
! Bot1.Modes(1; 3; 4)
! Bot1.Modes(1; 1)
Bot1.Modes(1; 4)
Bot1.Target(Stack.Ornithopter)
? Bot1.Mana =
Bot1.Pass
[T2 Bot2.Main2]

[Expect]
Bot1.Battlefield.Count = 3
Bot1.Graveyard = Cryptic Command; Black Lotus
Bot1.Hand.Count = 3
Bot2.Battlefield.Count = 0
Bot2.Graveyard = Ornithopter
Stack.Count = 0
