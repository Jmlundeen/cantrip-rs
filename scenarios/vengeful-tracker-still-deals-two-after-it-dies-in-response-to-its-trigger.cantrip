# Bot2 sacrifices its Black Lotus and, with the Lotus's red mana still in its pool, kills Vengeful Tracker with Lightning Bolt
# while the trigger is on the stack. The ability still resolves: the damage is dealt by the creature as it last existed
# (CR 608.2h, 113.7a), so Bot2 loses 2 life and ends on 18.

[Bot1 Deck]
Mox Ruby
Mox Jet
Vengeful Tracker
Island x17

[Bot2 Deck]
Black Lotus
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Vengeful Tracker.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Vengeful Tracker)
[T2 Bot2.Main2]

[Expect]
Stack.Count = 0
Bot2.Life = 18
Bot1.Graveyard = Vengeful Tracker
Bot2.Graveyard = Lightning Bolt; Black Lotus
