Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Callous Inspector.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Hand.Sudden Substitution.Cast
Bot2.Target(Stack.Lightning Bolt)
Bot2.Target(Bot1.Battlefield.Callous Inspector)
Bot1.Target(Bot2.Battlefield.Callous Inspector)
[T2 Bot2.Main2]

[Expect]
Bot1.Life = 20
Bot2.Life = 19
Bot1.Graveyard = Callous Inspector
Bot1.Battlefield = Swamp
Bot2.Battlefield = Island; Mox Sapphire; Mox Ruby; Mox Pearl; Mox Jet; Clue Token
