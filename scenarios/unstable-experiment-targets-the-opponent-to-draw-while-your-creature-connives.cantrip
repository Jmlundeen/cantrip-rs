[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
? Bot2.Hand.Count = 6
Bot1.Hand.Unstable Experiment.Cast
Bot1.Target(Bot2)
Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Choose(Island)
[Bot1.Main2]

