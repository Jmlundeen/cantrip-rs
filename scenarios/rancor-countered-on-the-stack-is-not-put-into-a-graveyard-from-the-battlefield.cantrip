# Bot2 counters Bot1's Rancor with a Counterspell on turn 5: it goes to the graveyard from the stack, not from the battlefield, so its
# return ability never triggers and it stays in the graveyard.

[Bot1 Deck]
Forest
Forest
Llanowar Elves
Rancor
Forest x3
Forest x13

[Bot2 Deck]
Island
Island
Counterspell
Island x17

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
[T4 Bot2.Main1]
Bot2.Hand.Island.Play
[T5 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest#1.Activate
Bot1.Hand.Rancor.Cast(Llanowar Elves)
Bot2.Battlefield.Island#1.Activate
Bot2.Battlefield.Island#2.Activate
Bot2.Hand.Counterspell.Cast(Stack.Rancor)
[T5 Bot1.Main2]

[Expect]
Bot1.Graveyard = Rancor
Bot1.Hand.Count = 4
Bot2.Graveyard = Counterspell
