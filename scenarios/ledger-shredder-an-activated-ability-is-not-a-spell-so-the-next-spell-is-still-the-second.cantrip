# Ledger Shredder, played for real. "Casts their second spell" counts spells, not activated abilities. Turn 5 Bot1
# casts a Pyrite Spellbomb, activates its "{1}, Sacrifice: Draw a card", then casts a second Spellbomb: the ability
# was not a spell, so the second Spellbomb is the second spell and the Shredder connives once.

[Bot1 Deck]
Island
Ledger Shredder
Island
Pyrite Spellbomb
Pyrite Spellbomb
Island
Island
Island
Island
Island
Pyrite Spellbomb
Island x10

[Bot2 Deck]
Island x18

[Actions]
Bot1.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Ledger Shredder.Cast
[T5 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Pyrite Spellbomb.Cast
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Pyrite Spellbomb.Activate(Ability: Draw)
? Bot1.Battlefield.Ledger Shredder.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield.Island#3.Activate
Bot1.Hand.Pyrite Spellbomb.Cast
Bot1.Choose(Pyrite Spellbomb)
[T5 Bot1.Main2]

[Expect]
Turn = 5
Bot1.Battlefield.Ledger Shredder.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Count = 5
Bot1.Graveyard.Count = 2
Bot1.Hand.Count = 4
Stack.Count = 0
