# Koloth, Tribble Hunter's "All Tribbles ... are goaded" is a static ability (CR 701.15a-b), so it does nothing while Koloth
# has lost its abilities (CR 613.1f, 611.3a). Bot1's Koloth makes each player two Tribbles at Bot1's end step, all goaded by
# Bot1; on turn 4 Bot2 casts Turn to Frog on Koloth, and until end of turn no Tribble is goaded: Bot2's Tribbles may stay
# home, and Bot1 keeps its 20 life.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Koloth, Tribble Hunter
Mountain x2
Mountain x12

[Bot2 Deck]
Black Lotus
Turn to Frog
Forest x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Koloth, Tribble Hunter.Cast
? Bot1.Mana =
[T4 Bot2.Main1]
? Bot2.Battlefield.Tribble Token#1.GoadedBy = Bot1
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Turn to Frog.Cast(Bot1.Battlefield.Koloth, Tribble Hunter)
Bot2.Pass
Bot1.Pass
? Bot2.Battlefield.Tribble Token#1.GoadedBy = (absent)
? Bot2.Battlefield.Tribble Token#2.GoadedBy = (absent)
[T4 Bot2.Main2]

[Expect]
Turn = 4
Bot1.Life = 20
Bot2.Battlefield.Tribble Token#1.Tapped = false
Bot2.Battlefield.Tribble Token#2.Tapped = false
