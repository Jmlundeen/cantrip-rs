# "Gains flashback until end of turn" (CR 611.2c, 514.2): Bot1 bolts Bot2, casts Stingcaster Mage and gives the Bolt in the
# graveyard flashback, but does not cast it. By turn 3 the grant has ended: the Bolt is not offered from the graveyard
# though a Mountain is untapped for it. (The positive control, the Bolt cast again on the turn it is granted, is the
# scenario where Stingcaster Mage gives a Bolt flashback and attacks.)

[Bot1 Deck]
Mox Ruby
Black Lotus
Lightning Bolt
Stingcaster Mage
Mountain
Mountain
Forest x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Stingcaster Mage.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
! Bot1.Graveyard.Lightning Bolt.Cast

[Expect]
Bot2.Life = 17
Exile.Count = 0
Bot1.Graveyard = Black Lotus; Lightning Bolt
