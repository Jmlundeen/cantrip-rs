# Fireglass Mentor: only an OPPONENT's life loss counts. Bot1 casts Dismember paying 2 life for each {B/P} (20 -> 16) to
# kill Bot2's Llanowar Elves, and Bot2 loses none: in Bot1's second main phase the Mentor does not trigger, so nothing is
# exiled and the library is untouched. The scenario where Bot2 pays the life is the positive control.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Fireglass Mentor
Dismember
Island x2
Island
Mountain
Island x12

[Bot2 Deck]
Forest
Llanowar Elves
Island x18

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Fireglass Mentor.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Forest.Activate
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Dismember.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Modes(1; 2)
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 16
Bot2.Life = 20
Bot2.Graveyard = Llanowar Elves
Exile.Count = 0
Bot1.Library.Count = 13
