Bot1.Battlefield.Mox Pearl.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Mox Pearl.Types = Artifact
? Bot1.Battlefield.Plains.Types = Land
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Enchanted Evening.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Bot1.Battlefield = Opalescence; Enchanted Evening
Bot1.Battlefield.Enchanted Evening.Types = Enchantment; Creature
Bot1.Battlefield.Enchanted Evening.Power = 5
Bot1.Battlefield.Enchanted Evening.Toughness = 5
Bot1.Battlefield.Opalescence.Types = Enchantment
Bot1.Graveyard.Count = 6
Bot2.Battlefield.Count = 0
Bot2.Graveyard = Island
