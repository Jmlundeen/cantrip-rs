# Bebop & Rocksteady attacks with cards in hand, and its controller declines to discard: they sacrifice a permanent of
# their choice instead, Mox Ruby, and keep every card in hand. The attacker still connects for 7.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Emerald
Bebop & Rocksteady
Island
Forest
Island
Island x13

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Bebop & Rocksteady.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Bebop & Rocksteady > Bot2)
Bot1.Decline
Bot1.Choose(Mox Ruby)
[T3 Bot1.Main2]

[Expect]
Bot1.Graveyard = Mox Ruby
Bot1.Battlefield = Mox Jet; Mox Emerald; Bebop & Rocksteady
Bot1.Hand.Count = 4
Bot2.Life = 13
