Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Adaptive Omnitool.Cast
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Plains#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Adaptive Omnitool.Activate(Ornithopter)
Bot1.Attack(Ornithopter > Bot2)
Bot1.Arrange( | Sol Ring; Island; Island; Island; Island; Island)
[T3 Bot1.Main2]
? Bot1.Library.Count = 22
[T5 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2)
! Bot1.Arrange(Island | Island; Island; Island; Island; Island)
Bot1.Arrange( | Island; Island; Island; Island; Island; Island)
