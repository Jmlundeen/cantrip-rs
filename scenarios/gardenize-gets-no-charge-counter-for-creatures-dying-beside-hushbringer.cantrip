Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Gardenize.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Hushbringer.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Pyroclasm.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Battlefield = Mox Emerald; Mox Pearl; Mox Ruby; Gardenize
Bot1.Battlefield.Gardenize.Counters.Charge = (absent)
Bot1.Graveyard = Hushbringer; Ornithopter; Pyroclasm; Black Lotus
