# Wail of War ({2}{B}), first mode: "Creatures target opponent controls get -1/-1 until end of turn." Bot1 targets Bot2: Bot2's
# Memnite (1/1) dies and its Ornithopter (0/2) becomes -1/1 and survives, while Bot1's own Memnite is untouched (CR 611.2c).
# The shrink ends at the cleanup step (CR 514.2): the Ornithopter is 0/2 again on turn 4.

[Bot1 Deck]
Memnite
Mox Jet
Mox Pearl
Mox Ruby
Wail of War
Swamp x20

[Bot2 Deck]
Memnite
Ornithopter
Island x20

[Actions]
Bot1.Hand.Memnite.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Wail of War.Cast
Bot1.Modes(1)
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Power = -1
? Bot2.Battlefield.Ornithopter.Toughness = 1
? Bot2.Graveyard = Memnite
? Bot1.Battlefield.Memnite.Power = 1
[T4 Bot2.Main1]

[Expect]
Bot2.Battlefield.Ornithopter.Power = 0
Bot2.Battlefield.Ornithopter.Toughness = 2
Bot1.Battlefield.Memnite.Power = 1
Bot1.Graveyard = Wail of War
