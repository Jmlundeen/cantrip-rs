Bot2.Hand.Lightning Bolt.Cast(Bot1)
! Bot1.Arrange
[T5 Bot1.Main1]
Bot1.Battlefield.Mountain#1.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Arrange(| Mountain)
