? Bot1.Graveyard = Lightning Bolt; Mountain; Chain Lightning
? Bot1.Battlefield.Dragon's Rage Channeler.Power = 1
? Bot1.Battlefield.Dragon's Rage Channeler.Keywords = (absent)

