# Coalition Relic cast off three Islands on turn 5, then tapped for a charge counter rather than for mana. On turn 7
# its precombat main phase trigger takes the counter off and Bot1 chooses red for it, which is the only red mana in
# the game and is what pays for Lightning Bolt. The Relic is untapped again by then, so it stores another counter.

[Bot1 Deck]
Island
Island
Island
Coalition Relic
Lightning Bolt
Island
Island
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T5 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Battlefield.Island#3.Activate
Bot1.Hand.Coalition Relic.Cast
Bot1.Battlefield.Coalition Relic.Activate(Ability: charge counter)
[T5 Bot1.Main2]
? Bot1.Battlefield.Coalition Relic.Counters.Charge = 1
[T7 Bot1.Main1]
Bot1.Colors(Red)
Bot1.Battlefield.Coalition Relic.Activate(Ability: charge counter)
Bot1.Hand.Lightning Bolt.Cast(Bot2)

[Expect]
Turn = 7
Bot1.Battlefield = Island; Island; Island; Coalition Relic
Bot1.Battlefield.Coalition Relic.Counters.Charge = 1
Bot1.Graveyard = Lightning Bolt
Bot2.Life = 17
Stack.Count = 0
