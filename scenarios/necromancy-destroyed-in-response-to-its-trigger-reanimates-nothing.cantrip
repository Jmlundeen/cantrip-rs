Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Disenchant; Ornithopter
Bot1.Graveyard = Necromancy; Lightning Bolt
Bot1.Battlefield.Count = 4
Stack.Count = 0
