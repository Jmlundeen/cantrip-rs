# Bot2 sacrifices its Llanowar Elves to Goblin Bombardment, aiming the damage at Bot1's Goblin Welder, and Bot1 is
# asked whether to let it resolve. Handed over there so the web client can be seen showing an activated ability
# resolving: the Bombardment lit red, and an arrow from it striking the Welder as the damage kills it.

[Bot1 Deck]
Mountain
Goblin Welder
Mountain x16

[Bot2 Deck]
Forest
Mountain
Goblin Bombardment
Llanowar Elves
Mountain x14

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goblin Welder.Cast
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Goblin Bombardment.Cast
Bot2.Battlefield.Goblin Bombardment.Activate(Bot1.Battlefield.Goblin Welder)
[Handover Bot1.Pass]

[Expect]
Turn = 4
ActivePlayer = Bot2
PriorityPlayer = Bot1
Bot1.Battlefield.Goblin Welder.Damage = 0
Bot2.Battlefield = Forest; Mountain; Goblin Bombardment
Bot2.Graveyard = Llanowar Elves
