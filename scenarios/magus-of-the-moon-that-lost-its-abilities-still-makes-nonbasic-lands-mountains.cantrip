Turn = 3
Bot1.Battlefield.Magus of the Moon.Subtypes = Skeleton
Bot1.Battlefield.Magus of the Moon.Colors = Black
Bot1.Battlefield.Mutavault.Subtypes = Mountain
Bot1.Battlefield.Azorius Chancery.Subtypes = Mountain
Bot1.Battlefield.Azorius Chancery.Tapped = false
Bot1.Battlefield.Mutavault.Tapped = true
