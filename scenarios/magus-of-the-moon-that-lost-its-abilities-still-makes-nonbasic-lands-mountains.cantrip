Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Eaten by Piranhas.Cast(Bot1.Battlefield.Magus of the Moon)
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Magus of the Moon.Subtypes = Skeleton
? Bot1.Battlefield.Mutavault.Subtypes = Mountain
[T3 Bot1.Main1]
! Bot1.Battlefield.Mutavault.Activate(Ability: {1})
! Bot1.Battlefield.Mutavault.Activate(Ability: Add {C})
Bot1.Battlefield.Mutavault.Activate(Ability: Add {R})
? Bot1.Mana = {R}
Bot1.Hand.Azorius Chancery.Play
? Stack.Count = 0
? Bot1.Battlefield.Azorius Chancery.Tapped = false

