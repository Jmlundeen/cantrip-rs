# Erode on Bot1's own Ornithopter: "its controller" is the caster, who is asked and may search only for a basic land card.
# The Volcanic Island on top of the library is a land but not a basic one: it cannot be taken (a refusal), the Mountain
# can (the positive control), and it enters tapped. Bot2 is not asked anything.

[Bot1 Deck]
Plains
Erode
Ornithopter
Plains x4
Plains
Volcanic Island
Mountain
Plains x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Erode.Cast(Ornithopter)
Bot1.Accept
! Bot1.Search(Volcanic Island)
Bot1.Search(Mountain)

[Expect]
Turn = 3
Bot1.Graveyard = Erode; Ornithopter
Bot1.Battlefield = Plains; Plains; Mountain
Bot1.Battlefield.Mountain.Tapped = true
