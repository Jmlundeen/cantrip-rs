# Unsummon: "Return target creature to its owner's hand." Bot1 controls Bot2's Llanowar Elves with Mind Control, then
# casts Unsummon on it: it goes to its OWNER's hand (CR 400.3), Bot2's, not to Bot1's, and Mind Control, now
# attached to nothing, is put into Bot1's graveyard (CR 704.5m). Bot1's hand is the Islands it drew or held.

[Bot1 Deck]
Mox Sapphire
Mox Sapphire
Mox Jet
Mox Ruby
Mox Pearl
Island
Mind Control
Unsummon
Island x12

[Bot2 Deck]
Forest
Llanowar Elves
Forest x16

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Island.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Mind Control.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Llanowar Elves.Power = 1
Bot1.Battlefield.Island.Activate
Bot1.Hand.Unsummon.Cast(Bot1.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Hand.Count = 7
Bot1.Hand.Count = 0
Bot2.Battlefield = Forest
Bot1.Battlefield = Mox Sapphire; Mox Sapphire; Mox Jet; Mox Ruby; Mox Pearl; Island
Bot1.Graveyard = Mind Control; Unsummon
