# "you may reveal ... If you don't, this land enters tapped" (CR 614.1d): Bot1 declines the reveal, so Foreboding Ruins
# enters the battlefield tapped and cannot be tapped for mana that turn.

[Bot1 Deck]
Foreboding Ruins
Swamp
Mountain x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Foreboding Ruins.Play
Bot1.Decline
? Bot1.Battlefield.Foreboding Ruins.Tapped = true
! Bot1.Battlefield.Foreboding Ruins.Activate(Color: Red)

[Expect]
Turn = 1
Bot1.Battlefield.Foreboding Ruins.Tapped = true
