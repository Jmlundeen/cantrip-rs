# Vaan, Street Thief connects and exiles an Island from the top of Bot2's library: a land cannot be cast, so Bot1 is not asked
# and creates a Treasure token (the land stays in exile). On turn 4 Bot2's own Rogue, Triton Shorethief, deals combat damage to
# Bot1: it is not a Rogue Bot1 controls, so Vaan does not trigger - no second card is exiled and no second Treasure is made.

[Bot1 Deck]
Black Lotus
Vaan, Street Thief
Island x5
Island x13

[Bot2 Deck]
Island
Triton Shorethief
Island x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Vaan, Street Thief.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Triton Shorethief.Cast
[T3 Bot1.Main1]
Bot1.Attack(Vaan, Street Thief > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Exile = Island
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Triton Shorethief > Bot1)
[T4 Bot2.Main2]

[Expect]
Bot2.Life = 18
Bot1.Life = 19
Exile = Island
Bot1.Battlefield.Treasure Token.Tapped = false
Bot1.Battlefield.Treasure Token#2 = (absent)
