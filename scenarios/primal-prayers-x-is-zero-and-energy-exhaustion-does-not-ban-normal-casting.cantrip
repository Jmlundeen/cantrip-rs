Bot2.Pass
? Bot1.Energy = 0
! Bot1.Hand.Ornithopter.Cast(Ability: Pay {E})
Bot1.Hand.Ornithopter.Cast

[Expect]
Bot1.Energy = 0
Bot1.Graveyard = Walking Ballista; Walking Ballista; Show and Tell; Black Lotus
Bot1.Battlefield = Island; Primal Prayers; Ornithopter
