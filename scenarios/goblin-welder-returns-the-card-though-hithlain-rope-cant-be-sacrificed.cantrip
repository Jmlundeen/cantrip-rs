# Goblin Welder targets Bot1's own Hithlain Rope and the Black Lotus in Bot1's graveyard: both targets are legal as it
# resolves, but the Rope can't be sacrificed (CR 101.2, 701.21a), so only that part of the effect does nothing - the Rope
# stays and the Lotus still returns to the battlefield (CR 101.3).

[Bot1 Deck]
Mountain
Goblin Welder
Black Lotus
Hithlain Rope
Island x16

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goblin Welder.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Hithlain Rope.Cast
[T3 Bot1.Main1]
? Bot1.Graveyard = Black Lotus
Bot1.Battlefield.Goblin Welder.Activate
Bot1.Target(Hithlain Rope)
Bot1.Target(Black Lotus)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield = Mountain; Goblin Welder; Hithlain Rope; Black Lotus
Bot1.Graveyard.Count = 0
