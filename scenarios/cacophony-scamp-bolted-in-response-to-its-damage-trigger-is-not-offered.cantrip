Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby#1.Activate
Bot2.Hand.Liliana of the Veil.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Attack(Cacophony Scamp > Bot2)
[T3 Bot1.CombatDamage]
Bot1.Pass
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Cacophony Scamp)
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
! Bot1.Accept
