# Each Crystal Barricade is an "other creature you control" to the second one (CR 615.1), and "all noncombat damage"
# includes damage from its controller's own sources. Bot1 casts two Crystal Barricades and then its own Lightning Bolt at
# one of them: the other one's prevention effect prevents the 3 damage, so no damage is marked on either.

[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Ruby
Crystal Barricade x2
Lightning Bolt
Island x20

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Crystal Barricade.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Crystal Barricade.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Crystal Barricade)
Bot1.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Battlefield.Crystal Barricade#1.Damage = 0
Bot1.Battlefield.Crystal Barricade#2.Damage = 0
Prevented = 3 Lightning Bolt > Crystal Barricade by Crystal Barricade
Bot1.Graveyard = Lightning Bolt; Black Lotus
