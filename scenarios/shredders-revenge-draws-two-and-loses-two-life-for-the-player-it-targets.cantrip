# Shredder's Revenge, second mode, aimed at Bot2: the target player, not the caster, draws two cards (7 to 9) and loses 2 life
# (Bot2 at 18; Bot1 stays at 20 with the 4 cards it kept). The first mode is not done: Bot2 discards nothing beyond the one card
# it discarded to its hand size on turn 2.

[Bot1 Deck]
Mox Jet
Mox Ruby
Mox Pearl
Shredder's Revenge
Swamp x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T3 Bot1.Main1]
? Bot1.Hand.Count = 5
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Shredder's Revenge.Cast
Bot1.Modes(Target player draws two cards and loses 2 life)
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Hand.Count = 9
Bot2.Life = 18
Bot1.Hand.Count = 4
Bot1.Life = 20
Bot2.Graveyard.Count = 1
Bot1.Graveyard = Shredder's Revenge
