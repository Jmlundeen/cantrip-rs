# Flamehold Grappler: "copy the next spell you cast this turn". With the Grappler in play Bot2 casts a Lightning Bolt first
# (Bot1 down to 17): that spell is not Bot1's, so it is not copied (Bot2 is not copied either) and the delayed ability waits.
# Bot1's own Ornithopter then is the next spell it casts, and its copy becomes a token, so Bot1 has two Ornithopters.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Pearl
Flamehold Grappler
Ornithopter
Island x15

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Flamehold Grappler.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Delayed.Count = 1
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Pass
Bot1.Pass
? Delayed.Count = 1
? Bot1.Life = 17
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Flamehold Grappler; Mox Pearl; Mox Ruby; Mox Sapphire; Ornithopter; Ornithopter
Bot1.Life = 17
Delayed.Count = 0
