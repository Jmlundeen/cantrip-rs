# Old-Growth Troll dies as a creature and returns as an Aura enchanting a Forest its controller chooses (CR 303.4f): Bot1's
# own, never Bot2's Forest ("you control"). The Forest then has "{T}: Add {G}{G}" (CR 613.1f) - the pool is checked right after
# - and the Troll is an Aura enchantment that keeps its color and trample, no creature (it would not trigger again).
# Bot1 casts the Troll on turn 1 with Black Lotus, plays a second Forest on turn 3 (so there is a choice) and destroys its own Troll.

[Bot1 Deck]
Forest
Black Lotus
Old-Growth Troll
Forest
Mox Jet
Mox Ruby
Infernal Grasp
Forest x13

[Bot2 Deck]
Forest
Forest x19

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: G)
Bot1.Hand.Old-Growth Troll.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Infernal Grasp.Cast(Bot1.Battlefield.Old-Growth Troll)
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2.Battlefield.Forest)
Bot1.Target(Bot1.Battlefield.Forest)
Bot1.Battlefield.Forest.Activate(Ability: {T}: Add {G}{G})
? Bot1.Mana = {G}{G}
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Old-Growth Troll.AttachedTo = Forest
Bot1.Battlefield.Old-Growth Troll.Types = Enchantment
Bot1.Battlefield.Old-Growth Troll.Subtypes = Aura
Bot1.Battlefield.Old-Growth Troll.Keywords = Trample
Bot1.Battlefield.Old-Growth Troll.Colors = Green
Bot1.Battlefield.Forest#1.Tapped = true
Bot1.Battlefield.Forest#2.Tapped = false
Bot2.Battlefield.Forest.Tapped = false
Bot1.Life = 18
