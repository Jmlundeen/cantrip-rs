# The source of mana a spell produces is that spell (CR 106.3): Dark Ritual's {B}{B}{B} is Dark Ritual's, not the Swamp's that
# paid for it (that {B} was spent). A mana ability a player has of their own has no source object (CR 605.1a): Channel's {C}
# comes from no permanent. The pool, by source (`Bot1.ManaFrom`), says so.

[Bot1 Deck]
Swamp
Forest
Forest
Channel
Dark Ritual
Swamp x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Swamp.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
[T5 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest#1.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Hand.Channel.Cast
Bot1.Pass
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Dark Ritual.Cast
Bot1.Pass
Bot1.Channel.Activate
? Bot1.ManaFrom = {B}{B}{B} Dark Ritual; {C} none

[Expect]
Bot1.Mana = {B}{B}{B}{C}
Bot1.Life = 19
