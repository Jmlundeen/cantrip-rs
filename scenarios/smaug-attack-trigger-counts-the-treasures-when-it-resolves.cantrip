# Smaug's attack trigger counts the Treasures Bot1 controls as it resolves (CR 608.2h), not as it was put on the stack:
# by turn 5 two upkeeps have made two Treasures, but Bot1 sacrifices one for mana with the trigger on the stack, so it
# deals 1 damage and not 2 (Bot2 20 - 4 combat - 1 = 15).

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mountain
Smaug the Magnificent
Mountain x2
Mountain x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Smaug the Magnificent.Cast
Bot1.Pass
[T5 Bot1.Main1]
? Bot1.Battlefield.Count = 7
Bot1.Attack(Smaug the Magnificent > Bot2)
Bot1.Target(Bot2)
Bot1.Battlefield.Treasure Token.Activate(Color: Red)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 15
Bot1.Battlefield.Count = 6
Bot1.Battlefield.Treasure Token.Tapped = false
