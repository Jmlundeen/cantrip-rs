# Curse of Predation triggers once for each creature attacking the enchanted player: two Ornithopters attack Bot2 together
# and each gets its own +1/+1 counter (two triggers, CR 603.2c), so Bot2 takes 2.

[Bot1 Deck]
Forest
Sol Ring
Mox Emerald
Ornithopter
Ornithopter
Curse of Predation
Forest x15

[Bot2 Deck]
Island x13

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Curse of Predation.Cast(Bot2)
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2; Ornithopter#2 > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Ornithopter#1.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Ornithopter#2.Counters.PlusOnePlusOne = 1
Bot2.Life = 18
