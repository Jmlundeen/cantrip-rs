# One Island is the only other land Bot1 controls when Q Continuum enters, so it enters tapped and nothing triggers;
# once untapped it taps for exactly one green mana (CR 614.1d, 603.6a, 605.1a, 605.3b).

[Bot1 Deck]
Q Continuum
Island x20

[Bot2 Deck]
Mountain x20

[Actions]
Bot1.Hand.Island.Play
Bot2.Hand.Mountain.Play
Bot1.Hand.Q Continuum.Play
! Bot1.Modes
[T3 Bot1.Main1]
Bot1.Battlefield.Q Continuum.Activate
? Bot1.Mana = {G}

[Expect]
Bot1.Battlefield.Q Continuum.Tapped = true
Bot1.Mana = {G}
Bot1.Life = 20
Bot2.Life = 20
