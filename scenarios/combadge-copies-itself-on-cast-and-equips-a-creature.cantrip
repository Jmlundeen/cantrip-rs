# Combadge copies itself as it is cast, so a token copy of the Equipment enters beside the original (CR 707.10f). With one
# on each of two creatures, attacking with one makes it unblockable thanks to the other, so its damage gets through
# (CR 509.1b, 613.1f, 603.2).

[Bot1 Deck]
Mox Emerald x3
Forest x1
Combadge x2
Grizzly Bears x2
Forest x12

[Bot2 Deck]
Ornithopter
Forest x19

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Forest#1.Play
Bot1.Hand.Combadge#1.Cast
Bot1.Battlefield.Mox Emerald#1.Activate
Bot1.Battlefield.Mox Emerald#2.Activate
Bot1.Battlefield.Mox Emerald#3.Activate
Bot1.Hand.Grizzly Bears#1.Cast
Bot1.Battlefield.Forest#1.Activate
Bot1.Battlefield.Forest#2.Activate
[T5 Bot1.Main1]
Bot1.Hand.Forest#1.Play
Bot1.Battlefield.Combadge#1.Activate(Bot1.Battlefield.Grizzly Bears#1; Ability: Equip)
Bot1.Battlefield.Mox Emerald#1.Activate
Bot1.Battlefield.Mox Emerald#2.Activate
Bot1.Hand.Grizzly Bears#1.Cast
Bot1.Battlefield.Forest#1.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Battlefield.Forest#3.Activate
[T7 Bot1.Main1]
Bot1.Hand.Forest#1.Play
Bot1.Battlefield.Combadge#2.Activate(Bot1.Battlefield.Grizzly Bears#2; Ability: Equip)
Bot1.Battlefield.Mox Emerald#1.Activate
Bot1.Battlefield.Mox Emerald#2.Activate
[Bot1.BeginCombat]
Bot1.Attack(Grizzly Bears#1)
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Combadge#1.Types = Artifact
Bot1.Battlefield.Combadge#2.Types = Artifact
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Life = 18
