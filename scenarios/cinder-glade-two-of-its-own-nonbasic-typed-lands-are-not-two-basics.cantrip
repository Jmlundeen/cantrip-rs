# Cinder Glade: "This land enters tapped unless you control two or more basic lands." Bot1 controls two Taigas - two lands
# with the Mountain and Forest types, but neither basic (CR 205.4a; two or more of these lands do not count) - and no
# basic land at all, so its Cinder Glade enters tapped. Bot2 with a Mountain and a Forest plays the same land untapped
# (positive control).

[Bot1 Deck]
Taiga
Taiga
Cinder Glade
Forest x20

[Bot2 Deck]
Mountain
Forest
Cinder Glade
Forest x20

[Actions]
Bot1.Hand.Taiga.Play
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Taiga.Play
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
[T5 Bot1.Main1]
Bot1.Hand.Cinder Glade.Play
[T6 Bot2.Main1]
Bot2.Hand.Cinder Glade.Play

[Expect]
Bot1.Battlefield.Cinder Glade.Tapped = true
Bot2.Battlefield.Cinder Glade.Tapped = false
