? Bot2.Battlefield.K'Vort-Class Raider.Keywords = (absent)
Bot1.Pass
Bot2.Pass
[T6 Bot2.Main1]
# On Bot2's turn the cover has moved over: Bot1's two are plain again and Bot2's Raider is the one that has it.
? Bot1.Battlefield.K'Vort-Class Raider.Keywords = (absent)
? Bot1.Battlefield.Grizzly Bears.Keywords = (absent)
? Bot2.Battlefield.K'Vort-Class Raider.Keywords = Hexproof

[Expect]
Bot1.Battlefield.K'Vort-Class Raider.Keywords = (absent)
Bot1.Battlefield.Grizzly Bears.Keywords = (absent)
Bot2.Battlefield.K'Vort-Class Raider.Keywords = Hexproof
