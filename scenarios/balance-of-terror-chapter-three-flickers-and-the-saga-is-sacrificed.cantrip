# Balance of Terror ({2}{W} Saga): the draw step after chapter II adds the third lore counter, so chapter III exiles a
# permanent its controller controls (Mox Emerald, returned by chapter II) and returns it at the beginning of the next end
# step; after its last chapter the Saga sacrifices itself (CR 714.4, 603.7, 400.7).

[Bot1 Deck]
Mox Emerald
Mox Pearl
Black Lotus
Balance of Terror
Plains x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Hand.Balance of Terror.Cast
Bot1.Target(Bot1.Battlefield.Mox Pearl)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Target(Bot1.Battlefield.Mox Emerald)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot1.Exile.Mox Emerald.Colors.Count = 0
[T5 Bot1.Main1]
Bot1.Target(Bot1.Battlefield.Mox Emerald)
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main2]
? Bot1.Battlefield.Balance of Terror = (absent)
? Bot1.Exile.Mox Emerald.Colors.Count = 0
[T6 Bot2.Main1]
? Bot1.Battlefield.Mox Emerald.Types = Artifact

[Expect]
Bot1.Battlefield.Balance of Terror = (absent)
Bot1.Battlefield.Mox Emerald.Types = Artifact
Bot1.Graveyard.Count = 3
