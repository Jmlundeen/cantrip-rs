# Vren only exiles creatures an opponent controls, and only counts creatures exiled under an opponent's control. Bot1 controls two
# Ornithopters beside Vren. On turn 3 Swords to Plowshares exiles one (its own creature, exiled but not under an opponent's control: no Rat at that end
# step). On turn 5 a Lightning Bolt kills the other: Bot1's own creature is not replaced by Vren's "exile instead", so it goes to
# its owner's graveyard, and again no Rat is made. (Bot2 does nothing, so every Rat count is 0.)

[Bot1 Deck]
Mox Sapphire
Mox Jet
Mox Ruby
Mox Pearl
Vren, the Relentless
Ornithopter
Ornithopter
Swords to Plowshares
Lightning Bolt
Island x10

[Bot2 Deck]
Forest x17

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Vren, the Relentless.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Swords to Plowshares.Cast(Ornithopter#1)
Bot1.Pass
Bot2.Pass
? Exile = Ornithopter
[T3 Bot1.End]
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 6
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = Ornithopter; Lightning Bolt; Swords to Plowshares
[T5 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Ornithopter
Bot1.Graveyard = Ornithopter; Lightning Bolt; Swords to Plowshares
Bot1.Battlefield.Count = 5
Bot2.Life = 20
