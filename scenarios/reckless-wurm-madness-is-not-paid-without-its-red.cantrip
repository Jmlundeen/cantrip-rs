# Reckless Wurm's madness cost is {2}{R} (CR 702.35a): discarded to Faithless Looting (paid with a Mox Ruby) with Mana
# Crypt's {C}{C} and Mox Emerald's {G} in the pool - as much mana as the madness cost, no red - Bot1 accepts the cast, but it
# can't be paid and is cancelled, so the card goes to the graveyard. A cost with a generic {1} in place of the {R} would be
# payable here, so this pins the {R}.

[Bot1 Deck]
Mox Ruby
Faithless Looting
Reckless Wurm
Mana Crypt
Mox Emerald
Island x16

[Bot2 Deck]
Island x24

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mana Crypt.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mana Crypt.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Pass
Bot1.Choose(Reckless Wurm; Island)
Bot1.Accept
Bot1.Cancel

[Expect]
Bot1.Battlefield = Mana Crypt; Mox Emerald; Mox Ruby
Bot1.Graveyard.Reckless Wurm.Colors = Red
Exile.Count = 0
