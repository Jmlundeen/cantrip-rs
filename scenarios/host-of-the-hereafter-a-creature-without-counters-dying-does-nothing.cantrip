# Host of the Hereafter: "if it had counters on it" (CR 603.4). Bot1's Ornithopter has none, so its dying (Lightning Bolt on
# Bot2's turn) does not trigger the Host, which keeps its own two counters and Bot1 is asked for no target.

[Bot1 Deck]
Mox Jet
Mox Emerald
Mox Pearl
Mox Ruby
Host of the Hereafter
Ornithopter
Island x14

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Host of the Hereafter.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
! Bot1.Target
? Bot1.Graveyard = Ornithopter
? Stack.Count = 0

[Expect]
Bot1.Graveyard = Ornithopter
Bot1.Battlefield.Host of the Hereafter.Counters.PlusOnePlusOne = 2
Stack.Count = 0
