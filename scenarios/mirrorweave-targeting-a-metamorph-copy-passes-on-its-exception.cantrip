Bot1.Hand.Mirrorweave.Cast(Bot1.Battlefield.Guerrilla Gorilla)
Bot1.Battlefield.Plains.Activate
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield = Plains; Mox Sapphire; Mox Pearl; Mox Emerald; Guerrilla Gorilla; Guerrilla Gorilla
Bot1.Battlefield.Guerrilla Gorilla#1.Types = Creature; Artifact
Bot1.Battlefield.Guerrilla Gorilla#2.Types = Creature; Artifact
Bot2.Battlefield.Guerrilla Gorilla.Types = Creature; Artifact
Bot1.Life = 18
