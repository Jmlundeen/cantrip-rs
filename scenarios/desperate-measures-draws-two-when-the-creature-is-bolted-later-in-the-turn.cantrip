# Desperate Measures: Bot1's Ornithopter (0/2) becomes 1/1 and lives; the delayed ability waits. Bot1 then bolts it the same turn
# and, it dying under Bot1's control, draws two cards (Forest, Forest).

[Bot1 Deck]
Mox Jet
Mox Ruby
Ornithopter
Desperate Measures
Lightning Bolt
Island x2
Forest
Forest
Forest x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Desperate Measures.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter.Power = 1
? Bot1.Battlefield.Ornithopter.Toughness = 1
? Bot1.Hand.Count = 3
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
