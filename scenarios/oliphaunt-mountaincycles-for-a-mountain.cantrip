# Mountaincycling {1} is a cycling ability (CR 702.29e): from the hand, Bot1 pays {1}, discards Oliphaunt and searches
# its library for a Mountain, which goes into its hand.

[Bot1 Deck]
Island
Oliphaunt
Island x5
Mountain
Island x10

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Oliphaunt.Activate
Bot1.Search(Mountain)

[Expect]
Turn = 1
Stack.Count = 0
Bot1.Graveyard = Oliphaunt
Bot1.Hand = Island; Island; Island; Island; Island; Mountain
Bot1.Library.Count = 10
