Bot2.Battlefield.Mox Ruby.Activate
[T3 Bot1.Main1]
Bot1.Attack(Hired Blade > Bot2)
Bot2.Block(Embereth Shieldbreaker > Hired Blade)
[T3 Bot1.DeclareBlockers]
Bot1.Battlefield.Mother of Runes.Activate(Hired Blade)
Bot1.Colors(Red)
? Combat.Blocks.Count = 1
