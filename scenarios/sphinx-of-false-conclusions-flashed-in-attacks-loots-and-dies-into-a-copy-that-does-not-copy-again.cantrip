Bot1.Attack(Sphinx of False Conclusions > Bot2)
Bot1.Pass
Bot1.Choose(Forest)
? Bot1.Hand.Count = 5
? Bot1.Graveyard = Forest; Black Lotus
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Sphinx of False Conclusions)
Bot2.Battlefield.Mountain.Activate
Bot1.Pass
