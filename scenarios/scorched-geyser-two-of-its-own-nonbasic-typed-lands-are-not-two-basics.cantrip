# Scorched Geyser: "This land enters tapped unless you control two or more basic lands." Bot1 controls two Volcanic Islands
# - two lands with the Island and Mountain types, but neither basic (CR 205.4c; two or more of these lands do not count)
# - and no basic land at all, so its Scorched Geyser enters tapped. Bot2 with an Island and a Mountain plays the same land
# untapped (positive control).

[Bot1 Deck]
Volcanic Island
Volcanic Island
Scorched Geyser
Mountain x20

[Bot2 Deck]
Island
Mountain
Scorched Geyser
Mountain x20

[Actions]
Bot1.Hand.Volcanic Island.Play
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Volcanic Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T5 Bot1.Main1]
Bot1.Hand.Scorched Geyser.Play
[T6 Bot2.Main1]
Bot2.Hand.Scorched Geyser.Play

[Expect]
Bot1.Battlefield.Scorched Geyser.Tapped = true
Bot2.Battlefield.Scorched Geyser.Tapped = false
