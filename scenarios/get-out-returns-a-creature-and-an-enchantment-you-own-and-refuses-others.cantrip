Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Fastbond.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Sol Ring.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Get Out.Cast
Bot1.Modes(2)
! Bot1.Target(Count: 0)
! Bot1.Target(Bot2.Battlefield.Llanowar Elves)
! Bot1.Target(Bot2.Battlefield.Sol Ring)
! Bot1.Target(Bot1.Battlefield.Ornithopter#1; Bot1.Battlefield.Ornithopter#2; Bot1.Battlefield.Fastbond)
Bot1.Target(Bot1.Battlefield.Ornithopter#1; Bot1.Battlefield.Fastbond)
Bot2.Pass
Bot1.Pass

[Expect]
Stack.Count = 0
Bot1.Hand = Ornithopter; Fastbond; Island
Bot1.Battlefield = Mox Emerald; Mox Sapphire; Ornithopter
Bot1.Graveyard = Get Out; Black Lotus
