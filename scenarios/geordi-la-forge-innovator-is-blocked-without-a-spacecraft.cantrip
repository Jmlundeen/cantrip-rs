# Geordi La Forge, Innovator: without a Spacecraft his attack can be blocked, so no combat damage reaches Bot2 and its
# controller draws nothing.

[Bot1 Deck]
Black Lotus
Geordi La Forge, Innovator
Island x20

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Geordi La Forge, Innovator.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Geordi La Forge, Innovator > Bot2)
Bot2.Block(Ornithopter > Geordi La Forge, Innovator)
[T3 Bot1.Main2]
? Bot2.Life = 20
? Bot1.Hand.Count = 6

[Expect]
Bot2.Life = 20
