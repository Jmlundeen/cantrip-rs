Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Pyrite Spellbomb.Cast
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Pyrite Spellbomb.Activate(Bot2.Battlefield.Ornithopter; Ability: 2 damage)
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
[Bot1.Main2]

