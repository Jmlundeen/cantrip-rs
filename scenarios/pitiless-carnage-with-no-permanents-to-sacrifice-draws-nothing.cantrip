# Pitiless Carnage: "Sacrifice any number of permanents you control" - with none, it does nothing. Bot1 plots it on turn 1
# with a Black Lotus (sacrificed for its mana, so the battlefield is empty), and casts it free on turn 3: no choice is
# asked and nothing is drawn beyond the turn's own draw.

[Bot1 Deck]
Black Lotus
Pitiless Carnage
Island x5
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Pitiless Carnage.Activate(Ability: Plot)
[T3 Bot1.Main1]
Bot1.Exile.Pitiless Carnage.Cast
Bot1.Pass
[Bot1.Main1]

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Hand.Count = 6
Bot1.Battlefield.Count = 0
Bot1.Graveyard = Pitiless Carnage; Black Lotus
