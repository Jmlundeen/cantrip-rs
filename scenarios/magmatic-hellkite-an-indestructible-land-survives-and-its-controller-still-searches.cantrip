Bot2.Battlefield.Creeping Tar Pit.Activate(Ability: Until end of turn)
Bot2.Pass
Bot1.Pass
Bot2.Battlefield.Creeping Tar Pit.Activate(Ability: {T}: Add {U} or {B}; Color: Black)
Bot2.Hand.Revitalizing Repast.Cast(Creeping Tar Pit)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot2.Search(Forest)

[Expect]
Bot1.Graveyard.Count = 0
Bot1.Battlefield.Magmatic Hellkite.Tapped = false
Bot2.Battlefield.Creeping Tar Pit.Keywords = Indestructible
Bot2.Battlefield.Creeping Tar Pit.CantBeBlocked = true
Bot2.Battlefield.Forest.Tapped = true
Bot2.Battlefield.Forest.Counters.Stun = 1
