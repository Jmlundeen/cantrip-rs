Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Bonecrusher Giant.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Quag Feast.Cast(Bot2.Battlefield.Bonecrusher Giant)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
[T3 Bot1.Main2]
? Bot1.Graveyard.Count = 3
? Bot2.Battlefield.Bonecrusher Giant.Toughness = 3
[T5 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Quag Feast.Cast(Bot2.Battlefield.Bonecrusher Giant)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
[T5 Bot1.Main2]

[Expect]
Bot2.Graveyard = Bonecrusher Giant
Bot1.Graveyard.Count = 6
