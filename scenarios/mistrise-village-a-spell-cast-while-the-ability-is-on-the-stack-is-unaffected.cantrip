# Bot1 activates Mistrise Village and, with the ability still on the stack, casts Lightning Bolt. The Bolt is cast before
# the effect exists (CR 611.2c: it affects spells cast after it is made), so it is not marked and Bot2's Counterspell
# counters it. The ability then resolves and the effect applies to the NEXT spell, a second Bolt, which Bot2's second
# Counterspell can't counter: it resolves and Bot2 is at 17.

[Bot1 Deck]
Forest
Mox Sapphire
Mox Ruby
Mox Ruby
Mistrise Village
Lightning Bolt
Lightning Bolt
Forest x10

[Bot2 Deck]
Island
Mox Sapphire
Mox Sapphire
Mox Sapphire
Counterspell
Counterspell
Forest x12

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mistrise Village.Play
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mistrise Village.Activate(Ability: next spell)
? Stack = Mistrise Village
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
? Stack = Lightning Bolt; Mistrise Village
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Lightning Bolt)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Lightning Bolt)
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Life = 17
Bot1.Graveyard = Lightning Bolt; Lightning Bolt
Bot2.Graveyard = Counterspell; Counterspell
