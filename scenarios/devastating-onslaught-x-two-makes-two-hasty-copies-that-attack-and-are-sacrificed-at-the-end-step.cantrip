Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Devastating Onslaught.Cast(Llanowar Elves; X: 2)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Count = 8
? Bot1.Battlefield.Llanowar Elves#1.Token = (absent)
? Bot1.Battlefield.Llanowar Elves#2.Token = true
? Bot1.Battlefield.Llanowar Elves#3.Token = true
? Bot1.Battlefield.Llanowar Elves#2.Keywords = Haste
? Bot1.Battlefield.Llanowar Elves#3.Keywords = Haste
? Bot1.Battlefield.Llanowar Elves#1.Keywords = (absent)
? Bot1.Battlefield.Llanowar Elves#2.SummoningSick = false
Bot1.Attack(Llanowar Elves#1; Llanowar Elves#2; Llanowar Elves#3 > Bot2)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Bot2.Life = 17
[T3 Bot1.End]
Bot1.Pass

