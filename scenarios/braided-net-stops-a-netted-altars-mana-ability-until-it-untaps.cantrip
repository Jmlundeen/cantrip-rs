# Mana abilities are activated abilities too (CR 605.1a), so Braided Net's "its activated abilities can't be activated"
# stops Bot2's netted Ashnod's Altar from sacrificing its Ornithopter for mana, though the Altar's ability needs no
# tapping (CR 602.5). Bot2's untap step untaps the Altar and ends the effect (CR 611.2b): then the Altar makes {C}{C}.

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Braided Net
Island
Island
Island
Island x13

[Bot2 Deck]
Swamp
Mox Jet
Mox Ruby
Ashnod's Altar
Ornithopter
Swamp x15

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Braided Net.Cast
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Ashnod's Altar.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Braided Net.Activate(Ability: Tap another; Bot2.Battlefield.Ashnod's Altar)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ashnod's Altar.Tapped = true
Bot1.Pass
! Bot2.Battlefield.Ashnod's Altar.Activate
[T4 Bot2.Main1]
Bot2.Battlefield.Ashnod's Altar.Activate(Sacrifice: Ornithopter)
? Bot2.Mana = {C}{C}

[Expect]
Turn = 4
Bot2.Graveyard = Ornithopter
Bot2.Battlefield.Ashnod's Altar.Tapped = false
