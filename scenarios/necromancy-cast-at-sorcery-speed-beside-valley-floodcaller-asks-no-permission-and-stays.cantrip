Bot1.Hand.Mox Jet.Cast
[T3 Bot1.Main1]
? Stack.Count = 0
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Necromancy.Cast
! Bot1.Modes
[T3 Bot1.End]
? Delayed.Count = 0
[T5 Bot1.Main1]

