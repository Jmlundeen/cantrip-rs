# "Choose up to two target attacking creatures" allows none even when attacking creatures are there (CR 601.2c, 603.3d):
# Bot2 attacks with two creatures, Tuvok flashes in during that declare attackers step, and the answer of no target leaves the
# attack exactly as it was - the Memnite still hits Bot1 for 1 and nothing was reselected.

[Bot1 Deck]
Tuvok, Chief Tactical Officer
Mox Sapphire
Mox Pearl
Mox Jet
Island x16

[Bot2 Deck]
Kobolds of Kher Keep
Memnite
Plains x18

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Kobolds of Kher Keep.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T4 Bot2.Attackers]
Bot2.Attack(Kobolds of Kher Keep > Bot1; Memnite > Bot1)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Tuvok, Chief Tactical Officer.Cast
? Bot1.Mana =
Bot1.Target()
Bot1.Pass
Bot2.Pass
[T4 Bot2.Main2]
? Bot1.Life = 19
? Bot2.Life = 20
? Bot2.Battlefield.Kobolds of Kher Keep.Tapped = true
? Bot1.Battlefield.Tuvok, Chief Tactical Officer.Power = 2

[Expect]
Turn = 4
Bot1.Life = 19
Bot2.Life = 20
Bot2.Battlefield.Memnite.Tapped = true
Stack.Count = 0
