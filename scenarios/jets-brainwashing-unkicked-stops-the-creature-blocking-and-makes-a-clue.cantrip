# Jet's Brainwashing {R}: "Target creature can't block this turn. ... Create a Clue token." Unkicked, one Mox Ruby pays it exactly.
# Bot2's Ornithopter can't block Bot1's attacking Memnite (refused) while Bot2's Memnite still can (the positive control); the
# Ornithopter stays Bot2's. Bot1 gets a Clue.

[Bot1 Deck]
Mox Ruby
Memnite
Jet's Brainwashing
Mountain x17

[Bot2 Deck]
Ornithopter
Memnite
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Jet's Brainwashing.Cast(Bot2.Battlefield.Ornithopter; Kicked: 0)
Bot1.Pass
Bot2.Pass
? Bot1.Mana =
? Bot1.Battlefield.Clue Token.Token = true
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Memnite)
! Bot2.Block(Ornithopter > Memnite)
Bot2.Block(Memnite > Memnite)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Clue Token.Token = true
Bot2.Battlefield = Ornithopter
Bot1.Graveyard = Memnite; Jet's Brainwashing
Bot2.Graveyard = Memnite
Bot2.Life = 20
