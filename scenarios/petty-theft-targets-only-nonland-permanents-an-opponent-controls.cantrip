# "Return target nonland permanent an opponent controls": neither Bot1's own Ornithopter nor Bot2's Island can be
# the target (each refusal names its target, beside the legal cast at Bot2's Ornithopter, which goes back to Bot2's hand).

[Bot1 Deck]
Island
Ornithopter
Brazen Borrower
Island
Island x12

[Bot2 Deck]
Island
Ornithopter
Island x12

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island#1.Activate
Bot1.Battlefield.Island#2.Activate
! Bot1.Hand.Brazen Borrower.Cast(Bot1.Battlefield.Ornithopter; Ability: Adventure)
! Bot1.Hand.Brazen Borrower.Cast(Bot2.Battlefield.Island; Ability: Adventure)
Bot1.Hand.Brazen Borrower.Cast(Bot2.Battlefield.Ornithopter; Ability: Adventure)
[T3 Bot1.Main2]

[Expect]
Exile = Brazen Borrower
Bot2.Battlefield = Island
Bot2.Hand.Count = 7
Bot1.Battlefield = Island; Island; Ornithopter
