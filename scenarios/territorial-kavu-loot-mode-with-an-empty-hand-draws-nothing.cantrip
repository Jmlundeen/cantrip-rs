# Territorial Kavu, first mode: "Discard a card. If you do, draw a card." - with no card in hand there is nothing to
# discard, so nothing is drawn. Bot1's hand is empty when the Kavu attacks on turn 3 (it played its drawn Forest).

[Bot1 Deck]
Mountain
Mox Ruby
Mox Emerald
Territorial Kavu
Mox Jet
Mox Pearl
Mox Sapphire
Forest
Forest x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Territorial Kavu.Cast
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Attack(Territorial Kavu > Bot2)
Bot1.Modes(Discard a card)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 18
Bot1.Hand.Count = 0
Bot1.Graveyard.Count = 0
