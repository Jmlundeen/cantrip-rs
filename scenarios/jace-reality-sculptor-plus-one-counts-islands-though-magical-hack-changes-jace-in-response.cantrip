Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire#1.Activate
Bot1.Hand.Jace, Reality Sculptor.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Jace, Reality Sculptor.Activate(Ability: Empower)
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Hand.Magical Hack.Cast(Bot1.Battlefield.Jace, Reality Sculptor)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Island)
Bot1.Modes(Swamp)
? Stack.Count = 1
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Jace Token.Counters.Loyalty = 1
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Jace, Reality Sculptor.Activate(Ability: Empower)
Bot1.Pass
Bot2.Pass
