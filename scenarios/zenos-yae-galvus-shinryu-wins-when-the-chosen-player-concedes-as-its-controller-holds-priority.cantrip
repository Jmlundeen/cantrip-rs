# Zenos yae Galvus in a game of three transforms into Shinryu, Transcendent Rival at the beginning of combat on turn 4 (its chosen
# Ornithopter Bolted), and Bot1 chooses Bot3. Bot3 concedes while Bot1 holds priority: a concession is a loss (CR 104.3a), and
# Burning Chains ("When the chosen player loses the game, you win the game") looks back on it (CR 603.10f). It goes on the stack
# before Bot1 is given priority again (CR 117.5), and resolves as Bot1 and Bot2 pass: Bot1 wins.

[Bot1 Deck]
Swamp
Black Lotus
Mox Jet
Mox Ruby
Zenos yae Galvus
Lightning Bolt
Lightning Bolt
Mountain
Swamp x10

[Bot2 Deck]
Ornithopter
Island x20

[Bot3 Deck]
Forest x20

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T4 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Zenos yae Galvus.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Choose(Ornithopter)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Bot2.Battlefield.Ornithopter.Toughness = 2
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Pass
Bot2.Pass
Bot3.Pass
! Bot1.ChoosePlayer(Bot1)
Bot1.ChoosePlayer(Bot3)
? Bot1.Battlefield.Shinryu, Transcendent Rival.Power = 8
? Bot1.Battlefield.Shinryu, Transcendent Rival.Keywords = Flying
? Result = InProgress
Bot3.Concede
? Stack = Shinryu, Transcendent Rival
? PriorityPlayer = Bot1
Bot1.Pass
Bot2.Pass

[Expect]
Result = Bot1 won
Bot2.Status = Lost
Bot3.Status = Lost
