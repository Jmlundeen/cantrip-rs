? Bot1.Graveyard = Ornithopter
? Stack.Count = 0
? Bot1.Battlefield.Ornithopter.Power = 2
? Bot1.Battlefield.Ornithopter.Keywords = Flying; Haste

[Expect]
Bot2.Life = 18
Bot1.Graveyard = Ornithopter
Bot2.Graveyard = Lightning Bolt; Lightning Bolt
Bot1.Battlefield.Enduring Courage.Types = Enchantment
