# Deathtouch counts on the creature the damage is dealt to (CR 702.2b, 704.5h): Bot2's Baleful Strix (1/1 flying,
# deathtouch) attacks Bot1, and its 1 combat damage is dealt to Ancient Adamantoise instead (CR 614.1a), from the same
# deathtouch source, so the 20-toughness Adamantoise is destroyed. Bot1 loses no life. As it dies it is exiled from the
# graveyard and Bot1 gets ten tapped Treasures.

[Bot1 Deck]
Mox Sapphire
Black Lotus
Show and Tell
Ancient Adamantoise
Forest
Forest
Forest
Forest x10

[Bot2 Deck]
Mox Sapphire
Mox Jet
Baleful Strix
Island
Island
Island
Island
Island x10

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Show and Tell.Cast
Bot1.Choose(Ancient Adamantoise)
Bot2.Choose()
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Baleful Strix.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
[T4 Bot2.Main1]
Bot2.Attack(Baleful Strix)
[T4 Bot2.Main2]

[Expect]
Bot1.Life = 20
Exile = Ancient Adamantoise
Bot1.Graveyard = Show and Tell; Black Lotus
Bot1.Battlefield.Count = 12
Bot1.Battlefield.Treasure Token#10.Tapped = true
Bot2.Battlefield.Baleful Strix.Tapped = true
