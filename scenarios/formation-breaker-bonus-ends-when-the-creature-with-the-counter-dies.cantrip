# Formation Breaker's bonus lasts "as long as" Bot1 controls a creature with a counter. Sage of the Fang puts its counter on itself (3/3), so the Breaker is 3/3 too; when Bot2's
# Lightning Bolt kills the Sage, the Breaker is back to its printed 2/1.

[Bot1 Deck]
Black Lotus
Mox Emerald
Mox Pearl
Mox Ruby
Formation Breaker
Sage of the Fang
Island x14

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Formation Breaker.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sage of the Fang.Cast
Bot1.Target(Bot1.Battlefield.Sage of the Fang)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Formation Breaker.Power = 3
? Bot1.Battlefield.Formation Breaker.Toughness = 3
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Sage of the Fang)

[Expect]
Bot1.Battlefield.Sage of the Fang = (absent)
Bot1.Battlefield.Formation Breaker.Power = 2
Bot1.Battlefield.Formation Breaker.Toughness = 1
