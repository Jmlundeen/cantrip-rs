# Amazing Acrobatics with both modes (CR 700.2, 608.2c): in turn 4 Bot2 casts Memnite while its Ornithopter is on the battlefield.
# Bot1 answers with both modes: counter the Memnite spell and tap the Ornithopter. The Memnite is countered (it goes to the
# graveyard) and the Ornithopter is tapped; one cast does both.

[Bot1 Deck]
Black Lotus
Amazing Acrobatics
Island x18

[Bot2 Deck]
Ornithopter
Memnite
Island x18

[Actions]
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T4 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Amazing Acrobatics.Cast
! Bot1.Modes(Count: 0)
Bot1.Modes(1; 2)
Bot1.Target(Stack.Memnite)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter.Tapped = true

[Expect]
Bot2.Graveyard = Memnite
Bot2.Battlefield = Island; Ornithopter
Bot2.Battlefield.Ornithopter.Tapped = true
