? Bot1.Battlefield.Outland Liberator#2.Power = 2
? Bot1.Battlefield.Outland Liberator#2.Colors = Green
? Bot1.Battlefield.Outland Liberator#2.Subtypes = Human; Werewolf
[T5 Bot1.Main1]

[Expect]
DayNight = Night
Bot1.Battlefield = Ardyn, the Usurper; Frenzied Trapbreaker; Mox Emerald; Mox Jet; Mox Pearl; Mox Ruby; Mox Sapphire; Outland Liberator
Bot1.Battlefield.Frenzied Trapbreaker.Transformed = true
Bot1.Battlefield.Outland Liberator.Token = true
