# Bot1 casts Lightning Bolt at Bot2 with Bot2's No More Lies in response: Bot1 cannot pay {3}, so the Bolt is countered and
# exiled instead of going to the graveyard. Bot2 takes no damage.

[Bot1 Deck]
Mountain
Mox Ruby
Lightning Bolt
Mountain x12

[Bot2 Deck]
Mox Pearl
Mox Sapphire
No More Lies
Island x12

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
? Stack = Lightning Bolt
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.No More Lies.Cast(Lightning Bolt)
? Stack = No More Lies; Lightning Bolt
Bot1.Decline

[Expect]
Turn = 3
Stack.Count = 0
Exile = Lightning Bolt
Bot1.Graveyard.Count = 0
Bot2.Life = 20
Bot2.Graveyard = No More Lies
