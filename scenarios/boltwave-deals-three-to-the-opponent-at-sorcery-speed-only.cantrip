# Boltwave deals 3 damage to each opponent: Bot2 takes 3 from it and Bot1 is untouched. It is a sorcery (CR 307.1, 117.1a), so
# it is refused on Bot2's turn and, on Bot1's own turn, while Bot1's Lightning Bolt is still on the stack - each time with a
# Mountain untapped to pay for it. Once the Bolt has resolved (Bot2 17) and the stack is empty in Bot1's main phase,
# the same Boltwave is cast (the positive control) and Bot2 goes to 14.

[Bot1 Deck]
Mountain
Boltwave
Lightning Bolt
Mountain x17

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
! Bot1.Hand.Boltwave.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
! Bot1.Hand.Boltwave.Cast
Bot1.Pass
Bot2.Pass
? Bot2.Life = 17
Bot1.Battlefield.Mountain#2.Activate
Bot1.Hand.Boltwave.Cast
Bot1.Pass
? Stack.Count = 1
Bot2.Pass
[Bot1.Main2]

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Life = 14
Bot1.Life = 20
Bot1.Graveyard = Boltwave; Lightning Bolt
