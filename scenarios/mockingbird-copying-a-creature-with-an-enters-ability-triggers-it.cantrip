Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Baleful Strix.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Mockingbird.Cast(X: 1)
? Bot1.Hand.Count = 5
Bot1.Pass
Bot1.Accept
[T3 Bot1.Main2]

[Expect]
