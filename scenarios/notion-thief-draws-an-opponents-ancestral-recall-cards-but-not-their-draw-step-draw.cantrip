Bot1.Battlefield.Island.Activate
Bot1.Hand.Notion Thief.Cast
[T2 Bot2.Main1]
? Bot2.Hand.Count = 8
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Ancestral Recall.Cast(Bot2)
[T2 Bot2.Main2]

