# "you've scried": only its controller's scry. Bot2 scries with Opt during Bot1's own turn, in response to Bot1's Mox Jet,
# before attackers are declared, so a scry by any player this turn would turn the permission on. It does not: the
# Phantasm still has defender and may not attack (the refusal) while Ornithopter does (the control).

[Bot1 Deck]
Island
Mox Sapphire
Surveillance Phantasm
Ornithopter
Mox Jet
Island x19

[Bot2 Deck]
Island
Opt
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Surveillance Phantasm.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Mox Jet.Cast
Bot2.Battlefield.Island.Activate
Bot2.Hand.Opt.Cast
Bot2.Arrange(Island)
Bot2.Pass
Bot1.Pass
? Stack.Count = 0
! Bot1.Attack(Surveillance Phantasm > Bot2)
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Surveillance Phantasm.Tapped = false
Bot1.Battlefield.Ornithopter.Tapped = true
Bot2.Graveyard = Opt
