# "you've scried": only its controller's scry. Bot2 casts Preordain on its own turn, so on Bot1's next turn it still has
# defender and may not attack (the refusal).

[Bot1 Deck]
Island
Mox Sapphire
Surveillance Phantasm
Ornithopter
Island x19

[Bot2 Deck]
Island
Preordain
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Surveillance Phantasm.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Preordain.Cast
Bot2.Arrange(Island; Island)
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
! Bot1.Attack(Surveillance Phantasm > Bot2)
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Surveillance Phantasm.Tapped = false
Bot1.Battlefield.Ornithopter.Tapped = true
