# Spell Stutter: "Counter target spell unless its controller pays {2} plus an additional {1} for each Faerie you control."
# Bot2's Lightning Bolt (paid with its only Mox Ruby) meets Bot1's Stutter with no Faerie out: the price is {2}, Bot2 has
# nothing left to pay it with, so the Bolt is countered (CR 118.12) and Bot1 takes no damage.

[Bot1 Deck]
Mox Sapphire
Mox Jet
Spell Stutter
Island x14

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x14

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Spell Stutter.Cast(Stack.Lightning Bolt)
Bot2.Pass
! Bot2.PayCost
Bot2.Decline
[T2 Bot2.Main2]

[Expect]
Bot1.Life = 20
Bot2.Graveyard = Lightning Bolt
Bot1.Graveyard = Spell Stutter
