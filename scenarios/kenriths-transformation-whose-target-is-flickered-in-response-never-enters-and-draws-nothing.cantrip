Bot1.Battlefield.Island.Activate
Bot1.Hand.Kenrith's Transformation.Cast(Llanowar Elves)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Ephemerate.Cast(Llanowar Elves)
[T3 Bot1.Main2]
? Bot1.Graveyard = Kenrith's Transformation
[T4 Bot2.Main1]
Bot2.Battlefield.Llanowar Elves.Activate

