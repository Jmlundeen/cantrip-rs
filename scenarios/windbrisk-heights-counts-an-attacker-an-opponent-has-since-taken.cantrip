Bot1.Hand.Windbrisk Heights.Play
Bot1.Arrange(Plains | Island; Island; Island)
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
