# Forge Anew's equip text is about "your turn" and "you": Bot1 controls it, but on Bot2's turn 2 Bot2 equips its own Bloodforged
# Battle-Axe to its Ragavan at sorcery speed and pays the whole Equip {2} - the Island and a Mox end up tapped (CR 118.9, 602.2b).

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Ruby
Forge Anew
Island x12

[Bot2 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Ragavan, Nimble Pilferer
Bloodforged Battle-Axe
Island x12

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Forge Anew.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Ragavan, Nimble Pilferer.Cast
Bot2.Pass
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Bloodforged Battle-Axe.Cast
Bot2.Pass
[T2 Bot2.Main2]
? Bot2.Battlefield.Mox Pearl.Tapped = false
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Bloodforged Battle-Axe.Activate(Ragavan, Nimble Pilferer; Ability: Equip)
Bot2.Pass
[T2 Bot2.End]

[Expect]
Bot2.Battlefield.Bloodforged Battle-Axe.AttachedTo = Ragavan, Nimble Pilferer
Bot2.Battlefield.Mox Pearl.Tapped = true
Bot2.Battlefield.Island.Tapped = true
