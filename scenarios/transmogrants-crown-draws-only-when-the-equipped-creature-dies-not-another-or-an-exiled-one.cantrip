Bot2.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Llanowar Elves)
[T2 Bot2.Main2]

[Expect]
Bot1.Hand.Count = 0
Bot1.Graveyard = Ornithopter
Exile = Llanowar Elves
Bot1.Battlefield.Transmogrant's Crown.AttachedTo = (absent)
