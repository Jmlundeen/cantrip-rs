Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Transmogrant's Crown.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Transmogrant's Crown.Activate(Bot1.Battlefield.Llanowar Elves; Ability: Equip {B})
[T1 Bot1.Main2]
? Bot1.Battlefield.Llanowar Elves.Power = 3
? Bot1.Hand.Count = 0
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Mox Pearl.Cast
