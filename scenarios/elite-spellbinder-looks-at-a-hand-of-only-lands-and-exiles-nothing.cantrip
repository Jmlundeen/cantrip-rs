# Elite Spellbinder: "Look at target opponent's hand. You may exile a nonland card from it." Looking is part of the ability, so Bot1 is
# shown Bot2's hand and asked even though every card in it is an Island and none can be chosen (the Choose() line waits for that question,
# so the scenario fails if Bot1 is never asked). It chooses nothing and nothing is exiled. The positive control is
# elite-spellbinder-exiles-a-card-its-owner-may-cast-for-two-more.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Jet
Elite Spellbinder
Plains x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Elite Spellbinder.Cast
Bot1.Pass
Bot2.Pass
Bot1.Choose()
[Bot1.Main2]

[Expect]
Exile.Count = 0
Bot2.Hand.Count = 7
