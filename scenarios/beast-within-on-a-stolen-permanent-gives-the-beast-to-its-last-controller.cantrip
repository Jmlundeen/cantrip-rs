# "Its controller creates a 3/3 green Beast" is the destroyed permanent's controller as it last existed on the battlefield
# (CR 608.2h), not its owner: Bot1 takes Bot2's Memnite with Act of Treason on turn 3 and destroys it with Beast Within.
# The Memnite goes to its owner's graveyard (CR 701.8a), and the Beast is Bot1's - Bot2 gets nothing.

[Bot1 Deck]
Mox Emerald
Mox Ruby
Mox Pearl
Mox Sapphire
Mox Jet
Mountain
Act of Treason
Beast Within
Island x8

[Bot2 Deck]
Memnite
Island x16

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Act of Treason.Cast(Bot2.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Beast Within.Cast(Bot1.Battlefield.Memnite)
? Bot1.Mana =
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Stack.Count = 0
Bot2.Graveyard = Memnite
Bot1.Battlefield.Beast Token.Power = 3
Bot1.Battlefield.Beast Token.Toughness = 3
Bot2.Battlefield.Count = 0
