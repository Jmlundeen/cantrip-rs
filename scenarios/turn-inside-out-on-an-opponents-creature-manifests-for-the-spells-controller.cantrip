[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Turn Inside Out.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Llanowar Elves.Power = 4
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
