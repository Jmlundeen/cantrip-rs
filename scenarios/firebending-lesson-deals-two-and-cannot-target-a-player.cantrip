# Firebending Lesson: "deals 2 damage to target creature." Bot1 has only a Mox Ruby, so it pays {R} and not the {4} of
# the kicker: an unkicked cast
# one deals 2 damage to Bot2's Picklock Prankster (toughness 3), which survives with 2 damage marked. A player is not a
# legal target (the creature in "target creature"): refused beside the creature, which is the positive control.

[Bot1 Deck]
Mox Ruby
Firebending Lesson
Island x18

[Bot2 Deck]
Mox Sapphire
Mox Jet
Picklock Prankster
Island x17

[Actions]
Bot1.Hand.Mox Ruby.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Picklock Prankster.Cast
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
! Bot1.Hand.Firebending Lesson.Cast(Bot2)
Bot1.Hand.Firebending Lesson.Cast(Bot2.Battlefield.Picklock Prankster)

[Expect]
Bot2.Battlefield.Picklock Prankster.Damage = 2
Bot2.Graveyard.Count = 0
Bot2.Life = 20
Bot1.Graveyard = Firebending Lesson
