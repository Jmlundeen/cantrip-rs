# Painter's Servant's own "As this creature enters, choose a color" (CR 614.1c, 614.12a) and Tayam, Luminous Enigma's
# "each other creature you control enters with an additional vigilance counter" both modify how the Servant enters: Bot1,
# its controller, is asked which applies first (CR 616.1), answers Tayam's, then still chooses the color as the Servant's
# own applies after it (CR 616.1f). It enters with the vigilance counter and Red chosen.

[Bot1 Deck]
Mox Pearl
Mox Jet
Mox Emerald
Mox Ruby
Tayam, Luminous Enigma
Painter's Servant
Plains x14

[Bot2 Deck]
Forest x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Tayam, Luminous Enigma.Cast
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Painter's Servant.Cast
Bot1.Pass
Bot2.Pass
Bot1.Replace(Tayam, Luminous Enigma)
Bot1.Colors(Red)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Painter's Servant.Counters.Vigilance = 1
Bot1.Battlefield.Painter's Servant.ChosenColor = Red
