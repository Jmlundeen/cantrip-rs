# Scalding Viper's Adventure (CR 715): Steam Clean, {1}{U} sorcery, "Return target nonland permanent to its owner's hand" -
# any player's, not only an opponent's. On turn 1 Bot1 casts it from hand for {1}{U} (Mox Sapphire and Mox Ruby): a land is
# refused as a target (Bot1's Mountain), and it returns Bot1's own Mox Pearl. While it is on the stack it is Steam Clean, and as
# it resolves it is exiled rather than put into the graveyard. On turn 3 Bot1 casts the Viper itself from exile for {1}{R}.

[Bot1 Deck]
Mox Ruby
Mox Sapphire
Mox Pearl
Mountain
Scalding Viper
Swamp x15

[Bot2 Deck]
Swamp x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
! Bot1.Hand.Scalding Viper.Cast(Mountain; Ability: Adventure)
Bot1.Hand.Scalding Viper.Cast(Mox Pearl; Ability: Adventure)
? Stack = Steam Clean
Bot1.Pass
Bot2.Pass
? Exile = Scalding Viper
? Bot1.Battlefield = Mountain; Mox Ruby; Mox Sapphire
[T3 Bot1.Main1]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Exile.Scalding Viper.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Exile.Count = 0
Bot1.Graveyard.Count = 0
Bot1.Battlefield.Scalding Viper.Power = 2
Bot1.Battlefield.Scalding Viper.Toughness = 1
Bot1.Battlefield.Mountain.Tapped = false
