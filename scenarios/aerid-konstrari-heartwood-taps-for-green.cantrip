# The Heartwood token's mana ability offers green as well as red (CR 106.5): the same activation, naming green, adds
# {G}; white is refused. Aerid Konstrari makes the token as it enters.

[Bot1 Deck]
Forest
Mox Ruby
Mox Emerald
Mox Emerald
Aerid Konstrari
Forest
Forest
Forest x10

[Bot2 Deck]
Plains x17

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Aerid Konstrari.Cast
[T3 Bot1.Main1]
! Bot1.Battlefield.Heartwood Token.Activate(Color: White)
Bot1.Battlefield.Heartwood Token.Activate(Color: Green)
? Bot1.Mana = {G}

[Expect]
Bot1.Battlefield.Heartwood Token.Tapped = true
