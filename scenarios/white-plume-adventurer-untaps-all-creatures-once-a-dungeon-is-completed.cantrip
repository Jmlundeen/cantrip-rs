# White Plume Adventurer: "At the beginning of each opponent's upkeep, untap a creature you control. If you've completed a dungeon, untap all
# creatures you control instead." The Undercity is completed on turn 5 as in undermountain-adventurer-adds-six-green-once-its-controller-completes-
# the-undercity (three initiative ventures and two more from the Adventurers entering). Bot1 then attacks with the White Plume Adventurer and the
# Undermountain Adventurer, which tap; at the beginning of Bot2's turn-6 upkeep both untap, not just one chosen creature.

[Bot1 Deck]
Forest
Mox Emerald
Mox Pearl
Mox Ruby
Undermountain Adventurer
White Plume Adventurer
Caves of Chaos Adventurer
Plains
Forest x20

[Bot2 Deck]
Forest x15

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Undermountain Adventurer.Cast
Bot1.Search(Plains)
? Bot1.Dungeon = Undercity: Secret Entrance
[T3 Bot1.Upkeep]
Bot1.Modes(Lost Well)
[T3 Bot1.Main1]
? Bot1.Dungeon = Undercity: Lost Well
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.White Plume Adventurer.Cast
Bot1.Modes(Stash)
[T3 Bot1.Main1]
? Bot1.Dungeon = Undercity: Stash
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Undermountain Adventurer.Activate
? Bot1.Mana = {W}{R}{G}{G}
Bot1.Hand.Caves of Chaos Adventurer.Cast
[T3 Bot1.Main2]
? Bot1.Dungeon = Undercity: Catacombs
[T5 Bot1.Main1]
Bot1.Attack(White Plume Adventurer; Caves of Chaos Adventurer > Bot2)
[T5 Bot1.Main2]
? Bot1.Battlefield.White Plume Adventurer.Tapped = true
? Bot1.Battlefield.Caves of Chaos Adventurer.Tapped = true
[T6 Bot2.Draw]

[Expect]
Bot1.DungeonsCompleted = 1
Bot1.Battlefield.White Plume Adventurer.Tapped = false
Bot1.Battlefield.Caves of Chaos Adventurer.Tapped = false
