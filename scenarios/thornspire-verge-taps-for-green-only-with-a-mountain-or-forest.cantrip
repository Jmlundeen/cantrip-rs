! Bot1.Battlefield.Thornspire Verge.Activate(Ability: {G})
Bot1.Battlefield.Thornspire Verge.Activate(Ability: {R})
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Thornspire Verge.Activate(Ability: {G})

