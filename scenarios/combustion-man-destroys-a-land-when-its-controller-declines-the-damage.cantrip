Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Combustion Man.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Attack(Combustion Man > Bot2)
Bot1.Target(Bot2.Battlefield.Forest)
Bot1.Pass
Bot2.Decline

[Expect]
