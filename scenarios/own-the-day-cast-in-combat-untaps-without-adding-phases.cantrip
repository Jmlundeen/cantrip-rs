# Brazen Bluff permits Own the Day to be cast during combat (CR 608.2g). The spell untaps the Firebrand
# that just attacked, but "after this main phase" adds no phases when it resolves outside a main phase (CR 500.8).
# The ordinary postcombat main leads to the end step, with no added combat.

[Bot1 Deck]
Mox Ruby
Black Lotus
Fanatical Firebrand
Own the Day
Brazen Bluff
Sol Ring
Mountain
Mountain x24

[Bot2 Deck]
Island
Opt
Island x28

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Fanatical Firebrand.Cast
Bot1.Pass
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Fanatical Firebrand)
Bot2.Battlefield.Island.Activate
Bot2.Hand.Opt.Cast
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Brazen Bluff.Cast(Opt)
Bot1.Pass
Bot2.Pass
Bot2.Decline
Bot1.Choose(Own the Day)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Fanatical Firebrand.Tapped = false
[T3 Bot1.Main2]
Bot1.Pass
Bot2.Pass
? Step = End

[Expect]
Bot2.Life = 19
Bot1.Graveyard = Own the Day; Brazen Bluff; Black Lotus
