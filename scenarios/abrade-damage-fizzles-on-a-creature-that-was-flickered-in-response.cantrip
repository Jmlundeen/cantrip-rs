# Abrade: its target is checked again as it resolves (CR 608.2b), and an object that leaves and returns is a new object
# (CR 400.7). On turn 3 Bot1 aims the damage mode at Bot2's Elvish Mystic; in response Bot2 pays {W} (Mox Pearl) for
# Ephemerate on it. The Mystic returns as a new object, which Abrade's target no longer is, so the spell does nothing:
# the 1/1 Mystic is alive with no damage and summoning sick.

[Bot1 Deck]
Mountain
Mox Ruby
Abrade
Island
Island x20

[Bot2 Deck]
Forest
Mox Pearl
Elvish Mystic
Ephemerate
Island x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Elvish Mystic.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Abrade.Cast
Bot1.Modes(Abrade deals 3 damage)
Bot1.Target(Elvish Mystic)
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Ephemerate.Cast(Elvish Mystic)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Elvish Mystic.Damage = 0
Bot2.Battlefield.Elvish Mystic.SummoningSick = true
Bot1.Graveyard = Abrade
