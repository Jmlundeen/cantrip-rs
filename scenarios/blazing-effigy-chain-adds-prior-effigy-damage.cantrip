# The first Effigy's death deals 3 to another Effigy, which dies and deals 6 to the opposing Wall.
# Damage from Lightning Bolt is not counted, and a player cannot be targeted by the trigger.

[Bot1 Deck]
Black Lotus
Mox Ruby
Blazing Effigy x2
Lightning Bolt
Mountain x15

[Bot2 Deck]
Black Lotus
Wall of Granite
Mountain x18

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Blazing Effigy.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Blazing Effigy.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Hand.Wall of Granite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Blazing Effigy#1)
Bot1.Pass
Bot2.Pass
! Bot1.Target(Bot2)
Bot1.Target(Bot1.Battlefield.Blazing Effigy)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Wall of Granite.Damage = 6
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Wall of Granite.Toughness = 7
Bot1.Graveyard.Count = 4
