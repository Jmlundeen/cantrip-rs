# "Search your library for a card" (CR 701.23): an empty library has
# nothing to find. Bot1's whole deck is the seven-card opening hand, so on turn 1 the library is empty when Demonic Tutor
# resolves: no card is added to the hand and nothing breaks. Two Moxen pay {1}{B}.

[Bot1 Deck]
Demonic Tutor
Mox Jet
Mox Ruby
Lightning Bolt
Island x3

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Demonic Tutor.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Library.Count = 0
Bot1.Hand = Lightning Bolt; Island; Island; Island
Bot1.Graveyard = Demonic Tutor
