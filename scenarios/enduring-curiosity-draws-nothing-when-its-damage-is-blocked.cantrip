# "deals combat damage to a player": on turn 3 Enduring Curiosity attacks and Bot2's Llanowar Elves block it, so its damage goes to a
# creature and Bot1 draws nothing (its hand is 2: the turn's draw and the Island it did not play).

[Bot1 Deck]
Island
Mox Sapphire
Mox Pearl
Mox Jet
Mox Ruby
Enduring Curiosity
Island
Island x13

[Bot2 Deck]
Forest
Llanowar Elves
Forest x13

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Enduring Curiosity.Cast
Bot1.Pass
[T2 Bot2.Main2]
? Bot1.Battlefield.Enduring Curiosity.Types = Enchantment; Creature
[T3 Bot1.Main1]
Bot1.Attack(Enduring Curiosity > Bot2)
Bot2.Block(Llanowar Elves > Enduring Curiosity)
[T3 Bot1.Main2]

[Expect]
Bot1.Hand.Count = 2
Bot2.Life = 20
Bot2.Graveyard = Llanowar Elves
