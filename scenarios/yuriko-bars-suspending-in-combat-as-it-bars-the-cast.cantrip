[T3 Bot1.BeginCombat]
? Bot1.Hand = Lotus Bloom
! Bot1.Hand.Lotus Bloom.Suspend
? Step = BeginCombat
[T3 Bot1.End]
Bot1.Hand.Lotus Bloom.Suspend
? Step = End

[Expect]
Bot1.Hand.Count = 0
Bot1.Exile.Lotus Bloom.Counters.Time = 3
