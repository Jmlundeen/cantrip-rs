Bot2.Battlefield.Plains#1.Activate
Bot2.Battlefield.Plains#2.Activate
Bot2.Hand.Disenchant.Cast(Spellskite)
[T6 Bot2.Main2]

[Expect]
Bot1.Life = 17
Bot1.Graveyard = Spellskite
Bot2.Graveyard = Lightning Bolt; Disenchant
