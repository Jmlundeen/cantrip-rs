Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Spellskite.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T5 Bot1.Main1]
Bot1.Hand.Plains.Play
[T6 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Battlefield.Spellskite.Activate(Stack.Lightning Bolt)
Bot1.Modes()
