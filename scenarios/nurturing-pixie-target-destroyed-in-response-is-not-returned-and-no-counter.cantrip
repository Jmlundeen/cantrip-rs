Bot1.Battlefield.Plains.Activate
Bot1.Pass
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Hand.Nurturing Pixie.Cast
Bot1.Battlefield.Plains#1.Activate
Bot1.Target(Thraben Inspector)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Thraben Inspector)
Bot2.Battlefield.Mox Ruby.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Hand.Nurturing Pixie.Cast
Bot1.Battlefield.Plains#2.Activate
Bot1.Target(Clue Token)
Bot1.Pass
Bot1.Pass

