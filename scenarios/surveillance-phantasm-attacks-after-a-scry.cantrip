Bot1.Battlefield.Island.Activate
Bot1.Hand.Surveillance Phantasm.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Sylvan Caryatid.Cast
