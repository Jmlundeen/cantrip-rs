Bot1.Battlefield.Mox Pearl.Activate
Bot1.Exile.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 17
Bot2.Graveyard = Lightning Bolt; Dress Down
Exile.Count = 0
