Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Null Summoner.Cast
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Choose(Lightning Bolt)
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot2.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Brain Freeze.Cast(Bot1)
Bot1.Target(Bot1)
Bot1.Target(Bot1)
Bot1.Target(Bot1)
Bot1.Target(Bot1)
Bot1.Target(Bot1)
[T2 Bot2.Main1]
? Bot1.Graveyard.Count = 20
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
