# Underground River prints two mana abilities (CR 605.1a): "{T}: Add {C}." costs nothing, while "{T}: Add {U} or {B}. This
# land deals 1 damage to you." deals the damage as it resolves (a mana ability, CR 605.4a) and names its color as it is
# activated (CR 106.5). Bot1 taps it for {C} on turn 3 and stays at 20, for {U} on turn 5 and for {B} on turn 7, one damage
# each. The colored ability refuses green beside the blue it does add (the {U} activation is the positive control), and the
# colorless ability takes no color at all.

[Bot1 Deck]
Underground River
Island x15

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Underground River.Play
[T3 Bot1.Main1]
! Bot1.Battlefield.Underground River.Activate(Ability: {U} or {B}; Color: Green)
! Bot1.Battlefield.Underground River.Activate(Ability: {C}; Color: Blue)
Bot1.Battlefield.Underground River.Activate(Ability: {C})
? Bot1.Mana = {C}
? Bot1.Life = 20
[T5 Bot1.Main1]
Bot1.Battlefield.Underground River.Activate(Ability: {U} or {B}; Color: Blue)
? Bot1.Mana = {U}
? Bot1.Life = 19
[T7 Bot1.Main1]
Bot1.Battlefield.Underground River.Activate(Ability: {U} or {B}; Color: Black)
? Bot1.Mana = {B}
? Bot1.Life = 18

[Expect]
Turn = 7
Bot1.Battlefield.Underground River.Tapped = true
Bot1.Life = 18
