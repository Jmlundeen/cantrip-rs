# Lightstall Inquisitor: Bot2 exiles a Forest from its hand and plays it from exile on its turn. "Each land played this way
# enters tapped" (CR 614.1d), and playing it is Bot2's land play for the turn (CR 305.2): the Forest still in its hand can't
# be played after it. The game ends in that main phase, so the Forest is still tapped.

[Bot1 Deck]
Plains
Lightstall Inquisitor
Plains x15

[Bot2 Deck]
Forest
Forest
Island x15

[Actions]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Lightstall Inquisitor.Cast
Bot2.Choose(Forest)
[T2 Bot2.Main1]
? Exile = Forest
Bot2.Exile.Forest.Play
! Bot2.Hand.Forest.Play
[T2 Bot2.Main2]

[Expect]
Turn = 2
Exile.Count = 0
Bot2.Battlefield = Forest
Bot2.Battlefield.Forest.Tapped = true
Bot2.LandsPlayed = 1
Bot2.Hand = Forest; Island; Island; Island; Island; Island; Island
