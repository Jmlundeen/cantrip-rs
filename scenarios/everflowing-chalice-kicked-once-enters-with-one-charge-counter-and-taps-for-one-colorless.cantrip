# Kicked once, Everflowing Chalice enters with one charge counter and adds a single {C}.

[Bot1 Deck]
Mox Ruby
Mox Emerald
Everflowing Chalice
Island x10

[Bot2 Deck]
Swamp x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Everflowing Chalice.Cast(Kicked: 1)
[Bot1.Main2]
? Bot1.Battlefield.Everflowing Chalice.Counters.Charge = 1
[T3 Bot1.Main1]
Bot1.Battlefield.Everflowing Chalice.Activate
? Bot1.Mana = {C}

[Expect]
Bot1.Battlefield.Everflowing Chalice.Counters.Charge = 1
Stack.Count = 0
