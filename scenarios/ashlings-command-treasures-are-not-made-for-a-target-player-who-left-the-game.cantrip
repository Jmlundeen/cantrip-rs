# Ashling's Command, modes 3 and 4 in a game of three, CR 608.2b and 800.4a: Bot1 targets Bot2 for the damage and Bot3 for the two
# Treasures. In response Bot3, whose library is empty, casts Ancestral Recall on itself and loses the game. The second target is
# illegal, so no Treasure tokens are created for anyone (none appear on Bot3's side or Bot1's or Bot2's); the first mode still
# resolves and Bot2's Ornithopter takes 2 damage and dies.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Black Lotus
Ashling's Command
Plains x20

[Bot2 Deck]
Ornithopter
Island x20

[Bot3 Deck]
Mox Sapphire
Ancestral Recall
Island x5
Island

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot3.Main1]
Bot3.Hand.Mox Sapphire.Cast
[T4 Bot1.Main1]
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Ashling's Command.Cast
Bot1.Modes(3; 4)
Bot1.Target(Bot2)
Bot1.Target(Bot3)
Bot2.Pass
Bot3.Battlefield.Mox Sapphire.Activate
Bot3.Hand.Ancestral Recall.Cast(Bot3)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot3.Status = Lost
Bot2.Battlefield.Count = 0
Bot2.Graveyard = Ornithopter
Bot1.Battlefield = Mox Sapphire; Mox Ruby
Stack.Count = 0
