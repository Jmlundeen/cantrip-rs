# Crater is in the graveyard, not on the battlefield, and the hand is the same size.

[Bot1 Deck]
Mox Ruby
Footfall Crater
Mountain x13

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
