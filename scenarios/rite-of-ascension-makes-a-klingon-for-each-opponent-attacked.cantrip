# Rite of Ascension's "for each opponent you attacked this turn" (CR 508.6, 508.4): in a game of three, Bot1 attacks
# Bot2 and Bot3 with two Ornithopters, so the one "Whenever you attack" trigger creates one 2/1 red Klingon Warrior
# token for each of the two opponents. The tokens enter tapped and attacking, and Bot1 chooses Bot2 for one and Bot3
# for the other. Black Lotus pays for the {2}{R}{W} enchantment on turn 1; the first player in a three-player game
# draws on turn 1 (CR 103.8c), and Bot1's next turn is turn 4.

[Bot1 Deck]
Rite of Ascension
Black Lotus
Mox Ruby
Ornithopter
Ornithopter
Plains
Island x20

[Bot2 Deck]
Island x20

[Bot3 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rite of Ascension.Cast
Bot1.Pass
? Bot1.Mana =
[T4 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2; Ornithopter#2 > Bot3)
Bot1.Target(Bot2)
Bot1.Target(Bot3)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Combat.Attackers = Klingon Warrior Token > Bot2; Klingon Warrior Token > Bot3; Ornithopter > Bot2; Ornithopter > Bot3
? Bot1.Battlefield.Klingon Warrior Token#1.Power = 2
? Bot1.Battlefield.Klingon Warrior Token#1.Toughness = 1
? Bot1.Battlefield.Klingon Warrior Token#1.Colors = Red
? Bot1.Battlefield.Klingon Warrior Token#1.Subtypes = Klingon; Warrior
? Bot1.Battlefield.Klingon Warrior Token#1.Keywords = Haste
? Bot1.Battlefield.Klingon Warrior Token#1.Tapped = true
[T4 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot3.Life = 18
Bot1.Battlefield.Klingon Warrior Token#1.Power = 2
Bot1.Battlefield.Klingon Warrior Token#1.Toughness = 1
Bot1.Battlefield.Klingon Warrior Token#1.Colors = Red
Bot1.Battlefield.Klingon Warrior Token#1.Subtypes = Klingon; Warrior
Bot1.Battlefield.Klingon Warrior Token#1.Keywords = Haste
Bot1.Battlefield.Klingon Warrior Token#1.Tapped = true
