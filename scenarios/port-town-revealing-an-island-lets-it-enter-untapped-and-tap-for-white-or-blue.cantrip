# Port Town: "As this land enters, you may reveal a Plains or Island card from your hand. If you don't, this land
# enters tapped. {T}: Add {W} or {U}" (CR 614.1d, 701.20a, 605.1a). Bot1 reveals an Island, so it enters untapped; on
# turns 3 and 5 it taps for {W} and for {U}, each the single mana the {T} cost buys, and it offers no green.

[Bot1 Deck]
Port Town
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Port Town.Play
Bot1.Accept
Bot1.Choose(Island)
? Bot1.Revealed = Island
? Bot2.Revealed = (absent)
? Bot1.Battlefield.Port Town.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Port Town.Activate(Color: White)
? Bot1.Mana = {W}
[T5 Bot1.Main1]
! Bot1.Battlefield.Port Town.Activate(Color: Green)
Bot1.Battlefield.Port Town.Activate(Color: Blue)
? Bot1.Mana = {U}

[Expect]
Turn = 5
Bot1.Battlefield.Port Town.Tapped = true
