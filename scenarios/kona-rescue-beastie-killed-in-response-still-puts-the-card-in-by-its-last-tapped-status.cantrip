# Kona, Rescue Beastie: the intervening "if Kona is tapped" is checked again as the ability resolves, and a Kona that has left the
# battlefield is judged by the status it last had there (CR 603.4, 608.2h; the ruling: "use its tapped or untapped status as it
# last existed on the battlefield"). Kona attacks on turn 3 and is tapped; with the trigger on the stack Bot2 kills it with
# Lightning Bolt (3 damage to a 4/3). The ability still resolves and Bot1 puts Sol Ring onto the battlefield.

[Bot1 Deck]
Mox Emerald
Mox Jet
Mox Pearl
Mox Ruby
Kona, Rescue Beastie
Lightning Bolt
Lightning Bolt
Sol Ring
Island x20

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Swamp x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Kona, Rescue Beastie.Cast
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Attack(Kona, Rescue Beastie > Bot2)
[T3 Bot1.Main2]
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Kona, Rescue Beastie)
Bot1.Pass
Bot2.Pass
? Bot1.Graveyard = Kona, Rescue Beastie
Bot1.Choose(Sol Ring)
[T3 Bot1.End]

[Expect]
Bot1.Graveyard = Kona, Rescue Beastie
Bot1.Battlefield.Sol Ring.Tapped = false
Bot1.Hand = Lightning Bolt; Lightning Bolt
Bot2.Graveyard = Lightning Bolt
