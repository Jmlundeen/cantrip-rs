Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Swamp.Activate
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Damn.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp.Activate
[T4 Bot2.Main1]
Bot1.Hand.Necromancy.Cast
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Sol Ring.Activate
[T4 Bot2.End]
? Bot1.Battlefield = Swamp; Swamp; Mox Jet; Mox Sapphire; Sol Ring; Necromancy; Ornithopter
? Delayed.Count = 1
[T4 Bot2.Cleanup]
? Stack.Count = 1
? Bot1.Battlefield.Necromancy.Subtypes = Aura
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Stifle.Cast(Stack.Necromancy)
[T5 Bot1.Main1]

[Expect]
Turn = 5
Delayed.Count = 0
Bot1.Graveyard = Stifle; Damn
Bot2.Graveyard.Count = 0
