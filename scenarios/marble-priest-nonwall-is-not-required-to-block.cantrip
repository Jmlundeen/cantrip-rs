# A non-Wall is not required to block Marble Priest: Hill Giant may decline to block
# and the Priest deals three combat damage (CR 509.1c).
[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Sapphire
Marble Priest
Island x20

[Bot2 Deck]
Black Lotus
Mox Ruby
Hill Giant
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Marble Priest.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Hill Giant.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Marble Priest > Bot2)
Bot2.Block()
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
Bot2.Battlefield.Hill Giant.Power = 3
Bot1.Battlefield.Marble Priest.Power = 3
