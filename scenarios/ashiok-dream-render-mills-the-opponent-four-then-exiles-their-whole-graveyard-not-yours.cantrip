# Ashiok, Dream Render -1: "Target player mills four cards. Then exile each opponent's graveyard." Each player has a
# Lightning Bolt in their graveyard first; Bot1 mills Bot2 and the four milled cards are in Bot2's graveyard when it is exiled
# (so Exile is Bot2's Bolt and four Islands), while Bot1's own graveyard (its Bolt) stays: "each opponent's" only.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Sapphire
Lightning Bolt
Ashiok, Dream Render
Island x2
Island x10

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x5
Island x10

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Ashiok, Dream Render.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Pass
Bot1.Battlefield.Ashiok, Dream Render.Activate(Bot2)
Bot1.Pass

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Graveyard = Lightning Bolt
Bot2.Graveyard.Count = 0
Exile.Count = 5
Exile = Island; Island; Island; Island; Lightning Bolt
Bot2.Library.Count = 5
Bot1.Battlefield.Ashiok, Dream Render.Counters.Loyalty = 4
