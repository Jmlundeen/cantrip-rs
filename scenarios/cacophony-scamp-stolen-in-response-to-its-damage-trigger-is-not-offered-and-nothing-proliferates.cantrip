Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Cacophony Scamp.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Old Man of the Sea.Cast
Bot2.Pass
[T4 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Island.Activate
Bot2.Hand.Liliana of the Veil.Cast
Bot2.Pass
[T5 Bot1.Main1]
Bot1.Attack(Cacophony Scamp > Bot2)
[T5 Bot1.CombatDamage]
Bot1.Pass
Bot2.Battlefield.Old Man of the Sea.Activate(Bot1.Battlefield.Cacophony Scamp)
Bot2.Pass
Bot1.Pass
? Stack.Count = 1
? Bot2.Battlefield.Cacophony Scamp.Tapped = true
Bot1.Pass
Bot2.Pass
! Bot1.Accept
[T5 Bot1.Main2]

