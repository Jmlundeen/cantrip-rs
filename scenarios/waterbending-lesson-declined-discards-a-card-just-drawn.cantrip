# "Draw three cards. Then discard a card unless you waterbend {2}": the draw comes first (CR 608.2c), so declining to waterbend leaves a discard that may be one of the cards just
# drawn (Mox Jet), though Bot1 has two Islands in hand besides. Memnite and Ornithopter stay untapped.

[Bot1 Deck]
Black Lotus
Island
Memnite
Ornithopter
Waterbending Lesson
Island
Island
Mox Jet
Mox Pearl
Mox Ruby
Island x20

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Memnite.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Island.Activate
Bot1.Hand.Waterbending Lesson.Cast
Bot1.Pass
Bot2.Pass
Bot1.Decline
Bot1.Choose(Mox Jet)
[T1 Bot1.Main2]

[Expect]
Bot1.Hand.Count = 4
Bot1.Graveyard = Waterbending Lesson; Mox Jet; Black Lotus
Bot1.Battlefield.Memnite.Tapped = false
Bot1.Battlefield.Ornithopter.Tapped = false
