# Narset, Jeskai Waymaster: the discard is optional. Bot1 casts three Moxen and Narset, holds the rest of its hand at the end step and declines, so it keeps
# every card and draws none.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Pearl
Narset, Jeskai Waymaster
Island
Island
Island
Island x20

[Bot2 Deck]
Island x30

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Narset, Jeskai Waymaster.Cast
Bot1.Pass
Bot2.Pass
[T1 Bot1.End]
Bot1.Decline
[T2 Bot2.Main1]

[Expect]
Bot1.Hand.Count = 3
Bot1.Graveyard.Count = 0
