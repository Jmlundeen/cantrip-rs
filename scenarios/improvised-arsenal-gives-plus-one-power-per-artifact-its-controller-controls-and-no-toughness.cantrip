# Improvised Arsenal: "Equipped creature gets +1/+0 for each artifact you control" (CR 613.4c). On turn 1 Bot1 controls seven artifacts
# (two Mox Rubies, Mox Jet, Mox Pearl, two Ornithopters and the Arsenal itself), so the equipped 0/2 Ornithopter is a 7/2 and the other
# Ornithopter stays 0/2 (only the equipped creature). Bot2's own Mox Pearl on turn 2 is not an artifact Bot1 controls: the power stays 7.
# On turn 3 it attacks and deals 7.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Jet
Mox Pearl
Ornithopter
Ornithopter
Improvised Arsenal
Plains x12

[Bot2 Deck]
Mox Pearl
Plains x13

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Improvised Arsenal.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Improvised Arsenal.Activate(Bot1.Battlefield.Ornithopter#1)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#1.Power = 7
? Bot1.Battlefield.Ornithopter#1.Toughness = 2
? Bot1.Battlefield.Ornithopter#2.Power = 0
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Ornithopter#1.Power = 7
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 13
