# Konstrari Charm, second mode: "Put two +1/+1 counters on target creature. It gains trample until end of turn." The target is any
# creature, an opponent's too: Bot2's Llanowar Elves becomes a 3/3 with trample for the turn (the layers sort the keywords), and on
# Bot2's next turn (turn 4) the trample is gone while the counters stay.

[Bot1 Deck]
Mox Ruby
Mox Emerald
Konstrari Charm
Plains x17

[Bot2 Deck]
Mox Emerald
Llanowar Elves
Plains x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Konstrari Charm.Cast
Bot1.Modes(2)
Bot1.Target(Llanowar Elves)
Bot2.Pass
? Bot2.Battlefield.Llanowar Elves.Power = 3
? Bot2.Battlefield.Llanowar Elves.Toughness = 3
? Bot2.Battlefield.Llanowar Elves.Keywords = Trample
[T4 Bot2.Main1]

[Expect]
Bot2.Battlefield.Llanowar Elves.Counters.PlusOnePlusOne = 2
