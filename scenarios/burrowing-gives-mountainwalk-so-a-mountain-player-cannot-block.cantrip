# Burrowing gives its creature mountainwalk (CR 702.14c): Bot2 controls a Mountain, so its Ornithopter may not block the
# enchanted Grizzly Bears (the refusal is the point: with no Mountain the same block is legal, see the sibling scenario).
# The unblocked Bears deal 2.

[Bot1 Deck]
Mountain
Mox Ruby
Mox Emerald
Grizzly Bears
Burrowing
Mountain x20

[Bot2 Deck]
Mountain
Ornithopter
Mountain x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Grizzly Bears.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Burrowing.Cast(Bot1.Battlefield.Grizzly Bears)
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Grizzly Bears > Bot2)
! Bot2.Block(Ornithopter > Bot1.Battlefield.Grizzly Bears)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Burrowing.AttachedTo = Grizzly Bears
Bot1.Battlefield.Grizzly Bears.Keywords = Mountainwalk
# Only the enchanted creature walks (CR 303.4): Bot2's Ornithopter keeps its flying alone.
Bot2.Battlefield.Ornithopter.Keywords = Flying
Bot2.Life = 18
