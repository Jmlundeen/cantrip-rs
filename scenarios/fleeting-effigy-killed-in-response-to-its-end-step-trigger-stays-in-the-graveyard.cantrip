# Fleeting Effigy: its end-step trigger returns "this creature" only while it is still the object that was on the battlefield
# (CR 400.7). Bot2 bolts it with the trigger on the stack; the Effigy is a new object in the graveyard and stays there, not in
# Bot1's hand.

[Bot1 Deck]
Mountain
Mountain
Fleeting Effigy
Mountain x15

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot1.Pass
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Fleeting Effigy.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.End]
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Fleeting Effigy)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Graveyard = Fleeting Effigy
Bot1.Hand.Count = 5
Bot1.Battlefield = Mountain; Mountain
