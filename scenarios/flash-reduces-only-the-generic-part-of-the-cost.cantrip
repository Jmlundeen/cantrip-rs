# Flash reduces the generic part of a creature's mana cost by {2} and nothing else (CR 601.2f): Dauthi Voidwalker ({B}{B}) has none,
# so Bot1 must pay the full {B}{B} (two Mox Jets) to keep it. Nothing is left in the pool afterwards.

[Bot1 Deck]
Island
Mox Sapphire
Mox Jet
Mox Jet
Flash
Dauthi Voidwalker
Island x2
Island x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Flash.Cast
Bot1.Choose(Dauthi Voidwalker)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Jet#2.Activate
Bot1.PayCost

[Expect]
Turn = 1
Stack.Count = 0
Bot1.Graveyard = Flash
Bot1.Mana = 
Bot1.Battlefield.Dauthi Voidwalker.Power = 3
