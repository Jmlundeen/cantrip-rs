# Hide on the Ceiling with one target (X = 1): if it is illegal as the spell resolves the spell does not resolve (CR 608.2b), so nothing is exiled and no delayed
# triggered ability is created (CR 603.7): Bot2 Lightning Bolts its own Llanowar Elves in response; the end step returns nothing (Delayed.Count = 0 afterwards, the Elves
# stays in the graveyard).

[Bot1 Deck]
Mox Sapphire
Mox Jet
Hide on the Ceiling
Plains x4
Plains x13

[Bot2 Deck]
Forest
Mox Ruby
Llanowar Elves
Lightning Bolt
Forest x12

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Hide on the Ceiling.Cast(X: 1)
Bot1.Target(Bot2.Battlefield.Llanowar Elves)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Llanowar Elves)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]
? Delayed.Count = 0
? Exile.Count = 0
[T3 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Delayed.Count = 0
Exile.Count = 0
Bot2.Graveyard = Llanowar Elves; Lightning Bolt
Bot2.Battlefield = Forest; Mox Ruby
Bot1.Graveyard = Hide on the Ceiling
