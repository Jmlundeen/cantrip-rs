Bot1.Hand.Chains of Mephistopheles.Cast
Bot1.Pass
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Notion Thief.Cast
[T2 Bot2.Main1]
? Bot2.Hand.Count = 8
Bot2.Hand.Island.Play
Bot2.Battlefield.Island.Activate
Bot2.Hand.Ancestral Recall.Cast(Bot2)
Bot2.Replace(Notion Thief)
Bot1.Choose(Forest)
Bot2.Replace(Notion Thief)
Bot1.Choose(Island)
Bot2.Replace(Notion Thief)
Bot1.Choose(Island)
[T2 Bot2.Main2]

