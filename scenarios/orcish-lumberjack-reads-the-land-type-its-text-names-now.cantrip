# Trait Doctoring replaces the basic land type Forest with Island in Orcish Lumberjack's text until end of turn (CR 612.1):
# it now says "Sacrifice an Island". Bot1 has no Forest, only an Island, and sacrifices that for three mana.

[Bot1 Deck]
Island
Mox Ruby
Orcish Lumberjack
Mox Sapphire
Island
Trait Doctoring
Island x14

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Orcish Lumberjack.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Trait Doctoring.Cast(Orcish Lumberjack)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Replace a basic land type)
Bot1.Modes(Forest)
Bot1.Modes(Island)
Bot1.Battlefield.Orcish Lumberjack.Activate(Sacrifice: Island; Colors: R,R,G)

[Expect]
Turn = 3
Bot1.Mana = {R}{R}{G}
Bot1.Graveyard = Island
