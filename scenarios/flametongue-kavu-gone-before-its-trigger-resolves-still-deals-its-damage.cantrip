Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Hand.Flametongue Kavu.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Pass
Bot2.Pass
Bot1.Target(Ornithopter)
Bot1.Hand.Swords to Plowshares.Cast(Bot1.Battlefield.Flametongue Kavu)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Exile = Flametongue Kavu
Bot2.Graveyard = Ornithopter
Bot1.Life = 24
