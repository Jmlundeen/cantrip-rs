[T2 Bot2.Main1]
Bot2.Hand.Yavimaya Hollow.Play
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Mox Emerald.Cast
Bot2.Hand.Springheart Nantuko.Cast
Bot2.Battlefield.Mox Emerald#1.Activate
Bot2.Battlefield.Mox Emerald#2.Activate
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Feed the Swarm.Cast(Bot2.Battlefield.Springheart Nantuko)
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot2.Battlefield.Yavimaya Hollow.Activate(Bot2.Battlefield.Springheart Nantuko; Ability: Regenerate)
Bot2.Battlefield.Mox Emerald#3.Activate
[T3 Bot1.Main2]

