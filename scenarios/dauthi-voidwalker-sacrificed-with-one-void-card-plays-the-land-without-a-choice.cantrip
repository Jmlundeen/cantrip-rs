Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Dauthi Voidwalker.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Swords to Plowshares.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main1]
Bot1.Battlefield.Dauthi Voidwalker.Activate
Bot1.Pass
Bot2.Pass
Bot1.Exile.Mountain.Play

