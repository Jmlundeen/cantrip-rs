# With no planeswalker anywhere, Meticulous Commons enters tapped (CR 614.1c) - the land itself is not a planeswalker - so it
# cannot be tapped for mana that turn (refused), and on Bot1's next turn it untaps and taps for {W}, one of its two colors.

[Bot1 Deck]
Meticulous Commons
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Meticulous Commons.Play
? Bot1.Battlefield.Meticulous Commons.Tapped = true
! Bot1.Battlefield.Meticulous Commons.Activate(Color: White)
[T3 Bot1.Main1]
Bot1.Battlefield.Meticulous Commons.Activate(Color: White)
? Bot1.Mana = {W}
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot1.Battlefield.Meticulous Commons.Tapped = true
