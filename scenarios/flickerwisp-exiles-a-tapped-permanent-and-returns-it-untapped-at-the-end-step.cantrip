# Flickerwisp's enters trigger exiles another target permanent - here Bot1's own tapped Mox Ruby - and a delayed
# ability returns it to the battlefield under its owner's control at the beginning of the next end step (CR 603.7), as
# a new object, so it comes back untapped.

[Bot1 Deck]
Plains
Mox Pearl
Mox Ruby
Flickerwisp
Plains
Plains
Plains
Plains x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Flickerwisp.Cast
Bot1.Target(Mox Ruby)
[Bot1.Main2]
? Exile = Mox Ruby
? Bot1.Battlefield = Plains; Mox Pearl; Flickerwisp
[T2 Bot2.Main1]

[Expect]
Turn = 2
Exile.Count = 0
Bot1.Battlefield = Plains; Mox Pearl; Mox Ruby; Flickerwisp
Bot1.Battlefield.Mox Ruby.Tapped = false
Bot1.Battlefield.Mox Pearl.Tapped = true
