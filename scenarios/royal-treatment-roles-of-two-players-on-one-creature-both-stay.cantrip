Bot2.Battlefield = Forest; Royal
Bot1.Battlefield.Ornithopter.Power = 2
Bot1.Battlefield.Ornithopter.Toughness = 4
Bot1.Battlefield.Royal.AttachedTo = Ornithopter
Bot2.Battlefield.Royal.AttachedTo = Ornithopter
