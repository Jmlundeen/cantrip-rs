# Bot2's Fractured Identity exiles Bot1's Belladonna Took and gives Bot2 a token copy of it. "Whenever a token you
# control enters" is an enters trigger, and a permanent that enters sees itself enter (CR 603.6a):
# the copy, a token itself, triggers for its controller Bot2, who gains 1 life as a first resolution, and Bot1, whose
# Belladonna is gone, gains nothing. The copy's trigger is the copy's own, counted apart from the exiled original's.

[Bot1 Deck]
Belladonna Took
Mox Pearl
Mox Jet
Plains x12

[Bot2 Deck]
Fractured Identity
Mox Pearl
Mox Sapphire
Mox Jet
Mox Ruby
Mox Emerald
Plains x10

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Belladonna Took.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Fractured Identity.Cast(Bot1.Battlefield.Belladonna Took)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Life = 20
Bot2.Life = 21
Exile = Belladonna Took
Bot1.Battlefield = Mox Pearl; Mox Jet
Bot2.Battlefield.Belladonna Took.Token = true
