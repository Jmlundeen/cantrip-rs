? Bot1.Battlefield.Inkmoth Nexus.Subtypes = Blinkmoth; Phyrexian
? Bot1.Battlefield.Inkmoth Nexus.Keywords = Flying; Infect
? Bot1.Battlefield.Inkmoth Nexus.Power = 1
? Bot1.Battlefield.Inkmoth Nexus.Toughness = 1
? Bot1.Battlefield.Inkmoth Nexus.Colors = (absent)
Bot1.Attack(Inkmoth Nexus > Bot2)
[T3 Bot1.Main2]
? Bot2.Poison = 1
[T4 Bot2.Main1]

