Turn = 4
Bot2.Life = 20
Bot2.Poison = 1
Bot1.Battlefield = Inkmoth Nexus; Island; Sol Ring
Bot1.Battlefield.Inkmoth Nexus.Types = Land
Bot1.Battlefield.Inkmoth Nexus.Subtypes = (absent)
