# Goblin Snowman is killed in response to its own ping. The creature it was blocking is still the creature it blocked as it
# last existed (CR 608.2h), so the target is still legal and the 1 damage is dealt by it.
[Bot1 Deck]
Black Lotus
Mox Ruby
Goblin Snowman
Island x20
[Bot2 Deck]
Black Lotus
Memnite
Lightning Bolt
Island x20
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Goblin Snowman.Cast
[T2 Bot2.Main1]
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Memnite.Cast
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Memnite > Bot1)
Bot1.Block(Goblin Snowman > Memnite)
[T4 Bot2.Blockers]
Bot2.Pass
Bot1.Battlefield.Goblin Snowman.Activate(Memnite)
Bot1.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Goblin Snowman)
Bot2.Pass
Bot1.Pass
? Bot1.Graveyard.Goblin Snowman.Power = 1
[Expect]
Bot2.Battlefield.Memnite = (absent)
