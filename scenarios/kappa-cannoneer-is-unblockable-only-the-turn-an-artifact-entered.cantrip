! Bot2.Block(Ornithopter > Kappa Cannoneer)
Bot2.Block(Ornithopter > Ornithopter#1)
[T5 Bot1.Main1]
Bot1.Attack(Kappa Cannoneer > Bot2; Ornithopter#1 > Bot2)
Bot2.Block(Ornithopter > Kappa Cannoneer)
[T5 Bot1.Main2]

[Expect]
Bot1.Battlefield.Kappa Cannoneer.Counters.PlusOnePlusOne = 2
Bot2.Life = 14
