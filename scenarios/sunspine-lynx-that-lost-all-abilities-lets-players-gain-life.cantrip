# Sunspine Lynx: "Players can't gain life" is an ability of the Lynx, so a Lynx that has lost all its abilities (CR 613.1f) stops
# no one gaining life. On turn 2 Bot2's The Wondrous Wasp makes Bot1's Lynx lose all abilities for as long as the Wasp remains,
# and Bot2's Lightning Helix then gains Bot2 its 3. (The control, where the gain is stopped:
# sunspine-lynx-stops-life-gain-only-while-it-is-on-the-battlefield.)

[Bot1 Deck]
Black Lotus
Mox Ruby
Sunspine Lynx
Mountain
Mountain
Mountain
Mountain
Mountain x20

[Bot2 Deck]
Island
Black Lotus
Mox Ruby
Mox Pearl
The Wondrous Wasp
Lightning Helix
Island
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sunspine Lynx.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.The Wondrous Wasp.Cast
Bot2.Pass
Bot2.Target(Sunspine Lynx)
Bot2.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Lightning Helix.Cast(Bot1)
Bot2.Pass
[T2 Bot2.Main2]

[Expect]
Bot1.Life = 17
Bot2.Life = 23
Bot1.Battlefield.Sunspine Lynx.Tapped = true
