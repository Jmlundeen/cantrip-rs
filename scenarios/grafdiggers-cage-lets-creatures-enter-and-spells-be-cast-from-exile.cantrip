# Grafdigger's Cage names graveyards and libraries only: a creature card in exile still enters the battlefield, and a card
# exiled from a library is cast from exile, not a library (the Cage's ruling; CR 101.2, 601.3).
# - Turn 1: Bot1 casts the Cage and Ornithopter, then Ephemerate on the Ornithopter: it is exiled and returns from exile.
# - Turn 3: Ephemerate's rebound is cast from exile in the upkeep and blinks the Ornithopter again. In the main phase
#   Expressive Iteration exiles Lightning Bolt from the top of the library, and Bot1 casts the Bolt from exile at Bot2.

[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Sapphire
Mox Pearl
Grafdigger's Cage
Ornithopter
Ephemerate
Expressive Iteration
Swamp
Island
Lightning Bolt
Swamp x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Grafdigger's Cage.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Ephemerate.Cast(Ornithopter)
[T1 Bot1.Main2]
? Bot1.Battlefield = Black Lotus; Grafdigger's Cage; Mox Pearl; Mox Ruby; Mox Sapphire; Ornithopter
? Exile = Ephemerate
[T3 Bot1.Upkeep]
Bot1.Accept
Bot1.Target(Ornithopter)
[T3 Bot1.Main1]
? Bot1.Graveyard = Ephemerate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Expressive Iteration.Cast
Bot1.Arrange(Swamp | Island | Lightning Bolt)
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Exile.Lightning Bolt.Cast(Bot2)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Exile.Count = 0
Bot2.Life = 17
Bot1.Battlefield = Grafdigger's Cage; Mox Pearl; Mox Ruby; Mox Sapphire; Ornithopter
Bot1.Graveyard = Lightning Bolt; Black Lotus; Expressive Iteration; Ephemerate
