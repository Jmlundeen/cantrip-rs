# Colorstorm Stallion's opus is "Whenever YOU cast an INSTANT OR SORCERY spell". Bot2's Lightning Bolt on turn 4 (an instant, but not
# cast by Bot1) does nothing to the Stallion, and on turn 5 Bot1's own Coveted Jewel - six mana spent, but an artifact spell - neither
# pumps it nor copies it. It stays a 3/3, the only Stallion, with the Jewel on the battlefield beside it. (The positive controls are
# the scenarios in which Bot1 casts Lightning Bolt and Mind Twist.)

[Bot1 Deck]
Mountain
Island
Swamp
Mox Sapphire
Mox Ruby
Mox Jet
Colorstorm Stallion
Coveted Jewel
Island x12

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x18

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Colorstorm Stallion.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Colorstorm Stallion.Power = 3
[T5 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Coveted Jewel.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 5
Bot1.Battlefield.Colorstorm Stallion.Power = 3
Bot1.Battlefield.Colorstorm Stallion.Toughness = 3
Bot1.Battlefield.Count = 8
Bot1.Life = 17
