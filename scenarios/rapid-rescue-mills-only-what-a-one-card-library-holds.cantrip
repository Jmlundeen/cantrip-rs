# Rapid Rescue on a library of one card: it mills the one card there is (CR 701.17b; milling from an emptier library is
# not a loss until a draw), Bot1 takes it back if it is a permanent card, and the life is gained. Bot1 skips the draw of
# turn 1, so the library stays one card, Llanowar Elves.

[Bot1 Deck]
Forest
Rapid Rescue
Forest
Forest
Forest
Forest
Forest
Llanowar Elves

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Rapid Rescue.Cast
Bot1.Choose(Llanowar Elves)
[Bot1.Main2]
? Stack.Count = 0

[Expect]
Bot1.Life = 22
Bot1.Library.Count = 0
Bot1.Hand = Forest; Forest; Forest; Forest; Forest; Llanowar Elves
Bot1.Graveyard = Rapid Rescue
