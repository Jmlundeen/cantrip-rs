# Krark-Clan Ironworks: "Sacrifice an artifact: Add {C}{C}." The cost sacrifices an artifact its controller has: Bot2's Mox
# Pearl is not among the candidates (the refusal, beside the real sacrifices). Bot1 sacrifices its Mox Ruby to pay for a
# Sol Ring with the first {C}, leaving {C} floating, then an Ornithopter (an artifact creature), then the Ironworks itself,
# each adding {C}{C} at once (a mana ability uses no stack, CR 605.3b), so the pool grows to {C}{C}{C}{C}{C} and nothing
# is on the stack.

[Bot1 Deck]
Mox Ruby
Mox Jet
Mox Pearl
Mox Emerald
Krark-Clan Ironworks
Sol Ring
Ornithopter
Island x13

[Bot2 Deck]
Mox Pearl
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Krark-Clan Ironworks.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
[T3 Bot1.Main1]
! Bot1.Battlefield.Krark-Clan Ironworks.Activate(Bot2.Battlefield.Mox Pearl)
Bot1.Battlefield.Krark-Clan Ironworks.Activate(Sacrifice: Mox Ruby)
? Bot1.Mana = {C}{C}
Bot1.Hand.Sol Ring.Cast
Bot1.Pass
Bot2.Pass
? Bot1.Mana = {C}
Bot1.Battlefield.Krark-Clan Ironworks.Activate(Sacrifice: Ornithopter)
? Bot1.Mana = {C}{C}{C}
Bot1.Battlefield.Krark-Clan Ironworks.Activate(Sacrifice: Krark-Clan Ironworks)
? Bot1.Mana = {C}{C}{C}{C}{C}

[Expect]
Stack.Count = 0
Bot1.Battlefield = Mox Jet; Mox Pearl; Mox Emerald; Sol Ring
Bot1.Graveyard = Krark-Clan Ironworks; Ornithopter; Mox Ruby
Bot2.Battlefield = Mox Pearl
