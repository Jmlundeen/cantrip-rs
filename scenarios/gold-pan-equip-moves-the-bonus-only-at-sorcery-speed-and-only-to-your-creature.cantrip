! Bot1.Battlefield.Gold Pan.Activate(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Gold Pan.Activate(Bot1.Battlefield.Ornithopter#2)
Bot1.Pass

[Expect]
Bot1.Battlefield.Ornithopter#1.Power = 0
Bot1.Battlefield.Ornithopter#1.Toughness = 2
Bot1.Battlefield.Ornithopter#2.Power = 1
Bot1.Battlefield.Ornithopter#2.Toughness = 3
