Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Gold Pan.Cast
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
! Bot1.Battlefield.Gold Pan.Activate
Bot1.Pass
Bot2.Pass
