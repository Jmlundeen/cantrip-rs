# The instructions are followed in order and each as far as the cards go (CR 608.2c): with only two cards in the library
# one goes to the hand and the other to the bottom (the library), and there is none left to exile or play.

[Bot1 Deck]
Mox Ruby
Mox Sapphire
Expressive Iteration
Swamp
Swamp
Swamp
Swamp
Lightning Bolt
Island

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Expressive Iteration.Cast
Bot1.Arrange(Lightning Bolt | Island | )

[Expect]
Exile.Count = 0
Bot1.Hand = Swamp; Swamp; Swamp; Swamp; Lightning Bolt
Bot1.Library = Island
Bot1.Graveyard = Expressive Iteration
