Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Swords to Plowshares.Cast(Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot2.Life = 20
? Exile = Ornithopter
[T5 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Lightning Helix.Cast(Bot2)
Bot1.Pass
Bot2.Pass

