# Knight of Autumn, second mode: "Destroy target artifact or enchantment." Bot2's Earthcraft is an enchantment and is
# destroyed; its Forest (a land) is not a legal target, refused beside the Earthcraft that is. Bot1's own Moxen are
# artifacts, legal targets too, but are not chosen.

[Bot1 Deck]
Mox Emerald
Mox Pearl
Mox Jet
Knight of Autumn
Island x16

[Bot2 Deck]
Forest
Mox Ruby
Earthcraft
Forest x15

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Earthcraft.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Knight of Autumn.Cast
Bot1.Pass
Bot1.Modes(Destroy target artifact)
! Bot1.Target(Bot2.Battlefield.Forest)
Bot1.Target(Bot2.Battlefield.Earthcraft)

[Expect]
Bot2.Graveyard = Earthcraft
Bot2.Battlefield = Forest; Mox Ruby
Bot1.Battlefield = Mox Emerald; Mox Pearl; Mox Jet; Knight of Autumn
