Bot1.Graveyard = Aerial Doombot
Bot2.Graveyard = Lightning Bolt; Lightning Bolt; Lightning Bolt
Bot1.Battlefield.Doc Ock, Sinister Scientist.Damage = 3
Bot1.Battlefield.Doc Ock, Sinister Scientist.Keywords = (absent)
