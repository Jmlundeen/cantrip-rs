? Bot2.Battlefield.Aclazotz, Deepest Betrayal.Power = 4
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Aclazotz, Deepest Betrayal)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Pass
