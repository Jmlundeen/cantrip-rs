# Kytheon, Hero of Akros transforms only "if Kytheon and at least two other creatures attacked this combat" (CR 603.4):
# on turn 3 Kytheon attacks with one Ornithopter - two attackers, he not counted among the others - and on turn 5 three
# Ornithopters attack without him. Neither combat transforms him; Bot2 took only his 2 on turn 3.

[Bot1 Deck]
Plains
Kytheon, Hero of Akros
Ornithopter
Ornithopter
Ornithopter
Plains x12

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Hand.Kytheon, Hero of Akros.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(Kytheon, Hero of Akros > Bot2; Ornithopter#1 > Bot2)
[T3 Bot1.Main2]
? Bot1.Battlefield.Kytheon, Hero of Akros.Tapped = true
[T5 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2; Ornithopter#2 > Bot2; Ornithopter#3 > Bot2)
[T5 Bot1.Main2]

[Expect]
Bot1.Battlefield = Kytheon, Hero of Akros; Ornithopter; Ornithopter; Ornithopter; Plains
Bot1.Battlefield.Kytheon, Hero of Akros.Tapped = false
Bot2.Life = 18
