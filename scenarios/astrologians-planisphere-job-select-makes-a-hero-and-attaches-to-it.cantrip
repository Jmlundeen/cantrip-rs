# Astrologian's Planisphere, cast on turn 3: job select makes a 1/1 colorless Hero token and attaches the Equipment
# to it, so the Hero is a Wizard (in addition to Hero) and still 1/1 with no counters yet.

[Bot1 Deck]
Island
Island
Astrologian's Planisphere
Island x12

[Bot2 Deck]
Island x18

[Actions]
Bot1.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Astrologian's Planisphere.Cast
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot1.Battlefield = Island; Island; Astrologian's Planisphere; Hero
Bot1.Battlefield.Astrologian's Planisphere.AttachedTo = Hero
Bot1.Battlefield.Hero.Power = 1
Bot1.Battlefield.Hero.Toughness = 1
Bot1.Battlefield.Hero.Types = Creature
Bot1.Battlefield.Hero.Subtypes = Hero; Wizard
Stack.Count = 0
