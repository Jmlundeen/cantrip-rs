# "Return a land you control to its owner's hand": with no other land the Aqueduct must return itself (the
# trigger is not optional), and Bot2's Swamp is not a candidate, so no question is asked (`! Bot1.Choose`). Played on turn
# one and again on turn three, it ends in hand both times; nothing of Bot1's is on the battlefield.

[Bot1 Deck]
Dimir Aqueduct
Island x14

[Bot2 Deck]
Swamp x15

[Actions]
Bot1.Hand.Dimir Aqueduct.Play
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
[T3 Bot1.Main1]
Bot1.Hand.Dimir Aqueduct.Play
! Bot1.Choose
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Count = 0
Bot2.Battlefield = Swamp
Bot1.LandsPlayed = 1
