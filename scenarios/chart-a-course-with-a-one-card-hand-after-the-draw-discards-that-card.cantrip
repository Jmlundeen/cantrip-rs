# Chart a Course with one card left in the library: the first draw takes the Forest, the second draws from an empty
# library (CR 121.4), and the one-card hand is discarded, the question still asked of the single card (CR 701.9).
# Bot1 then loses to the empty library at the next state-based check (CR 704.5b).

[Bot1 Deck]
Island
Mox Sapphire
Chart a Course
Mox Ruby
Mox Pearl
Mox Jet
Gleemox
Forest

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Gleemox.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Chart a Course.Cast
Bot1.Choose(Forest)

[Expect]
Result = Bot2 won
Bot1.Graveyard = Chart a Course; Forest
Bot1.Hand.Count = 0
