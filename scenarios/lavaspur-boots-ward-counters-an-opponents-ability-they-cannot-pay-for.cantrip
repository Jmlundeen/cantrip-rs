# Ward answers an ability as well as a spell: Bot2's Walking Ballista pings the equipped Rootwalla with both
# Mountains spent on the Ballista, so the ping is countered and the Rootwalla is unhurt.

[Bot1 Deck]
Forest
Forest
Basking Rootwalla
Lavaspur Boots
Forest
Forest
Mountain
Forest x13

[Bot2 Deck]
Mountain
Mountain
Walking Ballista
Mountain x17

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Lavaspur Boots.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Basking Rootwalla.Cast
Bot1.Battlefield.Forest#2.Activate
Bot1.Battlefield.Lavaspur Boots.Activate(Basking Rootwalla)
[T4 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Battlefield.Mountain#2.Activate
Bot2.Hand.Walking Ballista.Cast(X: 1)
[T4 Bot2.Main2]
Bot2.Battlefield.Walking Ballista.Activate(Bot1.Battlefield.Basking Rootwalla; Ability: Remove)

[Expect]
Bot1.Battlefield.Basking Rootwalla.Damage = 0
Bot1.Life = 20
Bot2.Graveyard = Walking Ballista
Stack.Count = 0
