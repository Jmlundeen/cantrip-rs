# The ruling: "If the target creature is an illegal target, you'll still gain control of the target Equipment until end of
# turn, but you won't attach it to the chosen creature" (CR 608.2b). Bot2 answers Stolen Uniform by killing Bot1's
# Grizzly Bears with Lightning Bolt. Bot1 still takes the Skullclamp, unattached, until the turn ends; Bot2 has it back on
# turn 4. Bot2's creature can't be chosen as "target creature you control".

[Bot1 Deck]
Mox Sapphire
Mox Emerald
Mox Pearl
Grizzly Bears
Stolen Uniform
Island x15

[Bot2 Deck]
Mox Jet
Mox Ruby
Skullclamp
Lightning Bolt
Memnite
Mountain x15

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Grizzly Bears.Cast
[T2 Bot2.Main1]
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Skullclamp.Cast
Bot2.Hand.Memnite.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Stolen Uniform.Cast
! Bot1.Target(Bot2.Battlefield.Memnite)
Bot1.Target(Bot1.Battlefield.Grizzly Bears)
Bot1.Target(Bot2.Battlefield.Skullclamp)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Grizzly Bears)
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Pass
? Bot1.Battlefield.Skullclamp.AttachedTo = (absent)
? Bot1.Battlefield = Mox Sapphire; Mox Emerald; Mox Pearl; Skullclamp
[T4 Bot2.Main1]
? Bot2.Battlefield.Skullclamp.AttachedTo = (absent)

[Expect]
Bot1.Graveyard = Stolen Uniform; Grizzly Bears
Bot2.Battlefield = Mox Jet; Mox Ruby; Skullclamp; Memnite
Bot2.Graveyard = Lightning Bolt
