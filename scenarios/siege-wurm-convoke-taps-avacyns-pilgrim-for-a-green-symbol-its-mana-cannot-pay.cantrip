Bot1.Battlefield.Forest.Activate
Bot1.Hand.Siege Wurm.Cast(Convoke: Avacyn's Pilgrim, Ornithopter, Ornithopter, Ornithopter, Ornithopter, Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Siege Wurm.Damage = 0
Bot1.Battlefield.Avacyn's Pilgrim.Tapped = true
