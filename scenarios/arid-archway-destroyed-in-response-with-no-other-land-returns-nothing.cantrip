# Bot1 plays Arid Archway as its only land (it holds a Plains it did not play) and Bot2 destroys it with Wasteland in response
# to its enters trigger. Nothing is left to choose when the trigger resolves (it is not even asked), so nothing is returned
# and nothing is surveilled: the library keeps its cards and the Archway is in the graveyard.

[Bot1 Deck]
Plains
Arid Archway
Plains x13

[Bot2 Deck]
Wasteland
Island x15

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Wasteland.Play
[T3 Bot1.Main1]
Bot1.Hand.Arid Archway.Play
Bot2.Battlefield.Wasteland.Activate(Ability: Destroy; Arid Archway)
Bot1.Pass
! Bot1.Arrange
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Count = 0
Bot1.Graveyard = Arid Archway
Bot2.Graveyard = Wasteland
Bot1.Hand.Count = 7
