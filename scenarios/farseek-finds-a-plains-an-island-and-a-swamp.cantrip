Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Farseek.Cast
Bot1.Search(Savannah)
Bot1.Hand.Farseek.Cast
Bot1.Search(Tropical Island)
? Bot1.Mana = {G}
[T2 Bot2.Main1]
? Bot1.Battlefield.Savannah.Tapped = true
? Bot1.Battlefield.Tropical Island.Tapped = true
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Hand.Farseek.Cast
Bot1.Search(Bayou)
