# Samut's haste is a static ability, so it lasts only while he is on the battlefield. Turn 1: Bot1 casts Ornithopter. Turn 3: it casts
# Llanowar Elves, then Samut, then exiles Samut with its own Swords to Plowshares. The Elves, cast this turn, no longer have haste and
# may not attack (CR 302.6), while the Ornithopter, cast on turn 1, may: the control that makes the refusal a refusal of the Elves.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mox Emerald
Mox Jet
Ornithopter
Samut, Hazoret's Champion
Llanowar Elves
Swords to Plowshares
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Samut, Hazoret's Champion.Cast
Bot1.Pass
Bot1.Battlefield.Mox Pearl.Activate
? Bot1.Battlefield.Llanowar Elves.SummoningSick = false
Bot1.Hand.Swords to Plowshares.Cast(Samut, Hazoret's Champion)
Bot1.Pass
! Bot1.Attack(Llanowar Elves > Bot2)
Bot1.Attack(Ornithopter > Bot2)
[T3 Bot1.Main2]

[Expect]
Exile = Samut, Hazoret's Champion
Bot1.Life = 22
Bot1.Battlefield.Llanowar Elves.SummoningSick = true
Bot1.Battlefield.Ornithopter.SummoningSick = false
