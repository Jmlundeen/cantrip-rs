# Sentinel of the Nameless City: entering on turn 1 it creates a Map token, and attacking on turn 3 (vigilance, so it
# stays untapped) it creates a second one.

[Bot1 Deck]
Forest
Mox Emerald
Mox Ruby
Sentinel of the Nameless City
Plains x3
Plains x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sentinel of the Nameless City.Cast
[T3 Bot1.Main1]
? Bot1.Battlefield = Forest; Mox Emerald; Mox Ruby; Sentinel of the Nameless City; Map Token
Bot1.Attack(Sentinel of the Nameless City > Bot2)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 17
Bot1.Battlefield = Forest; Mox Emerald; Mox Ruby; Sentinel of the Nameless City; Map Token; Map Token
Bot1.Battlefield.Sentinel of the Nameless City.Tapped = false
