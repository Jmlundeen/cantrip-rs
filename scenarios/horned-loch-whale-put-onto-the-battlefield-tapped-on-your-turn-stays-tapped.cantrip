Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Sol Ring.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Raph & Mikey, Troublemakers.Cast
Bot1.Pass
Bot2.Pass
[Bot1.DeclareAttackers]
Bot1.Attack(Raph & Mikey, Troublemakers)
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Horned Loch-Whale.Tapped = true
Bot1.Battlefield.Horned Loch-Whale.Power = 6
