# "That player may search": Bot1 attacks with one Ornithopter and Bot2 casts Settle the Wreckage on Bot1. The attacker is
# exiled, then Bot1 is asked and declines: no land arrives (the Forests stay in the library) and the non-attacking
# Ornithopter is untouched.

[Bot1 Deck]
Ornithopter
Ornithopter
Island
Island
Island
Island
Island
Island
Overgrown Tomb
Forest
Forest
Island x6

[Bot2 Deck]
Plains
Mox Pearl
Mox Jet
Mox Ruby
Settle the Wreckage
Plains
Plains x10

[Actions]
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2)
Bot2.Battlefield.Plains.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Settle the Wreckage.Cast(Bot1)
Bot1.Decline
[Bot1.Main2]

[Expect]
Exile = Ornithopter
Bot1.Battlefield = Ornithopter
Bot1.Library.Count = 9
