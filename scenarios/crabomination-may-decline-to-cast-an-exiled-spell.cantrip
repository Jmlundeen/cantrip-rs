Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Crabomination.Cast
Bot1.Pass
Bot1.Pass
Bot1.Choose()
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 20
Exile = Island; Island; Lightning Bolt
Bot2.Graveyard.Count = 0
