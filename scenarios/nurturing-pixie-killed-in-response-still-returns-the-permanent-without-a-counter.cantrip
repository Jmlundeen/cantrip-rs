Bot1.Battlefield.Plains#1.Activate
Bot1.Target(Thraben Inspector)
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Nurturing Pixie)
Bot2.Battlefield.Mox Ruby.Activate
