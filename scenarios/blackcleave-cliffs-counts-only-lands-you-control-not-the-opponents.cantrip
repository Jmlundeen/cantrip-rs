# "Two or fewer other lands" counts the lands its controller controls (CR 614.1d, 109.4), not every land in the game.
# On turn five Bot1 controls two lands and Bot2 two more, four other lands in all, and Blackcleave Cliffs still enters
# untapped; the existing scenario with three of Bot1's own lands is the control that it enters tapped.

[Bot1 Deck]
Mountain
Mountain
Blackcleave Cliffs
Plains x17

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T5 Bot1.Main1]
Bot1.Hand.Blackcleave Cliffs.Play

[Expect]
Bot1.Battlefield.Blackcleave Cliffs.Tapped = false
Bot2.Battlefield.Count = 2
