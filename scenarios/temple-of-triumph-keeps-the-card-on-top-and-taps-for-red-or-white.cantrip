# Scry 1 may leave the card on top ("you may put that card on the bottom"): Bot1 keeps the Lightning Bolt, which it draws on turn
# three. The land has no basic land types, but "{T}: Add {R} or {W}" taps for red on turn three and for white on turn five (the
# color is chosen as it is activated).

[Bot1 Deck]
Temple of Triumph
Mountain x6
Lightning Bolt
Mountain x10

[Bot2 Deck]
Plains x15

[Actions]
Bot1.Hand.Temple of Triumph.Play
Bot1.Arrange(Lightning Bolt |)
[T3 Bot1.Main1]
? Bot1.Hand.Count = 7
! Bot1.Battlefield.Temple of Triumph.Activate(Color: Blue)
! Bot1.Battlefield.Temple of Triumph.Activate(Color: Colorless)
Bot1.Battlefield.Temple of Triumph.Activate(Color: Red)
? Bot1.Mana = {R}
[T5 Bot1.Main1]
Bot1.Battlefield.Temple of Triumph.Activate(Color: White)
? Bot1.Mana = {W}

[Expect]
Bot1.Battlefield.Temple of Triumph.Types = Land
Bot1.Hand = Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Mountain; Lightning Bolt
Bot1.Graveyard.Count = 0
