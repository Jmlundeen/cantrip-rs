Bot2.Hand.Ornithopter.Cast
Bot1.Pass
Bot2.Pass
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Ingris Stingerquill; Healer's Hawk > Bot2)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Bot2.Life = 18
? Bot1.Life = 21
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Ornithopter > Bot1)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
[Bot2.Main2]

[Expect]
Bot2.Life = 16
Bot1.Life = 22
