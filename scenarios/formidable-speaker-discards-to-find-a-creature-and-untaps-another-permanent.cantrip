# Formidable Speaker: entering, its controller discards an Island and so searches for a creature card (Llanowar Elves,
# put into the hand). On turn 3 "{1}, {T}: Untap another target permanent" untaps the Mox Jet that paid for it.
# The library is Llanowar Elves and Islands, so the shuffle cannot matter.

[Bot1 Deck]
Formidable Speaker
Gleemox
Mox Emerald
Mox Jet
Island
Island
Island
Llanowar Elves
Island x10

[Bot2 Deck]
Island x18

[Actions]
Bot1.Hand.Gleemox.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Gleemox.Activate(Color: Blue)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Formidable Speaker.Cast
Bot1.Pass
