# An animated Desert blocks Camel and its bandmate; Camel's ability prevents the Desert's combat damage (CR 615.1, 702.22h).
[Bot1 Deck]
Mox Pearl
Camel
Ornithopter
Plains x17

[Bot2 Deck]
Scavenger Grounds
Black Lotus
Mox Sapphire
Applied Geometry
Island x16

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Camel.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Scavenger Grounds.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Black Lotus.Activate(Color: Green)
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Applied Geometry.Cast(Bot2.Battlefield.Scavenger Grounds)
[T3 Bot1.BeginCombat]
Bot1.Attack(Camel > Bot2; Ornithopter > Bot2)
Bot1.Choose(Ornithopter)
Bot2.Block(Scavenger Grounds#2 > Camel)
Bot1.AssignDamage(Scavenger Grounds#2 > Camel: 3; Scavenger Grounds#2 > Ornithopter: 3)
[T3 Bot1.EndCombat]
? Bot1.Battlefield.Camel.Damage = 0
? Bot1.Battlefield.Ornithopter.Damage = 0
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Camel.Toughness = 1
Bot1.Battlefield.Ornithopter.Toughness = 2
