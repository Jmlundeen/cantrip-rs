# Sandstorm deals one damage to each attacking creature, including multiple attackers,
# but not creatures staying out of combat (CR 508.1, 120.3).
[Bot1 Deck]
Sandstorm
Mox Emerald
Ornithopter
Forest x20

[Bot2 Deck]
Ornithopter x2
Memnite
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
[T4 Bot2.Main1]
Bot2.Attack(Ornithopter#1 > Bot1; Memnite > Bot1)
[T4 Bot2.DeclareBlockers]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Sandstorm.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Ornithopter#1.Damage = 1
? Bot2.Battlefield.Ornithopter#2.Damage = 0
? Bot1.Battlefield.Ornithopter.Damage = 0
? Bot2.Graveyard = Memnite
[T4 Bot2.Main2]

[Expect]
Bot1.Graveyard = Sandstorm
