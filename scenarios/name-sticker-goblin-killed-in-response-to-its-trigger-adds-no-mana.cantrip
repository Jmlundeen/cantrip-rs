Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand."Name Sticker" Goblin.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast("Name Sticker" Goblin)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Mana =

