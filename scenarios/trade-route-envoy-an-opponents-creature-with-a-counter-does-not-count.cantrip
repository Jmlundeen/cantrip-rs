# Only a creature YOU control counts. Bot1's Sage of the Fang puts its counter on Bot2's Ornithopter; Bot1 has no creature with a counter, so the Envoy draws nothing and gets its own counter.

[Bot1 Deck]
Black Lotus
Sage of the Fang
Trade Route Envoy
Mox Emerald
Mox Pearl
Mox Ruby
Mox Jet
Island x14

[Bot2 Deck]
Ornithopter
Island x19

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Sage of the Fang.Cast
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Trade Route Envoy.Cast
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Battlefield.Ornithopter.Counters.PlusOnePlusOne = 1
Bot1.Battlefield.Sage of the Fang.Counters.PlusOnePlusOne = (absent)
Bot1.Battlefield.Trade Route Envoy.Counters.PlusOnePlusOne = 1
Bot1.Hand.Count = 1
