Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Three Steps Ahead.Cast
Bot1.Modes(Create a token)
Bot1.Target(Bot1.Battlefield.Outland Liberator)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
DayNight = Night
Bot1.Battlefield = Forest; Frenzied Trapbreaker; Island; Mox Emerald; Mox Sapphire; Outland Liberator; Outland Liberator
Bot1.Battlefield.Frenzied Trapbreaker.Transformed = true
Bot1.Battlefield.Outland Liberator#1.Token = (absent)
Bot1.Battlefield.Outland Liberator#1.Keywords = Daybound
