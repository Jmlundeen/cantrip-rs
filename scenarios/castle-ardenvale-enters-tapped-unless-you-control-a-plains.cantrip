# Castle Ardenvale: "This land enters tapped unless you control a Plains." and "{T}: Add {W}."
# Turn 3 Bot1 controls only an Island while Bot2 controls a Plains (played turn 2): the first Castle enters tapped - an
# opponent's Plains is not one "you control". Turn 5 Bot1 plays a Plains; turn 7 the second Castle enters untapped and
# taps for {W}.

[Bot1 Deck]
Island
Castle Ardenvale
Plains
Castle Ardenvale
Island
Island
Island
Island x10

[Bot2 Deck]
Plains
Plains x19

[Actions]
Bot1.Hand.Island.Play
Bot2.Hand.Plains.Play
[T3 Bot1.Main1]
Bot1.Hand.Castle Ardenvale.Play
? Bot1.Battlefield.Castle Ardenvale.Tapped = true
[T5 Bot1.Main1]
Bot1.Hand.Plains.Play
[T7 Bot1.Main1]
Bot1.Hand.Castle Ardenvale.Play
? Bot1.Battlefield.Castle Ardenvale#2.Tapped = false
Bot1.Battlefield.Castle Ardenvale#2.Activate(Ability: Add {W}.)
? Bot1.Mana = {W}

[Expect]
Turn = 7
Bot1.Battlefield.Castle Ardenvale#1.Tapped = false
Bot1.Battlefield.Castle Ardenvale#2.Tapped = true
