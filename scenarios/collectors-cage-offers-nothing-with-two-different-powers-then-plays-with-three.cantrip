# Collector's Cage hides Mox Ruby. On turn 5 its {1},{T} puts a counter on one of two Llanowar Elves: the powers are 1
# and 2, only two different, so Bot1 is not asked about the exiled card (the refused Accept fails the script if it is). On turn 7, with an Ornithopter cast, the same activation leaves powers 3, 1
# and 0: three different, so Bot1 is asked and the same Accept plays Mox Ruby for free (the positive control).

[Bot1 Deck]
Forest
Llanowar Elves
Ornithopter
Plains
Llanowar Elves
Collector's Cage
Forest
Forest
Forest
Forest
Mox Ruby
Forest
Forest
Forest
Forest
Forest
Forest
Forest x8

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
Bot1.Hand.Collector's Cage.Cast
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Llanowar Elves#1.Activate
Bot1.Arrange(Mox Ruby | Forest; Forest; Forest; Forest)
[T5 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Collector's Cage.Activate(Bot1.Battlefield.Llanowar Elves#2)
Bot1.Battlefield.Forest.Activate
! Bot1.Accept
[T5 Bot1.Main2]
? Exile.Count = 1
? Bot1.Battlefield.Llanowar Elves#2.Power = 2
[T7 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Battlefield.Collector's Cage.Activate(Bot1.Battlefield.Llanowar Elves#2)
Bot1.Battlefield.Forest.Activate
Bot1.Accept
[T7 Bot1.Main2]

[Expect]
Turn = 7
Exile.Count = 0
Bot1.Battlefield.Mox Ruby.Types = Artifact
Bot1.Battlefield.Llanowar Elves#2.Power = 3
