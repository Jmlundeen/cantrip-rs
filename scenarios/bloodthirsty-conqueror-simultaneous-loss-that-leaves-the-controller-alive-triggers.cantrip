# Bloodthirsty Conqueror, ruling 2024-11-08 (control for ...controller-at-zero-from-the-same-damage-loses-...): the same
# Sunspine Lynx damage - 1 to Bot1 for its Underground Sea and 1 to Bot2 for its Badlands, at once - with Bot1 at 2 life
# leaves it at 1, alive, and Bot2 at 19. Bot2 losing life triggers the Conqueror (Stack.Count = 1 once the damage is dealt),
# which resolves; the Lynx's "players can't gain life" (CR 119.7) means Bot1 gains nothing and stays at 1.

[Life]
Bot1: 2

[Bot1 Deck]
Underground Sea
Mox Jet
Mox Ruby
Mox Pearl
Mox Emerald
Bloodthirsty Conqueror
Swamp
Swamp x13

[Bot2 Deck]
Badlands
Mox Ruby
Mox Ruby
Mox Jet
Sunspine Lynx
Mountain
Mountain x14

[Actions]
Bot1.Hand.Underground Sea.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Underground Sea.Activate(Ability: {B})
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Bloodthirsty Conqueror.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Badlands.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Battlefield.Badlands.Activate(Ability: {R})
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Sunspine Lynx.Cast
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Stack.Count = 1
Bot1.Pass

[Expect]
Result = InProgress
Bot1.Life = 1
Bot2.Life = 19
Stack.Count = 0
Bot1.Battlefield.Bloodthirsty Conqueror.Power = 5
