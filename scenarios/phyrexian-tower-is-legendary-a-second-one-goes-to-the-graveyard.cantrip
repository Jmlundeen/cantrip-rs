# Phyrexian Tower is a legendary land, so a second one under the same controller triggers the legend rule (CR 704.5j): one is put
# into the graveyard as a state-based action and one stays.

[Bot1 Deck]
Phyrexian Tower
Phyrexian Tower
Plains x13

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Phyrexian Tower.Play
[T3 Bot1.Main1]
Bot1.Hand.Phyrexian Tower.Play
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield = Phyrexian Tower
Bot1.Graveyard = Phyrexian Tower
