# Foreboding Ruins: "you may reveal a Swamp or Mountain card from your hand" (CR 701.20a, 614.1c) - the second subtype
# qualifies as the first does. Bot1's hand holds a Mountain and Swamps, and revealing the Mountain leaves the Ruins
# untapped and able to tap for mana, so a filter that took only Swamps fails here.

[Bot1 Deck]
Foreboding Ruins
Mountain
Swamp x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Foreboding Ruins.Play
Bot1.Accept
Bot1.Choose(Mountain)
? Bot1.Revealed = Mountain
? Bot1.Battlefield.Foreboding Ruins.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Foreboding Ruins.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Turn = 3
Bot1.Battlefield.Foreboding Ruins.Tapped = true
