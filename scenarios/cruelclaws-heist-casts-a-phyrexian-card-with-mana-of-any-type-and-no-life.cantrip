# Cruelclaw's Heist with its gift exiles Bot2's Dismember ({1}{B/P}{B/P}), which Bot1 may cast with mana of any type
# (CR 609.4b). Its cost is not changed: each {B/P} is still paid with {B} or 2 life (CR 107.4f), announced before the
# mana (CR 601.2b), and any mana pays a {B}. Choosing to pay no life, Bot1 pays all three mana with a Mox Pearl, a Mox
# Ruby and a Mox Sapphire, none of them black: its life stays 20, and its Ornithopter gets -5/-5 and dies.

[Bot1 Deck]
Swamp
Mox Jet
Cruelclaw's Heist
Mox Pearl
Mox Ruby
Mox Sapphire
Ornithopter
Island x20

[Bot2 Deck]
Dismember
Island x20

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Cruelclaw's Heist.Cast
Bot1.Accept
Bot1.Choose(Dismember)
[T1 Bot1.Main1]
? Exile = Dismember
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Exile.Dismember.Cast(Ornithopter)
Bot1.Modes()
[T1 Bot1.Main2]

[Expect]
Bot1.Life = 20
Bot1.Graveyard = Ornithopter; Cruelclaw's Heist
Bot2.Graveyard = Dismember
Exile.Count = 0
