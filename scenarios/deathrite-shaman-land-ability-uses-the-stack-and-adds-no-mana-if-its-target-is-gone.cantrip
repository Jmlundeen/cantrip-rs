# Deathrite Shaman's first ability has a target, so it is not a mana ability (CR 605.1a): it goes on the stack and can
# be responded to. Here a second Deathrite Shaman exiles the same land card in response; the first ability's only
# target is gone as it resolves, so it does nothing and adds no mana (CR 608.2b).

[Bot1 Deck]
Swamp
Deathrite Shaman
Forest
Deathrite Shaman
Swamp
Forest
Swamp
Swamp x10

[Bot2 Deck]
Mountain x7
Forest
Forest
Mountain x10

[Actions]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Deathrite Shaman.Cast
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Deathrite Shaman.Cast
[T5 Bot1.Main1]
Bot1.Battlefield.Deathrite Shaman#1.Activate(Bot2.Graveyard.Forest#1; Ability: land)
? Stack.Count = 1
Bot1.Battlefield.Deathrite Shaman#2.Activate(Bot2.Graveyard.Forest#1; Ability: land)
? Stack.Count = 2
Bot1.Colors(Red)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Mana = {R}
? Bot2.Graveyard.Count = 1
? Exile.Count = 1

[Expect]
Bot1.Battlefield.Deathrite Shaman#1.Tapped = true
Bot1.Battlefield.Deathrite Shaman#2.Tapped = true
