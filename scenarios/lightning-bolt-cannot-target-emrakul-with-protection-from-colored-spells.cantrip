# Emrakul has protection from spells that are one or more colors. Bot1 sneaks it in on turn 3 and attacks; with the
# annihilator trigger on the stack Bot2 holds Lightning Bolt (a red spell) and Mox Ruby. Emrakul is not a legal target
# of the Bolt - it must not even be offered (CR 702.16a) - while Bot1 is (the positive control, who goes to 17). The Bolt
# resolves first; the annihilator trigger then makes Bot2 sacrifice the Mox Ruby, so both are in the graveyard.

[Bot1 Deck]
Mountain
Black Lotus
Mox Ruby
Sneak Attack
Emrakul, the Aeons Torn
Mountain
Mountain x14

[Bot2 Deck]
Mox Ruby
Lightning Bolt
Island x18

[Actions]
Bot1.Hand.Mountain.Play
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Sneak Attack.Cast
Bot1.Pass
Bot1.Battlefield.Mountain#1.Activate
Bot1.Battlefield.Sneak Attack.Activate
Bot1.Choose(Emrakul, the Aeons Torn)
Bot1.Pass
Bot1.Attack(Emrakul, the Aeons Torn > Bot2)
[T3 Bot1.DeclareAttackers]
Bot2.Battlefield.Mox Ruby.Activate
! Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Emrakul, the Aeons Torn)
Bot2.Hand.Lightning Bolt.Cast(Bot1)
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 17
Bot2.Graveyard = Mox Ruby; Lightning Bolt
