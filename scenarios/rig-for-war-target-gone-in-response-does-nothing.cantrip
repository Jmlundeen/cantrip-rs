# Rig for War: a target that is gone as the spell resolves is illegal and the spell does nothing (CR 608.2b). Bot2 sacrifices its
# Ornithopter to Lightning Bolt in response; Rig for War fizzles and the Grizzly Bears, not targeted, stay plain.

[Bot1 Deck]
Mox Emerald
Mox Pearl
Mox Ruby
Grizzly Bears
Rig for War
Island x14

[Bot2 Deck]
Ornithopter
Mox Ruby
Lightning Bolt
Island x17

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Grizzly Bears.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rig for War.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Battlefield.Grizzly Bears.Power = 2
Bot1.Battlefield.Grizzly Bears.Keywords = (absent)
