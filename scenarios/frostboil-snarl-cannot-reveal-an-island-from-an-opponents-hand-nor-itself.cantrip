# "an Island or Mountain card from your hand" (CR 701.20a, 400.7): Bot2's hand holds Islands but Bot1's holds none - a Forest
# is no Island or Mountain, and the Snarl itself has no land subtypes, so it cannot be revealed either. Bot2's hand stays
# where it is, and this one enters tapped.

[Bot1 Deck]
Frostboil Snarl
Frostboil Snarl
Forest x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Frostboil Snarl.Play
Bot1.Accept
? Bot1.Battlefield.Frostboil Snarl.Tapped = true

[Expect]
Turn = 1
Bot1.Battlefield.Frostboil Snarl.Tapped = true
Bot1.Hand.Count = 6
Bot2.Hand.Count = 7
