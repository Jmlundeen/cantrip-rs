# CR 103.5c: in a multiplayer game only the first mulligan is free. In a game of three Bot1 mulligans twice and, keeping,
# puts one card - not two - on the bottom of its library. Each deck is a single card over and over, so the shuffles
# cannot change what is expected.

[Opening]
Chooser: Bot1

[Bot1 Deck]
Island x20

[Bot2 Deck]
Forest x20

[Bot3 Deck]
Mountain x20

[Actions]
Bot1.PlayFirst
Bot1.Mulligan
Bot2.Keep
Bot3.Keep
Bot1.Mulligan
Bot1.Keep
Bot1.Choose(Island)
[T1 Bot1.Main1]

[Expect]
Turn = 1
ActivePlayer = Bot1
# Six kept, and the turn-one draw of a game of three (CR 103.8a).
Bot1.Hand.Count = 7
Bot1.Library.Count = 13
