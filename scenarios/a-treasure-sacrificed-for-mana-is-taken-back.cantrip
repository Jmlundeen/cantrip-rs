# Browser
# Taking back a Treasure's mana (cantrip_engine::undo): Generous Plunderer makes Bot1 a Treasure in its upkeep (and
# Bot2 a tapped one). Bot1 sacrifices its Treasure for green, then takes it back: the token is on the battlefield again
# - it had ceased to exist in the graveyard (CR 111.8) - and the pool is empty.

[Bot1 Deck]
Mountain
Mountain
Generous Plunderer
Island x12

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Generous Plunderer.Cast
[T5 Bot1.Upkeep]
Bot1.Accept
[T5 Bot1.Main1]
Bot1.Battlefield.Treasure Token.Activate(Color: Green)
? Bot1.Mana = {G}
? Bot1.Battlefield = Mountain; Mountain; Generous Plunderer
Bot1.Undo
? Bot1.Mana =

[Expect]
Bot1.Battlefield.Treasure Token.Tapped = false
Bot2.Battlefield.Treasure Token.Tapped = true
