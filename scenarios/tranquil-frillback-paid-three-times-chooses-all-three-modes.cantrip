Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Pass
Bot2.Battlefield.Black Lotus.Activate(Color: Red)
Bot2.Hand.Sol Ring.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Tranquil Frillback.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Pass
Bot1.PayCost(Times: 3)
? Bot1.Mana =
Bot1.Modes(1; 2; 3)
Bot1.Target(Bot2.Battlefield.Sol Ring)
Bot1.Target(Bot2)
! Bot1.Modes
? Stack.Count = 1
Bot1.Pass

