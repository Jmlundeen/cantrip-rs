# The other way round: the Ornithopter that was to take 4 damage is bolted by Bot2 in response (tapping its Mox Ruby for
# it), the Mox Ruby is still returned to Bot2's hand, and the Monks, the draw and the life are still done.

[Bot1 Deck]
Black Lotus
Mox Ruby
Mox Pearl
Mox Jet
Mox Emerald
Jeskai Revelation
Island
Island x10

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Plains x16

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Jeskai Revelation.Cast
Bot1.Target(Bot2.Battlefield.Mox Ruby)
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot2.Battlefield.Count = 0
Bot2.Life = 20
Bot1.Life = 24
Bot1.Battlefield.Count = 6
Bot1.Hand.Count = 4
Bot2.Hand.Count = 6
