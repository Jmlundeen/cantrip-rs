# Circle of Protection: Blue prevents the chosen blue source's next damage this turn (CR 615.1). Colorless Ornithopter and red Raging Goblin are not blue sources, so
# they are refused (CR 105.2); one shield stops only the next damage of the chosen source, so the same creature deals
# damage the next turn.

[Bot1 Deck]
Mox Pearl
Mox Ruby
Circle of Protection: Blue
Ornithopter
Island x20

[Bot2 Deck]
Mox Sapphire
Mox Sapphire
Mox Ruby
Merfolk of the Pearl Trident
Merfolk of the Pearl Trident
Raging Goblin
Island x20

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Circle of Protection: Blue.Cast
? Bot1.Mana =
[T2 Bot2.Main1]
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Sapphire#1.Activate
Bot2.Hand.Merfolk of the Pearl Trident.Cast
Bot2.Battlefield.Mox Sapphire#2.Activate
Bot2.Hand.Merfolk of the Pearl Trident.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Raging Goblin.Cast
[T4 Bot2.BeginCombat]
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Circle of Protection: Blue.Activate
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
! Bot1.Choose(Ornithopter)
! Bot1.Choose(Raging Goblin)
Bot1.Choose(Merfolk of the Pearl Trident#1)
[T4 Bot2.DeclareAttackers]
Bot2.Attack(Merfolk of the Pearl Trident#1; Merfolk of the Pearl Trident#2; Raging Goblin > Bot1)
[T4 Bot2.Main2]
? Bot1.Life = 18
[T6 Bot2.DeclareAttackers]
Bot2.Attack(Merfolk of the Pearl Trident#1; Merfolk of the Pearl Trident#2; Raging Goblin > Bot1)
[T6 Bot2.Main2]

[Expect]
Bot1.Life = 15
