Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Garruk, Veiled Butcher.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Elvish Mystic.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Garruk, Veiled Butcher.Activate(Ability: Each player sacrifices)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Exile = Elvish Mystic
Bot2.Graveyard.Count = 0
Bot1.Battlefield = Garruk, Veiled Butcher; Mox Jet; Mox Jet
Bot1.Battlefield.Garruk, Veiled Butcher.Counters.Loyalty = 3
