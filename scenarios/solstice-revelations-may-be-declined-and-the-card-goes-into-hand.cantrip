# Solstice Revelations is a "may": with two Mountains, the Ornithopter (mana value 0, less than 2) exiled after the Forest may be cast free,
# and when Bot1 declines it goes into Bot1's hand instead - the Forest stays in exile.

[Bot1 Deck]
Mountain
Mountain
Mox Ruby
Mox Jet
Mox Sapphire
Solstice Revelations
Island
Island
Forest
Ornithopter
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Solstice Revelations.Cast
Bot1.Pass
Bot2.Pass
Bot1.Decline

[Expect]
Bot1.Hand.Ornithopter.Colors.Count = 0
Bot1.Exile.Forest.Colors.Count = 0
Bot1.Battlefield.Count = 5
