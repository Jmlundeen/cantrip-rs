# Roaming Throne names Goblin, so "Name Sticker" Goblin's enters ability ("... if it's on the battlefield and you control 9
# or fewer creatures named "Name Sticker" Goblin, roll a 20-sided die") triggers twice (CR 603.2d). Each triggering checks
# its intervening "if" again as it resolves (CR 603.4): the first rolls a 1 and adds {R}{R}{R}{R}; Bot1 then Lightning Bolts
# its own Goblin with one of those, and the second, its Goblin gone, rolls nothing. The pool keeps {R}{R}{R} - a second
# roll would have added four more.
# Mana: turn 1 Black Lotus and Mox Jet pay the Throne; turn 3 Mox Ruby, the Mountain and Mox Jet pay the Goblin's {2}{R}.

[Dice]
1
1

[Bot1 Deck]
Mountain
Black Lotus
Mox Ruby
Mox Jet
Roaming Throne
"Name Sticker" Goblin
Lightning Bolt
Mountain x12

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Red)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Roaming Throne.Cast
Bot1.Modes(Goblin)
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand."Name Sticker" Goblin.Cast
Bot1.Pass
Bot1.Triggers("Name Sticker" Goblin; "Name Sticker" Goblin)
Bot1.Pass
Bot2.Pass
? Bot1.Mana = {R}{R}{R}{R}
Bot1.Hand.Lightning Bolt.Cast("Name Sticker" Goblin)
Bot1.Pass
Bot2.Pass
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Mana = {R}{R}{R}

[Expect]
Turn = 3
Bot1.Graveyard = "Name Sticker" Goblin; Lightning Bolt; Black Lotus
