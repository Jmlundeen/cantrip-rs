# Combustion Man: "destroy target permanent unless its controller has Combustion Man deal damage to them equal to his power." Bot1 pumps
# him with Giant Growth (7/9) while the ability is on the stack, then Bot2 returns him to hand with Unsummon in response. As the
# ability resolves he is not on the battlefield, so the damage is his last-known power, 7 (CR 608.2h, 113.7a) -- not his current power
# in hand (0 or none) and not his printed 4. Bot2, who controls the targeted Memnite, chooses to take it: Bot2 goes to 13 and the Memnite lives.

[Bot1 Deck]
Mox Ruby
Mox Ruby
Mox Jet
Mox Pearl
Mox Sapphire
Combustion Man
Mox Emerald
Giant Growth
Island x12

[Bot2 Deck]
Memnite
Unsummon
Island x18

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Combustion Man.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Memnite.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Hand.Mox Emerald.Cast
Bot1.Attack(Combustion Man > Bot2)
Bot1.Target(Memnite)
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Giant Growth.Cast(Combustion Man)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Combustion Man.Power = 7
Bot1.Pass
Bot2.Battlefield.Island.Activate
Bot2.Hand.Unsummon.Cast(Bot1.Battlefield.Combustion Man)
Bot2.Pass
Bot1.Pass
? Bot1.Hand.Count = 1
Bot1.Pass
Bot2.Accept

[Expect]
Bot2.Life = 13
Bot2.Battlefield.Memnite.Damage = 0
Bot2.Graveyard = Unsummon
