? Bot1.Battlefield.Skullclamp.AttachedTo = Grizzly Bears
? Bot1.Battlefield.Grizzly Bears.Toughness = 1
[T4 Bot2.Main1]
? Bot2.Battlefield.Skullclamp.AttachedTo = (absent)

[Expect]
Bot1.Battlefield = Mox Sapphire; Mox Emerald; Mox Pearl; Grizzly Bears
Bot1.Battlefield.Grizzly Bears.Power = 2
Bot1.Battlefield.Grizzly Bears.Toughness = 2
Bot1.Graveyard = Stolen Uniform
Bot2.Battlefield = Mox Jet; Skullclamp
Bot2.Battlefield.Skullclamp.AttachedTo = (absent)
