Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
Bot2.Hand.Mox Emerald.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Pass
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Faerie Mastermind.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby#1.Activate
Bot1.Hand.Pyroblast.Cast
Bot1.Modes(2)
Bot1.Target(Llanowar Elves)
Bot1.Pass
Bot2.Pass
? Bot2.Battlefield.Llanowar Elves.Power = 1
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Pyroblast.Cast
Bot1.Modes(2)
Bot1.Target(Faerie Mastermind)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Graveyard = Faerie Mastermind
Bot2.Battlefield.Llanowar Elves.Power = 1
Bot1.Graveyard = Pyroblast; Pyroblast
