# Foreboding Ruins: "As this land enters, you may reveal a Swamp or Mountain card from your hand. If you don't, this land
# enters tapped. {T}: Add {B} or {R}" (CR 614.1d, 701.20a, 605.1a). Bot1 reveals a Swamp, so it enters untapped; on turns 3
# and 5 it taps for {B} and for {R}, each the single mana the {T} buys, and it offers no green.

[Bot1 Deck]
Foreboding Ruins
Swamp
Mountain x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Foreboding Ruins.Play
Bot1.Accept
Bot1.Choose(Swamp)
? Bot1.Revealed = Swamp
? Bot2.Revealed = (absent)
? Bot1.Battlefield.Foreboding Ruins.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Foreboding Ruins.Activate(Color: Black)
? Bot1.Mana = {B}
[T5 Bot1.Main1]
! Bot1.Battlefield.Foreboding Ruins.Activate(Color: Green)
Bot1.Battlefield.Foreboding Ruins.Activate(Color: Red)
? Bot1.Mana = {R}

[Expect]
Turn = 5
Bot1.Battlefield.Foreboding Ruins.Tapped = true
