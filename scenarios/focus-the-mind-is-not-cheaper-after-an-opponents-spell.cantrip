# Focus the Mind: "if you've cast another spell this turn" counts only its caster's spells. Bot1 cast Black Lotus on turn 1;
# on Bot2's turn 2 Bot2 casts Memnite, and Bot1, having cast nothing this turn, has only the Lotus's three mana, which cannot
# pay the full {4}{U}, so Focus the Mind cannot be cast (CR 601.2f).

[Bot1 Deck]
Black Lotus
Focus the Mind
Island x18

[Bot2 Deck]
Memnite
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Memnite.Cast
Bot2.Pass
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
! Bot1.Hand.Focus the Mind.Cast(Mana: short)

[Expect]
Stack.Count = 0
Bot2.Battlefield = Memnite
Bot1.Hand.Count = 6
Bot1.Graveyard = Black Lotus
