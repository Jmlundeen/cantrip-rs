# Vigilance (CR 702.20a): Gumato attacks without becoming tapped. The mana ability's own {T} still taps it, so the two
# are told apart - the attack leaves it untapped, the activation taps it.

[Bot1 Deck]
Black Lotus
Black Lotus
Gumato
Island x17

[Bot2 Deck]
Island x20

[Actions]
[T1 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Hand.Gumato.Cast
? Bot1.Mana = {G}
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Gumato > Bot2)
[T3 Bot1.Main2]
? Bot1.Battlefield.Gumato.Tapped = false
? Bot2.Life = 16

[Expect]
Bot1.Battlefield.Gumato.Tapped = false
Bot2.Life = 16
