# Lively Dirge, mode 2: "from YOUR graveyard". Bot2 puts a Guerrilla Gorilla into its own graveyard with Entomb on
# turn 2; Bot1's graveyard has no creature card. On turn 3 Bot1 casts the Dirge for mode 2 alone: no creature card of its
# own is eligible, so nothing is asked (`! Bot1.Choose`) and Bot2's Gorilla stays where it is.

[Bot1 Deck]
Swamp
Swamp
Mox Jet
Mox Pearl
Lively Dirge
Swamp x15

[Bot2 Deck]
Swamp
Entomb
Island
Island
Island
Island
Island
Island
Guerrilla Gorilla
Island x15

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Entomb.Cast
Bot2.Search(Guerrilla Gorilla)
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Lively Dirge.Cast
Bot1.Modes(2)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
! Bot1.Choose
[Bot1.Main2]

[Expect]
Bot1.Graveyard = Lively Dirge
Bot2.Graveyard = Entomb; Guerrilla Gorilla
Bot2.Battlefield.Count = 1
