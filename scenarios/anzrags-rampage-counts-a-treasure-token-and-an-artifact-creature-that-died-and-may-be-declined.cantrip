? Bot2.Battlefield.Count = 0
? Exile = Llanowar Elves; Ragavan, Nimble Pilferer
[T6 Bot2.Upkeep]
? Exile.Count = 2

[Expect]
Bot2.Graveyard = Ornithopter; Island
Bot1.Battlefield = Mountain; Mountain; Mountain; Mox Ruby; Mox Jet; Mox Pearl; Mox Emerald
Bot1.Graveyard = Anzrag's Rampage; Blooming Blast
