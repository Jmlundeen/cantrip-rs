# Emergency Holographic Crew's enters trigger has one legal mode here, surveil 2: the top two cards of Bot1's library
# (Lightning Bolt, Counterspell) are looked at, the Bolt stays on top and the Counterspell goes to the graveyard. The
# {3}{U} is paid exactly by a Black Lotus's three blue and a Mox Sapphire's one.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Emergency Holographic Crew
Island x4
Lightning Bolt
Counterspell
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot2.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Emergency Holographic Crew.Cast
Bot1.Pass
Bot2.Pass
Bot1.Arrange(Lightning Bolt | Counterspell)

[Expect]
Bot1.Graveyard = Counterspell; Black Lotus
Bot1.Library = Lightning Bolt; Island; Island; Island; Island; Island; Island; Island; Island; Island; Island
Bot1.Battlefield.Emergency Holographic Crew.Power = 3
