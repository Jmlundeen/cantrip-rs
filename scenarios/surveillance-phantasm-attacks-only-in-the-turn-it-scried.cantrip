# "As long as you've scried or surveilled this turn": the permission is for the turn it was made in. Bot1 scries with
# Preordain on turn three and does not attack; on turn five, the next turn, the Phantasm has defender again and may not
# attack (the refusal) while Ornithopter does (the control).

[Bot1 Deck]
Island
Mox Sapphire
Surveillance Phantasm
Ornithopter
Preordain
Island
Island x14

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Surveillance Phantasm.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island#2.Activate
Bot1.Hand.Preordain.Cast
Bot1.Arrange(Island; Island)
[T5 Bot1.Main1]
! Bot1.Attack(Surveillance Phantasm > Bot2)
Bot1.Attack(Ornithopter > Bot2)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 20
Bot1.Battlefield.Surveillance Phantasm.Tapped = false
Bot1.Battlefield.Ornithopter.Tapped = true
