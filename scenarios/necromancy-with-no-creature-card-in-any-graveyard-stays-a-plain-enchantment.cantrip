# Necromancy: "Put target creature card from a graveyard onto the battlefield under your control and attach this enchantment
# to it." With no creature card in any graveyard its enters trigger has no target and is removed from the stack (CR 603.3d),
# so it never becomes an Aura: it stays on the battlefield as a plain Enchantment, enchanting nothing.

[Bot1 Deck]
Mox Jet
Mox Pearl
Mox Ruby
Necromancy
Island x15

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Necromancy.Cast
Bot1.Pass
Bot2.Pass
[Bot1.Main2]

[Expect]
Bot1.Battlefield.Necromancy.Types = Enchantment
Bot1.Battlefield.Necromancy.Subtypes = (absent)
Bot1.Battlefield.Necromancy.AttachedTo = (absent)
Stack.Count = 0
