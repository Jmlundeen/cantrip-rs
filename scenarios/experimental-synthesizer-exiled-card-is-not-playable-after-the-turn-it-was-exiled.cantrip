# itself is experimental-synthesizer-enters-and-leaves-each-exile-a-card-to-play-and-the-sacrifice-makes-a-samurai.

[Bot1 Deck]
Mox Ruby
Experimental Synthesizer
Island x5
Mox Sapphire
Island x14

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Experimental Synthesizer.Cast
Bot1.Pass
Bot1.Pass
[T3 Bot1.Main1]
! Bot1.Exile.Mox Sapphire.Cast

[Expect]
Exile = Mox Sapphire
Bot1.Battlefield = Experimental Synthesizer; Mox Ruby
