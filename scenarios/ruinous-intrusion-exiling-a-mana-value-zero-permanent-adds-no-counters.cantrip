# Ruinous Intrusion: X is the exiled permanent's mana value: a Mox Jet is 0, so the exile happens and the Ornithopter gets
# nothing.

[Bot1 Deck]
Forest
Mox Emerald
Mox Pearl
Mox Jet
Mox Ruby
Ornithopter
Ruinous Intrusion
Forest x13

[Bot2 Deck]
Mox Jet
Island x19

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Ornithopter.Cast
Bot2.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Ruinous Intrusion.Cast
Bot1.Target(Bot2.Battlefield.Mox Jet)
Bot1.Target(Ornithopter)

[Expect]
Exile = Mox Jet
Bot1.Battlefield.Ornithopter.Counters.PlusOnePlusOne = (absent)
