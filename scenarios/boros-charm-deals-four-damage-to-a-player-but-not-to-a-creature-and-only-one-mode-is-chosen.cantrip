# Boros Charm: "Choose one" - two modes cannot be chosen (the refusal of modes 1 and 2 together beside the choice of mode 1
# alone). The first mode deals 4 damage to target player or planeswalker: Bot2's Ornithopter is a creature, not a legal target
# (the positive control is Bot2 himself, who goes from 20 to 16).

[Bot1 Deck]
Mox Ruby
Mox Pearl
Boros Charm
Island x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Boros Charm.Cast
! Bot1.Modes(1; 2)
Bot1.Modes(1)
! Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Target(Bot2)
Bot1.Pass
Bot2.Pass

[Expect]
Bot2.Life = 16
Bot2.Battlefield = Ornithopter
Bot1.Graveyard = Boros Charm
