Bot2.Block(Ironroot Treefolk > Balduvian Bears; Ironroot Treefolk > Bear Cub; Ironroot Treefolk > Barbary Apes)
Bot2.AssignDamage(Ironroot Treefolk > Balduvian Bears: 2; Ironroot Treefolk > Bear Cub: 1)
