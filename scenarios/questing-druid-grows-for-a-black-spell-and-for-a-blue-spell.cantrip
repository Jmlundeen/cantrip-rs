# Questing Druid grows for each spell that is black (Duress) or blue (Brainstorm), one counter each (CR 603.2): two counters,
# so a 3/3. The Druid is on the battlefield before either is cast; its own cast (green) triggered nothing.

[Bot1 Deck]
Forest
Mox Emerald
Questing Druid
Mox Jet
Mox Sapphire
Duress
Brainstorm
Forest x12

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Questing Druid.Cast
Bot1.Pass
Bot1.Hand.Mox Jet.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Duress.Cast(Bot2)
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
? Bot1.Battlefield.Questing Druid.Power = 2
Bot1.Hand.Brainstorm.Cast
Bot1.Pass
[T1 Bot1.Main2]

[Expect]
Bot1.Battlefield.Questing Druid.Counters.PlusOnePlusOne = 2
Bot1.Battlefield.Questing Druid.Power = 3
Bot1.Battlefield.Questing Druid.Toughness = 3
