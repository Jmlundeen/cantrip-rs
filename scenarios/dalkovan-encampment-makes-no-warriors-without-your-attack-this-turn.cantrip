Bot2.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Dalkovan Encampment.Activate(Ability: Whenever you attack)
Bot1.Pass
Bot2.Pass
Bot2.Attack(Ornithopter > Bot1)
? Combat.Attackers.Count = 1
[T4 Bot2.Main2]
? Bot1.Battlefield = Mountain; Dalkovan Encampment; Mox Pearl; Mox Jet; Mox Ruby; Ornithopter
[T5 Bot1.Main1]
Bot1.Pass
Bot1.Attack(Ornithopter > Bot2)
? Combat.Attackers.Count = 1
Bot1.Pass
Bot2.Pass
[T5 Bot1.Main2]

