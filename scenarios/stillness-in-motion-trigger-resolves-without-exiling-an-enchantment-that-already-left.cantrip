# With Stillness in Motion's upkeep trigger on the stack, Bot2 destroys the Enchantment with Disenchant. The ability is independent
# of its source (CR 113.7a): it mills the library's last three cards, finds it empty, and cannot exile the Enchantment (now a
# new object in the graveyard, CR 400.7) - but still puts cards back, and the Enchantment is among the four in the graveyard.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Stillness in Motion
Island x4
Lightning Bolt
Shock
Giant Growth

[Bot2 Deck]
Mox Pearl
Mox Jet
Disenchant
Island x20

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Mox Ruby.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Stillness in Motion.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Pearl.Cast
Bot2.Pass
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
[T3 Bot1.Upkeep]
Bot1.Pass
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Disenchant.Cast(Bot1.Battlefield.Stillness in Motion)
Bot2.Pass
Bot1.Pass
Bot1.Choose(Stillness in Motion; Lightning Bolt; Shock; Giant Growth)
Bot1.Arrange(Giant Growth; Stillness in Motion; Shock; Lightning Bolt)
[T3 Bot1.Main1]

[Expect]
Turn = 3
Exile.Count = 0
Bot1.Graveyard.Count = 0
Bot1.Hand.Giant Growth.Colors = Green
Bot1.Library = Stillness in Motion; Shock; Lightning Bolt
Bot2.Graveyard = Disenchant
