# Bot1 activates Mistrise Village on turn 3. With the effect waiting, Bot2 casts Lightning Bolt at Bot1: "the next spell
# YOU cast" (CR 611.2c) is Bot1's, so the Bolt is not marked and the effect is not used up. Bot1 counters it with
# Counterspell, which is Bot1's next spell and so can't be countered: Bot2's own Counterspell in response does nothing.
# The Bolt is countered, Bot1 stays at 20, and both Counterspells end in graveyards.

[Bot1 Deck]
Forest
Mox Sapphire
Mox Sapphire
Mox Sapphire
Mistrise Village
Counterspell
Forest
Forest x10

[Bot2 Deck]
Island
Mox Sapphire
Mox Ruby
Lightning Bolt
Counterspell
Forest x14

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mistrise Village.Play
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mistrise Village.Activate(Ability: next spell)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
? Stack = Lightning Bolt
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Counterspell.Cast(Stack.Lightning Bolt)
? Stack = Counterspell; Lightning Bolt
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Counterspell)
? Stack = Counterspell; Counterspell; Lightning Bolt
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Stack.Count = 0
Bot1.Life = 20
Bot1.Graveyard = Counterspell
Bot2.Graveyard = Lightning Bolt; Counterspell
