# Enroot searches for a land card, and a search for a quality may find nothing (CR 701.23b): Bot1's library holds no land, so Bot1 finds nothing (the search is answered
# with none), the graveyard stays empty and the library keeps its three cards. The copy is still cast, so the Cultivator is no
# longer prepared and the copy is gone.

[Bot1 Deck]
Carnivorous Cultivator
Forest x6
Lightning Bolt
Counterspell
Duress
Ornithopter
Ornithopter

[Bot2 Deck]
Mountain x20

[Actions]
Bot1.Hand.Forest.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Hand.Carnivorous Cultivator.Cast
Bot1.Pass
[T5 Bot1.Main1]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Exile.Enroot.Cast
! Bot1.Search(Ornithopter)
Bot1.Search()
[T5 Bot1.Main2]

[Expect]
Bot1.Graveyard.Count = 0
Bot1.Library.Count = 3
Exile.Count = 0
Bot1.Battlefield.Carnivorous Cultivator.Prepared = (absent)
Bot1.Hand = Forest; Forest; Forest; Lightning Bolt; Counterspell
Stack.Count = 0
