# Harmonic Prodigy doubles the triggered abilities of a Shaman its controller controls (CR 603.2d): Ignoble Hierarch, a
# Goblin Shaman, has exalted. The Prodigy attacks alone, the Hierarch's exalted triggers twice, and a 1/3 Prodigy becomes
# 3/5 and deals 3.
# Turn 1: the Hierarch (Forest) and the Prodigy (Mox Ruby, Mox Jet). Turn 3: the attack.

[Bot1 Deck]
Forest
Ignoble Hierarch
Mox Ruby
Mox Jet
Harmonic Prodigy
Island x15

[Bot2 Deck]
Swamp x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Ignoble Hierarch.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Harmonic Prodigy.Cast
[T3 Bot1.Main1]
Bot1.Attack(Harmonic Prodigy > Bot2)
Bot1.Triggers(Ignoble Hierarch; Ignoble Hierarch)
[T3 Bot1.DeclareBlockers]
? Bot1.Battlefield.Harmonic Prodigy.Power = 3
? Bot1.Battlefield.Harmonic Prodigy.Toughness = 5
[T3 Bot1.Main2]

[Expect]
Bot2.Life = 17
