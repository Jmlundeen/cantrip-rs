# CR 117.4, 104.3a (the owner's ruling, 2026-11-05): conceding is a player's action, so passes made before it no longer count
# toward "all players pass in succession". In a game of three Bot1's Zenos yae Galvus chooses Bot2's Ornithopter, which Bot1
# kills, and Zenos transforms into Shinryu, Transcendent Rival, choosing Bot3. With a spell of nothing on the stack Bot1 and
# Bot2 pass and Bot3, holding priority, concedes: "When the chosen player loses the game, you win the game" goes on the stack.
# Bot1 and Bot2 have passed already, but both must pass again with the trigger waiting - Bot2 gets priority with it - before
# it resolves and Bot1 wins.

[Life]
Bot3: 3

[Bot1 Deck]
Swamp
Black Lotus
Mox Jet
Mox Ruby
Zenos yae Galvus
Lightning Bolt
Lightning Bolt
Mountain
Swamp x10

[Bot2 Deck]
Ornithopter
Island x20

[Bot3 Deck]
Forest x20

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T4 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Zenos yae Galvus.Cast
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Choose(Ornithopter)
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.Pass
Bot2.Pass
Bot3.Pass
Bot1.ChoosePlayer(Bot3)
? Bot1.Battlefield.Shinryu, Transcendent Rival.Power = 8
? Result = InProgress
Bot1.Pass
Bot2.Pass
Bot3.Concede
? Stack = Shinryu, Transcendent Rival
? PriorityPlayer = Bot1
Bot1.Pass
? Result = InProgress
? Stack = Shinryu, Transcendent Rival
? PriorityPlayer = Bot2
Bot2.Pass

[Expect]
Result = Bot1 won
Bot2.Status = Lost
Bot3.Status = Lost
