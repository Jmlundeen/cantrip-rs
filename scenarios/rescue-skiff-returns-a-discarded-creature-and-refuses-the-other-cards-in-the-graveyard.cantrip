Bot1.Pass
! Bot1.Target(Bot1.Graveyard.Black Lotus)
! Bot1.Target(Bot1.Graveyard.Faithless Looting)
Bot1.Target(Bot1.Graveyard.Ornithopter)
Bot1.Pass
