Bot1.Hand.Vindicate.Cast(Bot2.Battlefield.Island)
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Precise Redaction.Cast(Stack.Vindicate)
Bot1.Pass
Bot2.Pass

