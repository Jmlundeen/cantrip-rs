# Choked Estuary: "As this land enters, you may reveal an Island or Swamp card from your hand. If you don't, this land
# enters tapped. {T}: Add {U} or {B}" (CR 614.1d, 701.20a, 605.1a). Bot1 reveals an Island, so it enters untapped; on turns
# 3 and 5 it taps for {U} and for {B}, each the single mana the {T} cost buys, and it offers no green.

[Bot1 Deck]
Choked Estuary
Island x19

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Choked Estuary.Play
Bot1.Accept
Bot1.Choose(Island)
? Bot1.Revealed = Island
? Bot2.Revealed = (absent)
? Bot1.Battlefield.Choked Estuary.Tapped = false
[T3 Bot1.Main1]
Bot1.Battlefield.Choked Estuary.Activate(Color: Blue)
? Bot1.Mana = {U}
[T5 Bot1.Main1]
! Bot1.Battlefield.Choked Estuary.Activate(Color: Green)
Bot1.Battlefield.Choked Estuary.Activate(Color: Black)
? Bot1.Mana = {B}

[Expect]
Turn = 5
Bot1.Battlefield.Choked Estuary.Tapped = true
