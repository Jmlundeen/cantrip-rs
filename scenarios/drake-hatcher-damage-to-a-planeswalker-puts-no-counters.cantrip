# Drake Hatcher's trigger is for combat damage "to a player". On turn 3 it attacks Bot2's Liliana of the Veil (loyalty 3):
# the 1 damage is dealt to the planeswalker (loyalty 2), so no incubation counters are put on it. On turn 5 it attacks
# Bot2 instead and gets one, the control that shows the trigger works where the first hit was not to a player.

[Bot1 Deck]
Island
Mox Sapphire
Drake Hatcher
Island x17

[Bot2 Deck]
Swamp
Mox Jet
Mox Ruby
Liliana of the Veil
Swamp x16

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Drake Hatcher.Cast
Bot2.Hand.Swamp.Play
Bot2.Hand.Mox Jet.Cast
Bot2.Pass
Bot2.Hand.Mox Ruby.Cast
Bot2.Pass
Bot2.Battlefield.Swamp.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Liliana of the Veil.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Attack(Drake Hatcher > Bot2.Battlefield.Liliana of the Veil)
[T3 Bot1.Main2]
? Bot2.Battlefield.Liliana of the Veil.Counters.Loyalty = 2
? Bot2.Life = 20
? Bot1.Battlefield.Drake Hatcher.Counters.Incubation = (absent)
[T5 Bot1.Main1]
Bot1.Attack(Drake Hatcher > Bot2)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 19
Bot1.Battlefield.Drake Hatcher.Counters.Incubation = 1
