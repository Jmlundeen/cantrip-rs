# Known bug: a target slot of "one or two" cannot be announced with one target while two are legal (CR 601.2c).
# Untimely Malfunction's third mode may take just one of the two legal targets ("one or two target creatures", CR 601.2c): only the chosen Ornithopter can't block, so the other blocks the Elves and no damage is dealt.

[Bot1 Deck]
Forest
Llanowar Elves
Mountain
Untimely Malfunction
Mountain x20

[Bot2 Deck]
Ornithopter
Ornithopter
Island x20

[Actions]
Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Hand.Llanowar Elves.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Untimely Malfunction.Cast
Bot1.Modes(3)
Bot1.Target(Ornithopter#1)
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Forest.Activate
Bot1.Pass
Bot1.Attack(Llanowar Elves)
! Bot2.Block(Ornithopter#1 > Llanowar Elves)
Bot2.Block(Ornithopter#2 > Llanowar Elves)
[T3 Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Graveyard.Count = 0
Stack.Count = 0
