# Control for the promised-gift scenario: Bilbo's Gambit cast without the gift just returns Bot2's Lightning Bolt to its
# owner's hand. Bot2 creates no Treasure and nobody is barred from casting, so Bot2 casts the Bolt again with its second
# Mox Ruby and it resolves (Bot1 goes to 17 after it, not 20).

[Bot1 Deck]
Plains
Mox Pearl
Bilbo's Gambit
Plains x15

[Bot2 Deck]
Mox Ruby
Mox Ruby
Lightning Bolt
Plains x14

[Actions]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Hand.Mox Ruby.Cast
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bilbo's Gambit.Cast
Bot1.Decline
Bot1.Target(Stack.Lightning Bolt)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0
? Bot1.Life = 20
? Bot2.Battlefield = Mox Ruby; Mox Ruby
Bot2.Battlefield.Mox Ruby#2.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
Bot2.Pass

[Expect]
Bot1.Life = 17
Bot2.Graveyard = Lightning Bolt
Bot1.Graveyard = Bilbo's Gambit
