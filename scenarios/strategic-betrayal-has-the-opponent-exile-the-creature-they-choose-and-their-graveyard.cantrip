# Strategic Betrayal: Bot2 controls Llanowar Elves and Ornithopter and has Lightning Bolt in its graveyard. Bot2
# chooses the Elves; the Elves and the whole graveyard are exiled. The Ornithopter stays, and Bot1's own graveyard (the
# resolved Strategic Betrayal) is untouched.

[Bot1 Deck]
Swamp
Swamp
Strategic Betrayal
Swamp x14

[Bot2 Deck]
Forest
Mox Ruby
Lightning Bolt
Llanowar Elves
Ornithopter
Forest
Forest x12

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
Bot1.Battlefield.Swamp.Activate
Bot1.Battlefield.Swamp#2.Activate
Bot1.Hand.Strategic Betrayal.Cast(Bot2)
Bot2.Choose(Llanowar Elves)
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield = Forest; Mox Ruby; Ornithopter
Bot2.Graveyard.Count = 0
Exile = Llanowar Elves; Lightning Bolt
Bot1.Graveyard = Strategic Betrayal
Stack.Count = 0
