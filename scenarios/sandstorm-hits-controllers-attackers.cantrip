# Sandstorm also damages its controller's attacking creatures, while an idle
# creature stays unharmed (CR 508.1, 120.3).
[Bot1 Deck]
Sandstorm
Mox Emerald
Ornithopter x2
Memnite
Forest x20

[Bot2 Deck]
Ornithopter
Island x20

[Actions]
Bot1.Hand.Mox Emerald.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Ornithopter.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Attack(Ornithopter#1 > Bot2; Memnite > Bot2)
[T3 Bot1.DeclareBlockers]
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Sandstorm.Cast
? Bot1.Mana =
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#1.Damage = 1
? Bot1.Battlefield.Ornithopter#2.Damage = 0
? Bot2.Battlefield.Ornithopter.Damage = 0
? Bot1.Graveyard = Memnite; Sandstorm
