# Archenemy's Charm, second mode, CR 608.2b: with two targets, one illegal when the spell resolves, it still does what it can
# with the other. Bot1 targets Ornithopter and Chandra in their graveyard; in response Bot2 exiles Chandra with Ghost
# Vacuum, so only the Ornithopter returns to hand and Chandra stays in exile.

[Bot1 Deck]
Mox Ruby
Faithless Looting
Ornithopter
Chandra, Torch of Defiance
Black Lotus
Archenemy's Charm
Swamp
Swamp x25

[Bot2 Deck]
Mox Ruby
Ghost Vacuum
Island x25

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Faithless Looting.Cast
Bot1.Choose(Ornithopter; Chandra, Torch of Defiance)
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Ghost Vacuum.Cast
[T3 Bot1.Main1]
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Hand.Archenemy's Charm.Cast
Bot1.Modes(Return one or two target creature and/or planeswalker cards)
Bot1.Target(Bot1.Graveyard.Ornithopter; Bot1.Graveyard.Chandra, Torch of Defiance)
Bot2.Battlefield.Ghost Vacuum.Activate(Bot1.Graveyard.Chandra, Torch of Defiance)
Bot1.Pass
Bot2.Pass
? Stack.Count = 0

[Expect]
Exile = Chandra, Torch of Defiance
Bot1.Hand = Ornithopter; Swamp; Swamp; Swamp; Swamp
Bot1.Graveyard = Archenemy's Charm; Black Lotus; Faithless Looting
Stack.Count = 0
