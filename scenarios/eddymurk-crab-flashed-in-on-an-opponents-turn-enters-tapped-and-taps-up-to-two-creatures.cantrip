Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Eddymurk Crab.Cast
Bot1.Pass
! Bot1.Target(Llanowar Elves#1; Llanowar Elves#2; Ornithopter)
Bot1.Target(Llanowar Elves#1; Llanowar Elves#2)
Bot1.Pass
Bot1.Pass

