Bot1.Emblems.Count = 1
Bot1.Battlefield = Daretti, Scrap Savant; Mox Ruby; Mox Jet; Mox Sapphire; Mox Pearl
Bot1.Graveyard = Ornithopter; Pyroclasm; Island; Island; Island; Island
Bot2.Battlefield = Plains; Mox Pearl
