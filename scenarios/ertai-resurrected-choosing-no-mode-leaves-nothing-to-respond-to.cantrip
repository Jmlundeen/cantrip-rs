# Ertai Resurrected: "choose up to one" - when Bot1 chooses no mode for its enters trigger, the ability is removed from
# the stack as it is put there (CR 603.3c, 700.2b). Nobody gets priority with it on the stack: when Bot2 then casts
# Lightning Bolt, the Bolt is alone on the stack, with no empty Ertai trigger under it to respond to.

[Bot1 Deck]
Black Lotus
Mox Sapphire
Ertai Resurrected
Island x4
Island x10

[Bot2 Deck]
Mountain
Ornithopter
Lightning Bolt
Plains x4
Plains x12

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Black)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Ertai Resurrected.Cast
Bot1.Modes()
? Stack.Count = 0
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
? Stack = Lightning Bolt
[T2 Bot2.Main2]

[Expect]
Turn = 2
Stack.Count = 0
Bot1.Life = 17
Bot1.Battlefield = Mox Sapphire; Ertai Resurrected
Bot2.Battlefield = Mountain; Ornithopter
Bot2.Graveyard = Lightning Bolt
Bot2.Hand.Count = 5
Bot1.Hand.Count = 4
