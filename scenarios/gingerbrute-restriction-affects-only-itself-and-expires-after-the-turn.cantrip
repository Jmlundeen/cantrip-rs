Bot1.Attack(Gingerbrute#1 > Bot2; Gingerbrute#2 > Bot2; Gingerbrute#3 > Bot2)
! Bot2.Block(Llanowar Elves > Gingerbrute#1)
! Bot2.Block(Llanowar Elves > Gingerbrute#2)
Bot2.Block(Fanatical Firebrand > Gingerbrute#2; Llanowar Elves > Gingerbrute#3)
[T3 Bot1.Main2]
? Bot2.Life = 19
? Bot1.Battlefield.Gingerbrute.BlockRestriction = Can't be blocked except by creatures with haste
[T4 Bot2.Main1]
