# "an Island or Swamp card from your hand" (CR 701.20a, 400.7): Bot2's hand holds Islands but Bot1's holds none - and the
# other Choked Estuary in Bot1's hand cannot be revealed either, because a land is not an Island or a Swamp just because it
# can make the corresponding mana. So Bot1 reveals nothing and this one enters tapped.

[Bot1 Deck]
Choked Estuary
Choked Estuary
Mountain x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Choked Estuary.Play
Bot1.Accept
? Bot1.Battlefield.Choked Estuary.Tapped = true

[Expect]
Turn = 1
Bot1.Battlefield.Choked Estuary.Tapped = true
Bot1.Hand.Count = 6
Bot2.Hand.Count = 7
