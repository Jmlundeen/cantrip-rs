Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Super-Soldier Serum.Cast(Ornithopter#2)
Bot1.Pass
Bot1.Choose(Ornithopter)
[T5 Bot1.Main1]
Bot1.Attack(Ornithopter > Bot2)
[T5 Bot1.Main2]

[Expect]
Bot2.Life = 18
Bot1.Battlefield.Ornithopter.Power = 2
Bot1.Battlefield.Ornithopter.Toughness = 4
Bot1.Graveyard = Super-Soldier Serum; Ornithopter
