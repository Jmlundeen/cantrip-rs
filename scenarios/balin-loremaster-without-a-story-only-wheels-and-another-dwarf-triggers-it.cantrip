# Balin, Loremaster: Balin and Mox Ruby are two, so when Balin enters on turn seven Bot1 has no enduring story: Bot1 discards
# its hand of four and draws four, and Bot2 takes nothing. On turn nine Magda, another Dwarf, enters - and is the third, so
# Bot1 now has the story - and Balin triggers again ("Whenever Balin or another Dwarf you control enters"): Bot1 declines
# to discard ("you may"), and nothing happens.

[Bot1 Deck]
Mountain
Mox Ruby
Mountain
Mountain
Mountain
Balin, Loremaster
Plains
Island
Island
Island
Magda, Brazen Outlaw
Swamp
Swamp
Swamp
Swamp
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
[T5 Bot1.Main1]
Bot1.Hand.Mountain.Play
[T7 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Balin, Loremaster.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Pass
? Bot1.Hand = Plains; Island; Island; Island
Bot1.Accept
[T7 Bot1.Main2]
? Bot1.EnduringStory = (absent)
? Bot2.Life = 20
? Bot1.Hand = Magda, Brazen Outlaw; Swamp; Swamp; Swamp
[T9 Bot1.Main1]
Bot1.Hand.Magda, Brazen Outlaw.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mountain.Activate
Bot1.Pass
Bot1.Decline
[T9 Bot1.Main2]

[Expect]
Bot1.EnduringStory = true
Bot1.Graveyard = Island; Island; Island; Plains
Bot1.Hand = Swamp; Swamp; Swamp; Swamp
Bot2.Life = 20
