Bot2.Hand.Mox Ruby.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Shatter.Cast(Bot1.Battlefield.Firdoch Core)
[T4 Bot2.End]
? Bot2.Graveyard = Shatter

[Expect]
Bot1.Battlefield.Firdoch Core.Tapped = false
Bot1.Graveyard.Count = 0
