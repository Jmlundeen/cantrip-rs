# Scry 2 may put both looked-at cards on the bottom (CR 701.22a): Lightning Bolt then Black Lotus go under the library, so the
# draw takes the third card, Counterspell, which was not looked at.

[Bot1 Deck]
Island
Preordain
Island
Island
Island
Island
Island
Lightning Bolt
Black Lotus
Counterspell
Mountain

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Preordain.Cast
Bot1.Arrange( | Lightning Bolt; Black Lotus)

[Expect]
Bot1.Hand = Island; Island; Island; Island; Island; Counterspell
Bot1.Library = Mountain; Lightning Bolt; Black Lotus
