# "Up to one target": Thor's attack trigger may be given no target, and then nothing is exiled. Bot2's Ornithopter stays
# untapped on the battlefield and, being a flyer, could block, but Bot2 does not; Thor connects.

[Bot1 Deck]
Mox Pearl
Mox Sapphire
Mox Ruby
The Mighty Thor, Jane Foster
Plains x16

[Bot2 Deck]
Ornithopter
Plains x19

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.The Mighty Thor, Jane Foster.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Attack(The Mighty Thor, Jane Foster > Bot2)
Bot1.Target()
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield.Ornithopter.Tapped = false
Bot2.Life = 17
