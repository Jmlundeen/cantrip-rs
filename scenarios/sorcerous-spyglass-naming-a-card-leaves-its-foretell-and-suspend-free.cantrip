Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Black Lotus.Cast
Bot2.Hand.Mox Jet.Cast
Bot2.Hand.Mox Pearl.Cast
Bot2.Hand.Mox Sapphire.Cast
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Hand.Sorcerous Spyglass.Cast
Bot2.Name(Delayed Blast Fireball)
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Island.Activate
Bot2.Hand.Sorcerous Spyglass.Cast
Bot2.Name(Lotus Bloom)
Bot2.Battlefield.Black Lotus.Activate(Color: Blue)
Bot2.Hand.Sorcerous Spyglass.Cast
Bot2.Name(Miscalculation)
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
! Bot1.Hand.Miscalculation.Activate(Ability: Cycling)
Bot1.Hand.Lotus Bloom.Suspend
Bot1.Hand.Delayed Blast Fireball.Foretell
Bot1.Battlefield.Mountain#1.Activate
Bot1.Battlefield.Mountain#2.Activate
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield = Island; Mox Jet; Mox Pearl; Mox Sapphire; Sorcerous Spyglass; Sorcerous Spyglass; Sorcerous Spyglass
Bot1.Hand = Miscalculation; Island
Exile.Count = 2
Bot1.Exile.Lotus Bloom.Counters.Time = 3
