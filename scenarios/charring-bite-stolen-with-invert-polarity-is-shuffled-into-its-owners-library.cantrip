# "As an Omen spell resolves, its controller shuffles it into its owner's library" (CR 720.3d): owner, not controller.
# Bot1 aims Charring Bite at its own Llanowar Elves; Bot2 casts Invert Polarity on it and wins the flip (the die's first
# face), so Bot2 controls the Bite as it resolves (the Elves is the only creature without flying, so no new target is
# asked for). The Elves dies, and the Bite goes into Bot1's library, not Bot2's: Bot1's grows from seven to eight and
# Bot2's stays at the seven left after its turn-2 draw.

[Bot1 Deck]
Forest
Llanowar Elves
Mountain
Mox Ruby
Twinmaw Stormbrood
Island
Island
Island x8

[Bot2 Deck]
Island
Mox Sapphire
Mox Ruby
Invert Polarity
Island
Island
Island
Island x8

[Dice]
1

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Llanowar Elves.Cast
Bot1.Battlefield.Forest.Activate
[T2 Bot2.Main1]
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Hand.Mox Ruby.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Twinmaw Stormbrood.Cast(Bot1.Battlefield.Llanowar Elves; Ability: Omen)
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot2.Hand.Invert Polarity.Cast(Stack.Charring Bite)
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Battlefield.Mox Ruby.Activate
[T3 Bot1.Main2]

[Expect]
Stack.Count = 0
Bot1.Graveyard = Llanowar Elves
Bot1.Library.Count = 8
Bot2.Library.Count = 7
Bot2.Graveyard = Invert Polarity
Exile.Count = 0
