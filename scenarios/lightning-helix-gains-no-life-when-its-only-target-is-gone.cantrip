# Its only target is illegal on resolution (CR 608.2b), so the spell does nothing at all - no life either: Bot2 bolts its
# own Ornithopter in response to the Helix.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Lightning Helix
Plains x16

[Bot2 Deck]
Mox Ruby
Ornithopter
Lightning Bolt
Plains x16

[Actions]
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Lightning Helix.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Graveyard = Lightning Helix
Bot1.Life = 20
Bot2.Life = 20
