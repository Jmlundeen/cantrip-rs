# Blooming Marsh: "This land enters tapped unless you control two or fewer other lands." Only lands its controller
# controls count (CR 614.1d, "you control"): on turn 7 Bot1 has two other lands while Bot2 has three, and the Marsh
# enters untapped. It adds {B} or {G} and nothing else: white, blue, red and colorless are refused beside the black
# it does add (the positive control).

[Bot1 Deck]
Forest
Forest
Blooming Marsh
Forest x15

[Bot2 Deck]
Plains x20

[Actions]
Bot1.Hand.Forest.Play
[T2 Bot2.Main1]
Bot2.Hand.Plains.Play
[T3 Bot1.Main1]
Bot1.Hand.Forest.Play
[T4 Bot2.Main1]
Bot2.Hand.Plains.Play
[T6 Bot2.Main1]
Bot2.Hand.Plains.Play
[T7 Bot1.Main1]
Bot1.Hand.Blooming Marsh.Play
? Bot1.Battlefield.Blooming Marsh.Tapped = false
! Bot1.Battlefield.Blooming Marsh.Activate(Color: White)
! Bot1.Battlefield.Blooming Marsh.Activate(Color: Blue)
! Bot1.Battlefield.Blooming Marsh.Activate(Color: Red)
! Bot1.Battlefield.Blooming Marsh.Activate(Color: Colorless)
Bot1.Battlefield.Blooming Marsh.Activate(Color: Black)
? Bot1.Mana = {B}

[Expect]
Bot1.Battlefield.Blooming Marsh.Tapped = true
Bot2.Battlefield.Count = 3
