? Bot1.Battlefield.Ornithopter.Damage = 0
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Island.Activate
Bot2.Hand.Infernal Grasp.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Pass
Bot1.Pass
