? Bot2.Battlefield.Ornithopter.Counters.Stun = 2
[T5 Bot1.Main1]
! Bot1.Exile.Mountain.Play
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Exile.Lightning Bolt.Cast(Bot2)

