# Spire of Industry prints two mana abilities (CR 605.1a): "{T}: Add {C}." costs nothing, while "{T}, Pay 1 life:
# Add one mana of any color. Activate only if you control an artifact." costs the life as it resolves (a mana ability
# has no stack, CR 605.3b) and names its color as it resolves, with the Mox Sapphire counting for the condition.
# Bot1 taps it for {C} on turn 3 and stays at 20, for {W} on turn 5 and for {U} on turn 7, one life each.

[Bot1 Deck]
Spire of Industry
Mox Sapphire
Island x18

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Spire of Industry.Play
Bot1.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Spire of Industry.Activate(Ability: {C})
? Bot1.Mana = {C}
? Bot1.Life = 20
[T5 Bot1.Main1]
Bot1.Battlefield.Spire of Industry.Activate(Ability: any color; Color: White)
? Bot1.Mana = {W}
? Bot1.Life = 19
[T7 Bot1.Main1]
Bot1.Battlefield.Spire of Industry.Activate(Ability: any color; Color: Blue)
? Bot1.Mana = {U}
? Bot1.Life = 18

[Expect]
Turn = 7
Bot1.Battlefield.Spire of Industry.Tapped = true
Bot1.Life = 18
