# Raubahn's trigger aimed at the Equipment already on Raubahn and at Raubahn himself (CR 701.3b: nothing happens when an
# Equipment is attached to what it is attached to): the Bloodforged Battle-Axe, equipped for {2} on turn 3, stays on him,
# he is still a 4/2, and Bot2 takes 4.

[Bot1 Deck]
Mox Ruby
Mox Pearl
Mountain
Raubahn, Bull of Ala Mhigo
Bloodforged Battle-Axe
Island
Island x10

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Mountain.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Battlefield.Mountain.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Raubahn, Bull of Ala Mhigo.Cast
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Bloodforged Battle-Axe.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Bloodforged Battle-Axe.Activate(Raubahn, Bull of Ala Mhigo)
[T3 Bot1.DeclareAttackers]
Bot1.Attack(Raubahn, Bull of Ala Mhigo > Bot2)
Bot1.Target(Bloodforged Battle-Axe)
Bot1.Target(Raubahn, Bull of Ala Mhigo)
[T3 Bot1.DeclareBlockers]
? Bot1.Battlefield.Bloodforged Battle-Axe.AttachedTo = Raubahn, Bull of Ala Mhigo
[T4 Bot2.Main1]
? Bot2.Life = 16

[Expect]
Bot1.Battlefield.Bloodforged Battle-Axe#2.Token = true
Bot1.Battlefield.Bloodforged Battle-Axe#2.AttachedTo = (absent)
Bot2.Life = 16
Bot1.Battlefield.Raubahn, Bull of Ala Mhigo.Power = 4
Bot1.Battlefield.Bloodforged Battle-Axe#1.AttachedTo = Raubahn, Bull of Ala Mhigo
