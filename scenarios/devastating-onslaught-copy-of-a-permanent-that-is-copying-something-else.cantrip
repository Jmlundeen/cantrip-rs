# Ruling 2025-07-25: "If the copied permanent is copying something else, then the tokens enter as whatever that permanent
# copied." Bot1's Phyrexian Metamorph entered as a copy of Ornithopter (the artifact-in-addition exception changes nothing for
# an artifact creature). Devastating Onslaught for X=1 on the Metamorph makes a token that is a copy of what it copies, an
# Ornithopter: a colorless 0/2 Artifact Creature - Thopter with flying (and haste), NOT a Phyrexian Shapeshifter. It is
# sacrificed at the end step; the Metamorph-as-Ornithopter remains.

[Bot1 Deck]
Mox Sapphire
Mox Ruby
Mox Pearl
Mox Jet
Ornithopter
Phyrexian Metamorph
Devastating Onslaught
Island x12

[Bot2 Deck]
Plains x16

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Phyrexian Metamorph.Cast
Bot1.Accept
Bot1.Target(Ornithopter)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#2.Subtypes = Thopter
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Devastating Onslaught.Cast(Ornithopter#2; X: 1)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Ornithopter#3.Token = true
? Bot1.Battlefield.Ornithopter#3.Types = Artifact; Creature
? Bot1.Battlefield.Ornithopter#3.Subtypes = Thopter
? Bot1.Battlefield.Ornithopter#3.Keywords = Flying; Haste
? Bot1.Battlefield.Ornithopter#3.Toughness = 2
[T3 Bot1.End]
Bot1.Pass

[Expect]
Bot1.Battlefield = Mox Sapphire; Mox Ruby; Mox Pearl; Mox Jet; Ornithopter; Ornithopter
Bot1.Battlefield.Count = 6
Bot1.Graveyard = Devastating Onslaught
