# Tapping Candelabra is part of its cost (CR 602.2b): after the ability resolves it stays tapped, so a second activation
# (X of 1, with an untapped Island to pay) is refused, though the first activation (the positive control) was offered.

[Bot1 Deck]
Candelabra of Tawnos
Island
Island
Island x13

[Bot2 Deck]
Island x16

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Candelabra of Tawnos.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Candelabra of Tawnos.Activate(X: 2)
Bot1.Target(Bot1.Battlefield.Island; Bot1.Battlefield.Island#2)
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island#2.Activate
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Island#1.Tapped = False
! Bot1.Battlefield.Candelabra of Tawnos.Activate(X: 1)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Candelabra of Tawnos.Tapped = True
