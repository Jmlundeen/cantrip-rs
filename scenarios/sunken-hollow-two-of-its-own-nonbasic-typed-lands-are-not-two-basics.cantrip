# Sunken Hollow: "This land enters tapped unless you control two or more basic lands." Bot1 controls two Underground Seas
# - two lands with the Island and Swamp types, but neither basic (CR 205.4c; two or more of these lands do not count) -
# and no basic land at all, so its Sunken Hollow enters tapped. Bot2 with an Island and a Swamp plays the same land
# untapped (positive control).

[Bot1 Deck]
Underground Sea
Underground Sea
Sunken Hollow
Swamp x20

[Bot2 Deck]
Island
Swamp
Sunken Hollow
Swamp x20

[Actions]
Bot1.Hand.Underground Sea.Play
Bot2.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Underground Sea.Play
[T4 Bot2.Main1]
Bot2.Hand.Swamp.Play
[T5 Bot1.Main1]
Bot1.Hand.Sunken Hollow.Play
[T6 Bot2.Main1]
Bot2.Hand.Sunken Hollow.Play

[Expect]
Bot1.Battlefield.Sunken Hollow.Tapped = true
Bot2.Battlefield.Sunken Hollow.Tapped = false
