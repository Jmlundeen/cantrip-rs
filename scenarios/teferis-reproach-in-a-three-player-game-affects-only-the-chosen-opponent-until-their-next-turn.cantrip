? Bot2.PhasedOut.Count = 0
? Bot1.PhasedOut.Count = 0
Bot1.Battlefield.Mountain.Activate
! Bot1.Hand.Lightning Bolt.Cast(Bot3)
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Pass
Bot3.Pass
? Bot2.Life = 17
? Bot3.Life = 20
[T5 Bot2.Main1]
Bot2.Hand.Island.Play
[T6 Bot3.Main1]
Bot3.Hand.Island.Play
? Bot3.PhasedOut.Count = 0
[T7 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot3)
Bot1.Pass
Bot2.Pass
Bot3.Pass

