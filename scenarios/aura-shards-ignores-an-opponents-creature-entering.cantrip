# "Whenever a creature you control enters": Bot2's Ornithopter entering asks Bot1 for no target (the bare refusal
# comes after the Pass that lets it resolve), but Bot1's own Ornithopter does, and destroys Bot2's.

[Bot1 Deck]
Forest
Mox Pearl
Mox Jet
Aura Shards
Ornithopter
Forest
Forest x8

[Bot2 Deck]
Ornithopter
Island x12

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Aura Shards.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot1.Pass
! Bot1.Target
[T3 Bot1.Main1]
Bot1.Hand.Ornithopter.Cast
Bot1.Target(Bot2.Battlefield.Ornithopter)
Bot1.Accept
[T3 Bot1.Main2]

[Expect]
Bot2.Graveyard = Ornithopter
Bot2.Battlefield.Count = 0
Bot1.Battlefield = Forest; Mox Pearl; Mox Jet; Aura Shards; Ornithopter
