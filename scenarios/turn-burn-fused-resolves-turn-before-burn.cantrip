# A fused split spell follows the left half's instructions and then the right half's (CR 702.102d). Bot1 casts Turn // Burn
# fused with Turn at its own Ancient Adamantoise ("Damage that would be dealt to you ... is dealt to Ancient Adamantoise
# instead") and Burn at itself: Turn takes the Adamantoise's abilities first, so Burn's 2 damage is dealt to Bot1, and the
# Adamantoise lives on as an undamaged 0/1. Burn first would have its damage redirected and kill the 0/1.

[Bot1 Deck]
Island
Mox Sapphire
Sol Ring
Black Lotus
Show and Tell
Turn // Burn
Ancient Adamantoise
Mox Ruby
Island x10

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Show and Tell.Cast
Bot1.Choose(Ancient Adamantoise)
Bot2.Choose()
[T3 Bot1.Main1]
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Turn // Burn.Cast(Ability: Fuse)
Bot1.Target(Bot1.Battlefield.Ancient Adamantoise)
Bot1.Target(Bot1)
Bot1.Pass
Bot2.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Life = 18
Bot1.Battlefield.Ancient Adamantoise.Toughness = 1
Bot1.Battlefield.Ancient Adamantoise.Damage = 0
