Bot2.Hand.Ornithopter.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Untimely Malfunction.Cast
Bot1.Modes(3)
Bot1.Target(Bot2.Battlefield.Ornithopter#1; Bot2.Battlefield.Ornithopter#2)
Bot1.Pass
! Bot2.Hand.Bolt Bend.Cast(Stack.Untimely Malfunction)
Bot2.Pass
Bot1.Battlefield.Mox Ruby#2.Activate
Bot1.Hand.Lightning Bolt.Cast(Bot2)
Bot1.Pass
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Battlefield.Mox Pearl.Activate
Bot2.Battlefield.Mox Emerald.Activate
Bot2.Hand.Bolt Bend.Cast(Stack.Lightning Bolt)
Bot2.Pass
Bot1.Pass
Bot2.Target(Bot1)
Bot2.Pass
Bot1.Pass
[Bot1.Main2]

