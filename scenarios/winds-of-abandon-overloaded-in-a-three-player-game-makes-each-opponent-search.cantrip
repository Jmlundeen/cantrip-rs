[Expect]
Exile.Count = 2
Bot2.Battlefield = Forest; Forest
Bot3.Battlefield = Forest; Forest
Bot2.Battlefield.Forest#2.Tapped = true
Bot3.Battlefield.Forest#2.Tapped = true
