# Isolated Chapel: "This land enters tapped unless you control a Plains or a Swamp." (CR 614.1c, 614.12a: read on the
# battlefield as it enters, the land itself never counted). Beside an Island only the first copy enters tapped (turn 3);
# once a Plains is out the second enters untapped (turn 7), the positive control for the first. It also taps for {W} or
# {B}: green is refused beside the white it does add, and the {W} activation is that positive control.

[Bot1 Deck]
Island
Isolated Chapel
Plains
Isolated Chapel
Plains x10

[Bot2 Deck]
Forest x16

[Actions]
Bot1.Hand.Island.Play
[T3 Bot1.Main1]
Bot1.Hand.Isolated Chapel.Play
? Bot1.Battlefield.Isolated Chapel.Tapped = true
[T5 Bot1.Main1]
! Bot1.Battlefield.Isolated Chapel.Activate(Ability: {W} or {B}; Color: Green)
Bot1.Battlefield.Isolated Chapel.Activate(Ability: {W} or {B}; Color: White)
? Bot1.Mana = {W}
Bot1.Hand.Plains.Play
[T7 Bot1.Main1]
Bot1.Hand.Isolated Chapel.Play
? Bot1.Battlefield.Isolated Chapel#2.Tapped = false

[Expect]
Turn = 7
Bot1.Battlefield.Isolated Chapel#2.Tapped = false
