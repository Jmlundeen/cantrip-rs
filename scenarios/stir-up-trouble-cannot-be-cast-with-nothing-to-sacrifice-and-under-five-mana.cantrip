# Neither additional cost of Stir Up Trouble can be paid (CR 601.2b, 118.3): on turn 3 Bot1 has two Swamps - {B} plus {4} is
# five mana - and no artifact or creature to sacrifice (lands are neither), so the spell is not offered though Bot2 has a
# creature to destroy. The positive control is stir-up-trouble-paying-four-keeps-your-creature: the same spell and
# target with five mana, and it is cast.

[Bot1 Deck]
Swamp
Swamp
Stir Up Trouble
Island x12

[Bot2 Deck]
Forest
Llanowar Elves
Forest x12

[Actions]
Bot1.Hand.Swamp.Play
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Swamp.Play
! Bot1.Hand.Stir Up Trouble.Cast
[T3 Bot1.Main2]

[Expect]
Bot1.Hand = Stir Up Trouble; Island; Island; Island; Island; Island
Bot1.Graveyard.Count = 0
Bot2.Battlefield = Forest; Llanowar Elves
