# A cast triggers Traxos even if Counterspell counters the artifact before the untap ability resolves (CR 601.2i,
# 113.7a). The trigger has no target, so it still resolves and untaps Traxos after the original spell is gone.

[Bot1 Deck]
Island
Sol Ring
Mox Sapphire
Springleaf Drum
Traxos, Scourge Eternal
Ornithopter
Island x20

[Bot2 Deck]
Island
Mox Sapphire
Counterspell
Island x23

[Actions]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Springleaf Drum.Cast
Bot1.Pass
Bot2.Hand.Island.Play
Bot2.Hand.Mox Sapphire.Cast
Bot2.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Hand.Traxos, Scourge Eternal.Cast
Bot1.Pass
Bot1.Battlefield.Springleaf Drum.Activate(Tap: Traxos, Scourge Eternal; Color: Blue)
Bot1.Hand.Ornithopter.Cast
Bot2.Battlefield.Island.Activate
Bot2.Battlefield.Mox Sapphire.Activate
Bot2.Hand.Counterspell.Cast(Stack.Ornithopter)
Bot2.Pass
Bot1.Pass
? Stack = Traxos, Scourge Eternal
? Bot1.Battlefield.Traxos, Scourge Eternal.Tapped = true

[Expect]
Bot1.Battlefield.Traxos, Scourge Eternal.Tapped = false
Bot1.Graveyard = Ornithopter
Bot2.Graveyard = Counterspell
