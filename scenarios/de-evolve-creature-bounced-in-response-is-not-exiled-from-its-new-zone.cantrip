Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
Bot1.Hand.Memnite.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Thought Scour.Cast(Bot1)
Bot1.Pass
Bot1.Hand.Thought Scour.Cast(Bot1)
Bot1.Pass
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.De-evolve.Cast(Bot1.Battlefield.Memnite)
Bot1.Pass
Bot2.Pass
? Bot1.Battlefield.Memnite.Power = -3
Bot1.Pass
[T3 Bot2.Upkeep]
Bot2.Hand.Unsummon.Cast(Bot1.Battlefield.Memnite)
Bot2.Battlefield.Island.Activate
Bot2.Pass
Bot1.Pass
? Bot1.Hand = Memnite; Swamp; Swamp; Swamp
Bot2.Pass
Bot1.Pass

[Expect]
Bot1.Hand = Memnite; Swamp; Swamp; Swamp
Exile.Count = 0
Bot1.Graveyard = De-evolve; Thought Scour; Swamp; Swamp; Thought Scour; Swamp; Swamp; Black Lotus
Bot1.Battlefield = Mox Jet; Mox Sapphire
