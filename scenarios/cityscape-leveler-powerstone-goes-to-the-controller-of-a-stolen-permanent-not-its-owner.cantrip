# "Its controller creates a tapped Powerstone token": the controller, not the owner (CR 110.2, 111.10h). Bot1 steals
# Bot2's Ornithopter with Act of Treason on turn 3, then attacks with the Leveler (cast with no target on turn 1) and
# targets the stolen Ornithopter. It is destroyed and goes to its owner Bot2's graveyard (CR 400.3), but the Powerstone
# is created under Bot1, who controlled it, and Bot2 gets none.

[Bot1 Deck]
Black Lotus
Mox Pearl
Mox Ruby
Mox Jet
Mox Sapphire
Mox Emerald
Cityscape Leveler
Act of Treason
Island x12

[Bot2 Deck]
Ornithopter
Island x15

[Actions]
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Cityscape Leveler.Cast
Bot1.Target()
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Hand.Act of Treason.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
Bot1.Attack(Cityscape Leveler > Bot2)
Bot1.Target(Ornithopter)
Bot1.Pass
Bot2.Pass

[Expect]
Turn = 3
Bot2.Graveyard = Ornithopter
Bot1.Battlefield.Powerstone Token.Tapped = True
Bot2.Battlefield.Powerstone Token = (absent)
