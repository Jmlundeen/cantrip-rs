# Printed token words follow MACO's text: Officer becomes Elf, red becomes blue for turn 3 (CR 612.2a, 612.4).
# MACO stays green; its first token keeps blue after the text change ends and the next is red (CR 202.2).

[Bot1 Deck]
Mox Emerald
Mox Sapphire
Island
MACO Strike Team
Artificial Evolution
Trait Doctoring
Ornithopter
Island x12

[Bot2 Deck]
Mountain
Lightning Bolt
Lightning Bolt
Mountain x14

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.MACO Strike Team.Cast
? Bot1.Mana =
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Artificial Evolution.Cast(MACO Strike Team)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Officer)
Bot1.Modes(Elf)
? Bot1.Battlefield.Officer Token = (absent)
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Trait Doctoring.Cast(MACO Strike Team)
Bot1.Pass
Bot2.Pass
Bot1.Modes(Replace a color word)
Bot1.Colors(Red)
Bot1.Colors(Blue)
Bot1.Choose()
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot2.Battlefield.Mountain.Activate
[T3 Bot1.Main2]
? Bot1.Battlefield.Elf Token.Colors = Blue
? Bot1.Battlefield.Elf Token.Subtypes = Elf
? Bot1.Battlefield.Elf Token.Tapped = true
? Bot1.Battlefield.MACO Strike Team.Colors = Green
[T4 Bot2.Main1]
Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.MACO Strike Team)
Bot2.Battlefield.Mountain.Activate
[T4 Bot2.Main2]

[Expect]
Bot1.Battlefield.Count = 5
Bot1.Battlefield.Elf Token#1.Token = true
Bot1.Battlefield.Elf Token#1.Types = Creature
Bot1.Battlefield.Elf Token#1.Colors = Blue
Bot1.Battlefield.Elf Token#1.Subtypes = Elf
Bot1.Battlefield.Elf Token#1.Power = 1
Bot1.Battlefield.Elf Token#1.Toughness = 1
Bot1.Battlefield.Elf Token#1.Tapped = true
Bot1.Battlefield.Elf Token#2.Colors = Red
Bot1.Battlefield.Elf Token#2.Subtypes = Elf
Bot1.Battlefield.Elf Token#2.Tapped = true
Bot1.Battlefield.Officer Token = (absent)
Bot2.Battlefield.Elf Token = (absent)
