Bot1.Battlefield.Swamp.Activate
Bot1.Hand.Bringer of the Last Gift.Cast
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Jet.Activate
Bot2.Hand.Infernal Grasp.Cast(Bot1.Battlefield.Bringer of the Last Gift)
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield = Mox Jet; Mox Ruby; Mox Pearl; Mox Emerald; Swamp; Bringer of the Last Gift
Bot1.Graveyard = Ornithopter; Black Lotus
Bot1.Life = 20
