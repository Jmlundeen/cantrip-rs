Bot1.Accept
Bot1.Target(Bot1)
Bot1.Accept
Bot1.Target(Bot1)
Bot1.Accept
Bot1.Target(Bot1)
Bot1.Accept
Bot1.Target(Bot1)
Bot1.Decline
[T3 Bot1.Main2]

