# Browser
# Taking back mana abilities latest first (cantrip_engine::undo): with priority, Bot1 taps the Forest, then sacrifices
# the Lotus Petal, for green. The first Undo brings the Petal back and leaves the Forest's {G}; the second untaps the
# Forest and empties the pool, and nothing more is offered to take back.

[Bot1 Deck]
Forest
Lotus Petal
Island x13

[Bot2 Deck]
Island x15

[Actions]
Bot1.Hand.Forest.Play
Bot1.Hand.Lotus Petal.Cast
Bot1.Pass
Bot1.Battlefield.Forest.Activate
? Bot1.Mana = {G}
Bot1.Battlefield.Lotus Petal.Activate(Color: Green)
? Bot1.Mana = {G}{G}
? Bot1.Graveyard = Lotus Petal
Bot1.Undo
? Bot1.Mana = {G}
? Bot1.Battlefield = Forest; Lotus Petal
? Bot1.Battlefield.Forest.Tapped = true
Bot1.Undo
? Bot1.Mana =
? Bot1.Battlefield.Forest.Tapped = false
! Bot1.Undo

[Expect]
Bot1.Battlefield = Forest; Lotus Petal
Bot1.Graveyard.Count = 0
