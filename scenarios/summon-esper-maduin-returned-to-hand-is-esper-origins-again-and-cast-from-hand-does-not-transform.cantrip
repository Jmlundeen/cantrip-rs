Bot1.Hand.Forest.Play
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Forest#2.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Graveyard.Esper Origins.Cast(Ability: Flashback)
Bot1.Pass
Bot1.Arrange(Forest | Island)
Bot1.Pass
Bot2.Pass
? Bot1.Hand = Forest; Forest; Forest; Forest
[T4 Bot2.Main1]
Bot2.Battlefield.Island.Activate
Bot2.Hand.Boomerang Basics.Cast(Bot1.Battlefield.Summon: Esper Maduin)
Bot2.Pass
Bot1.Pass
? Bot1.Hand = Forest; Forest; Forest; Forest; Esper Origins
? Bot2.Hand.Count = 7
[T5 Bot1.Main1]
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Esper Origins.Cast
Bot1.Pass
Bot1.Arrange(| Swamp; Forest)

