# CR 608.2b: Bot2 Bolts its own Ornithopter in response to High Noon's ability. The target is gone when the ability
# resolves, so Bot2's life is unaffected (no redirection) and High Noon, sacrificed as a cost, is in the graveyard.
# This does not test the limit (High Noon is already gone when Bot2 casts the Bolt); the limit's scenarios are the
# others named high-noon-.

[Bot1 Deck]
Plains
Mox Ruby
Mox Pearl
Mox Jet
Mox Emerald
Sol Ring
High Noon
Plains x13

[Bot2 Deck]
Plains
Mox Ruby
Ornithopter
Lightning Bolt
Plains x16

[Actions]
[T1 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Mox Jet.Cast
Bot1.Hand.Mox Emerald.Cast
Bot1.Battlefield.Mox Emerald.Activate
Bot1.Hand.Sol Ring.Cast
Bot1.Pass
Bot2.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mox Ruby.Cast
Bot2.Hand.Ornithopter.Cast
Bot2.Pass
Bot1.Pass
[T3 Bot1.Main1]
Bot1.Hand.Plains.Play
Bot1.Battlefield.Plains.Activate
Bot1.Battlefield.Plains.Activate
Bot1.Hand.High Noon.Cast
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Battlefield.Sol Ring.Activate
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Battlefield.Mox Jet.Activate
Bot1.Battlefield.High Noon.Activate(Bot2.Battlefield.Ornithopter)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot2.Battlefield.Ornithopter)
[Bot1.Main2]

[Expect]
Turn = 3
Bot2.Life = 20
Bot2.Graveyard = Ornithopter; Lightning Bolt
Bot1.Graveyard = High Noon
