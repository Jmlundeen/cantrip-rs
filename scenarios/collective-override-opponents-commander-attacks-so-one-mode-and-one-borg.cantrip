# "For each attacking creature" counts every creature attacking, not only the caster's; "if you control a commander"
# looks only at the caster's battlefield, so Bot2's commander does not let Bot1 choose both. Bot2's Raging Goblin
# commander attacks Bot1 on turn 2; Bot1, with its own commander still in the command zone, is offered one mode and
# makes one Borg token for the attacking Goblin.

[Format]
Commander
[Bot1 Commander]
Kytheon, Hero of Akros
[Bot1 Deck]
Black Lotus
Mox Sapphire
Collective Override
Island x37
[Bot2 Commander]
Raging Goblin
[Bot2 Deck]
Mountain
Island x39
[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Pass
Bot1.Hand.Mox Sapphire.Cast
Bot1.Pass
[T2 Bot2.Main1]
Bot2.Hand.Mountain.Play
Bot2.Battlefield.Mountain.Activate
Bot2.Command.Raging Goblin.Cast
Bot2.Pass
Bot2.Attack(Raging Goblin > Bot1)
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Hand.Collective Override.Cast
! Bot1.Modes(1; 2)
Bot1.Modes(1)
Bot1.Pass

[Expect]
Turn = 2
Stack.Count = 0
Bot1.Command = Kytheon, Hero of Akros
Bot1.Battlefield.Kytheon, Hero of Akros = (absent)
Bot1.Battlefield.Borg Token.Power = 1
Bot1.Battlefield.Borg Token#1 = (absent)
Bot1.Hand.Count = 4
Bot2.Battlefield.Raging Goblin.Tapped = true
Combat.Attackers = Raging Goblin > Bot1
