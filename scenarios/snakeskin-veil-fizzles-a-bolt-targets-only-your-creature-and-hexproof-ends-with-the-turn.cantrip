Bot2.Hand.Lightning Bolt.Cast(Bot1.Battlefield.Ornithopter)
Bot1.Battlefield.Mox Emerald.Activate
! Bot1.Hand.Snakeskin Veil.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Hand.Snakeskin Veil.Cast(Bot1.Battlefield.Ornithopter)
[T2 Bot2.Main2]
? Bot1.Battlefield.Ornithopter.Keywords = Flying; Hexproof
[T3 Bot1.Main1]

