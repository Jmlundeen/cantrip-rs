# Ghost of Illyria exiles another nonland permanent you control and returns it at the beginning of the next end step
# (CR 603.7c): the Ornithopter is back on the battlefield, under its owner's control, by the end of the turn.

[Bot1 Deck]
Black Lotus
Mox Pearl
Ornithopter
Ghost of Illyria
Island x15

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Mox Pearl.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: White)
Bot1.Battlefield.Mox Pearl.Activate
Bot1.Hand.Ghost of Illyria.Cast
Bot1.Target(Bot1.Battlefield.Ornithopter)
Bot1.Pass
Bot2.Pass
? Exile = Ornithopter
[T1 Bot1.End]
Bot1.Pass
Bot2.Pass

[Expect]
Bot1.Battlefield.Ornithopter.Toughness = 2
Exile.Count = 0
Bot1.Graveyard = Black Lotus
