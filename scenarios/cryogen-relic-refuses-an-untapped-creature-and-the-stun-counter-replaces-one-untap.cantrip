# Cryogen Relic: "Put a stun counter on up to one target tapped creature." The target must be tapped (CR 115.1): on turn 3
# Bot2's untapped Llanowar Elves are refused, beside the tapped ones the activation takes on turn 5 (the positive control).
# A stun counter (CR 122.1d): when the stunned permanent would untap, the counter is removed instead - so on turn 6 the
# Elves stay tapped and lose the counter, and on turn 8 they untap.

[Bot1 Deck]
Island
Mox Sapphire
Cryogen Relic
Island x20

[Bot2 Deck]
Forest
Llanowar Elves
Forest
Forest x17

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Hand.Cryogen Relic.Cast
[T2 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Llanowar Elves.Cast
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
! Bot1.Battlefield.Cryogen Relic.Activate(Bot2.Battlefield.Llanowar Elves)
[T4 Bot2.Main1]
Bot2.Hand.Forest.Play
Bot2.Battlefield.Llanowar Elves.Activate
? Bot2.Battlefield.Llanowar Elves.Tapped = True
[T5 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Cryogen Relic.Activate(Bot2.Battlefield.Llanowar Elves)
[T5 Bot1.Main2]
? Bot2.Battlefield.Llanowar Elves.Counters.Stun = 1

[T6 Bot2.Main1]
? Bot2.Battlefield.Llanowar Elves.Tapped = true
? Bot2.Battlefield.Llanowar Elves.Counters.Stun = (absent)
[T8 Bot2.Main1]

[Expect]
Bot2.Battlefield.Llanowar Elves.Tapped = false
