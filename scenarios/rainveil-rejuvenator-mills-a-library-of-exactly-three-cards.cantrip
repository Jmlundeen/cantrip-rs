# Rainveil Rejuvenator: "you may mill three cards" with exactly three cards in the library can be chosen (CR 701.17b only
# stops more than the library holds): all three go to the graveyard.

[Bot1 Deck]
Black Lotus
Mox Ruby
Rainveil Rejuvenator
Ornithopter x4
Memnite x3

[Bot2 Deck]
Island x20

[Actions]
Bot1.Hand.Mox Ruby.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Battlefield.Black Lotus.Activate(Color: Green)
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Rainveil Rejuvenator.Cast
Bot1.Pass
Bot2.Pass
Bot1.Accept

[Expect]
Bot1.Library.Count = 0
Bot1.Graveyard = Memnite; Memnite; Memnite; Black Lotus
