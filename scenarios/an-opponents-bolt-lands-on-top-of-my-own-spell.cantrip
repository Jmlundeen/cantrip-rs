# Bot1 casts a Goblin and Bot2 answers it with a Lightning Bolt at Bot1's head, so two spells wait on the stack and
# the one on top is Bot2's. Handed over there because that is the position the client's auto-pass turns on: with
# nothing but their own spell on the stack the player is passed for, and the moment an opponent puts something on top
# of it they are asked again. See AutoPass and AutoPassTests in the client.

[Bot1 Deck]
Mountain
Goblin Welder
Mountain x16

[Bot2 Deck]
Mountain
Lightning Bolt
Mountain x16

[Actions]
Bot1.Hand.Mountain.Play
Bot2.Hand.Mountain.Play
[T3 Bot1.Main1]
Bot1.Battlefield.Mountain.Activate
Bot1.Hand.Goblin Welder.Cast
Bot2.Battlefield.Mountain.Activate
Bot2.Hand.Lightning Bolt.Cast(Bot1)
[Handover Bot1.Pass]

[Expect]
Turn = 3
ActivePlayer = Bot1
PriorityPlayer = Bot1
# Top first: the Bolt is what resolves next, and Bot1's own Goblin is still underneath it.
Stack = Lightning Bolt; Goblin Welder
Bot1.Life = 20
Bot1.Battlefield = Mountain
Bot2.Battlefield = Mountain
