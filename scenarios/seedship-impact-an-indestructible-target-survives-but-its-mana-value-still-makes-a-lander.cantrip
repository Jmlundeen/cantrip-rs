Bot1.Hand.Mox Emerald.Cast
Bot1.Hand.Seedship Impact.Cast(Bot2.Battlefield.Ornithopter)
Bot1.Battlefield.Forest.Activate
Bot1.Battlefield.Mox Emerald.Activate
Bot2.Hand.Boros Charm.Cast
Bot2.Modes(2)
Bot2.Battlefield.Mox Ruby.Activate
Bot2.Battlefield.Mox Pearl.Activate
[T3 Bot1.Main2]

[Expect]
Bot2.Battlefield = Mox Pearl; Mox Ruby; Ornithopter
