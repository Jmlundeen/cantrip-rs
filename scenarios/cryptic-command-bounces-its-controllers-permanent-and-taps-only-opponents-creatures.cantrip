# Cryptic Command's return mode takes a permanent its controller controls and its tap mode taps every creature each
# opponent controls, not its controller's own (CR 700.2, 400.3, 701.26a, 101.4): Bot1 returns its own Ornithopter and
# taps both of Bot2's creatures, while Bot1's other Ornithopter and Bot2's noncreature Mox Sapphire stay untapped.

[Bot1 Deck]
Mox Sapphire
Mox Sapphire
Black Lotus
Ornithopter
Ornithopter
Cryptic Command
Island x3
Island x10

[Bot2 Deck]
Ornithopter
Llanowar Elves
Forest
Mox Sapphire
Island x16

[Actions]
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Black Lotus.Cast
Bot1.Hand.Ornithopter.Cast
Bot1.Hand.Ornithopter.Cast
[T2 Bot2.Main1]
Bot2.Hand.Ornithopter.Cast
Bot2.Hand.Forest.Play
Bot2.Hand.Llanowar Elves.Cast
Bot2.Battlefield.Forest.Activate
Bot2.Hand.Mox Sapphire.Cast
[T3 Bot1.Main1]
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Sapphire#2.Activate
Bot1.Battlefield.Black Lotus.Activate(Color: Blue)
Bot1.Hand.Cryptic Command.Cast
Bot1.Modes(2; 3)
Bot1.Target(Bot1.Battlefield.Ornithopter#1)
Bot1.Pass
[T3 Bot1.Main2]

[Expect]
Bot1.Battlefield.Count = 3
Bot1.Battlefield.Ornithopter.Tapped = false
Bot1.Hand.Count = 3
Bot2.Battlefield.Count = 4
Bot2.Battlefield.Mox Sapphire.Tapped = false
Bot2.Battlefield.Llanowar Elves.Tapped = true
Bot2.Battlefield.Ornithopter.Tapped = true
Stack.Count = 0
