Bot2.Pass

[Expect]
Bot1.Battlefield = Mox Sapphire; Mox Jet; Mox Pearl; Island; Island; Old Man of the Sea; Pestermite
Bot1.Battlefield.Old Man of the Sea.Tapped = false
Bot2.Battlefield = Forest; Llanowar Elves
Stack.Count = 0
