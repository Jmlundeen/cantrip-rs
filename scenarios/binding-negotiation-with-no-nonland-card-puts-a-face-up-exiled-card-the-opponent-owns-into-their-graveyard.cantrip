[T2 Bot2.Main1]
Bot2.Hand.Swamp.Play
Bot2.Battlefield.Swamp.Activate
Bot2.Hand.Elvish Spirit Guide.Activate
Bot2.Hand.Binding Negotiation.Cast(Bot1)
! Bot2.Choose(Black Lotus)
! Bot2.Choose(Elvish Spirit Guide)
Bot2.Choose(Simian Spirit Guide)

