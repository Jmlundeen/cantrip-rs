# A permanent that enters as a copy of a kicked Everflowing Chalice was never kicked itself (CR 702.33, 707.2): Bot1's
# Phyrexian Metamorph copies a Chalice kicked once and enters with no charge counter, so it taps for no mana, while
# the original keeps its one counter and its {C}.

[Bot1 Deck]
Island
Mox Sapphire
Mox Ruby
Everflowing Chalice
Island
Phyrexian Metamorph
Island x10

[Bot2 Deck]
Swamp x20

[Actions]
Bot1.Hand.Island.Play
Bot1.Hand.Mox Sapphire.Cast
Bot1.Hand.Mox Ruby.Cast
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Everflowing Chalice.Cast(Kicked: 1)
[T3 Bot1.Main1]
Bot1.Hand.Island.Play
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Island.Activate
Bot1.Battlefield.Mox Sapphire.Activate
Bot1.Battlefield.Mox Ruby.Activate
Bot1.Hand.Phyrexian Metamorph.Cast
Bot1.Accept
Bot1.Target(Everflowing Chalice)
? Bot1.Battlefield.Everflowing Chalice#1.Counters.Charge = 1
Bot1.Battlefield.Everflowing Chalice#2.Activate(Ability: charge counter)
? Bot1.Mana = 
Bot1.Battlefield.Everflowing Chalice#1.Activate
? Bot1.Mana = {C}

[Expect]
Bot1.Battlefield.Everflowing Chalice#1.Counters.Charge = 1
Bot1.Battlefield.Everflowing Chalice#2.Types = Artifact
Stack.Count = 0
